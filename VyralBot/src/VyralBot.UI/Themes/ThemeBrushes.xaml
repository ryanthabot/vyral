<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================= -->
    <!-- VyralBot shared theme brushes.
         Colors live in Themes/Colors/{Theme}Colors.xaml and are swapped at runtime by
         ThemeManager. Every brush below wraps its color via DynamicResource, so all
         brushes re-resolve automatically when the colors dictionary is swapped. -->
    <!-- ========================================= -->

    <!-- ===== Primary Brushes ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{DynamicResource PrimaryPressed}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLight}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDark}"/>

    <!-- Legacy aliases for backward compatibility -->
    <SolidColorBrush x:Key="VyralRedBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="VyralRedHoverBrush" Color="{DynamicResource PrimaryHover}"/>
    <SolidColorBrush x:Key="VyralRedPressedBrush" Color="{DynamicResource PrimaryPressed}"/>
    <SolidColorBrush x:Key="PrimaryRedBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryRedHoverBrush" Color="{DynamicResource PrimaryHover}"/>
    <SolidColorBrush x:Key="PrimaryRedPressedBrush" Color="{DynamicResource PrimaryPressed}"/>

    <!-- ===== Background Brushes ===== -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{DynamicResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{DynamicResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{DynamicResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{DynamicResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHover}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{DynamicResource SurfacePressed}"/>

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{DynamicResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource BackgroundTertiary}"/>

    <!-- ===== Overlay Brushes ===== -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{DynamicResource OverlayBackground}"/>
    <SolidColorBrush x:Key="ModalBackgroundBrush" Color="{DynamicResource ModalBackground}"/>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{DynamicResource GlassBackground}" Opacity="0.8"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{DynamicResource GlassBorder}"/>

    <!-- ===== Text Brushes ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMuted}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabled}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{DynamicResource TextOnPrimary}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{DynamicResource TextOnDark}"/>
    <SolidColorBrush x:Key="TextOnLightBrush" Color="{DynamicResource TextOnLight}"/>

    <!-- ===== Border Brushes ===== -->
    <SolidColorBrush x:Key="BorderPrimaryBrush" Color="{DynamicResource BorderPrimary}"/>
    <SolidColorBrush x:Key="BorderSecondaryBrush" Color="{DynamicResource BorderSecondary}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLight}"/>
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{DynamicResource BorderAccent}"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="{DynamicResource BorderPrimary}"/>

    <!-- ===== Semantic Brushes ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{DynamicResource SuccessHover}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{DynamicResource SuccessLight}"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{DynamicResource SuccessColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="{DynamicResource WarningHover}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{DynamicResource WarningLight}"/>
    <SolidColorBrush x:Key="WarningYellowBrush" Color="{DynamicResource WarningColor}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{DynamicResource ErrorHover}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{DynamicResource ErrorLight}"/>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{DynamicResource ErrorColor}"/>

    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoHoverBrush" Color="{DynamicResource InfoHover}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{DynamicResource InfoLight}"/>

    <!-- ===== Platform Brushes ===== -->
    <SolidColorBrush x:Key="TwitchBrush" Color="{DynamicResource TwitchPrimary}"/>
    <SolidColorBrush x:Key="TwitchHoverBrush" Color="{DynamicResource TwitchHover}"/>
    <SolidColorBrush x:Key="TwitchPressedBrush" Color="{DynamicResource TwitchPressed}"/>
    <SolidColorBrush x:Key="TwitchBackgroundBrush" Color="{DynamicResource TwitchBackground}"/>
    <SolidColorBrush x:Key="TwitchSurfaceBrush" Color="{DynamicResource TwitchSurface}"/>
    <SolidColorBrush x:Key="TwitchDarkBrush" Color="{DynamicResource TwitchDark}"/>

    <SolidColorBrush x:Key="KickBrush" Color="{DynamicResource KickPrimary}"/>
    <SolidColorBrush x:Key="KickHoverBrush" Color="{DynamicResource KickHover}"/>
    <SolidColorBrush x:Key="KickPressedBrush" Color="{DynamicResource KickPressed}"/>
    <SolidColorBrush x:Key="KickBackgroundBrush" Color="{DynamicResource KickBackground}"/>
    <SolidColorBrush x:Key="KickOnPrimaryBrush" Color="{DynamicResource KickOnPrimary}"/>

    <SolidColorBrush x:Key="YouTubeBrush" Color="{DynamicResource YouTubePrimary}"/>
    <SolidColorBrush x:Key="YouTubeHoverBrush" Color="{DynamicResource YouTubeHover}"/>

    <SolidColorBrush x:Key="TikTokBrush" Color="{DynamicResource TikTokPrimary}"/>
    <SolidColorBrush x:Key="TikTokAccentBrush" Color="{DynamicResource TikTokAccent}"/>

    <!-- ===== Input Brushes ===== -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackground}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource InputBorder}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{DynamicResource InputFocusBorder}"/>
    <SolidColorBrush x:Key="InputDisabledBrush" Color="{DynamicResource InputDisabled}"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="{DynamicResource InputPlaceholder}"/>

    <!-- ===== Chat Badge Brushes ===== -->
    <SolidColorBrush x:Key="ModeratorBadgeBrush" Color="{DynamicResource ModeratorBadge}"/>
    <SolidColorBrush x:Key="SubscriberBadgeBrush" Color="{DynamicResource SubscriberBadge}"/>
    <SolidColorBrush x:Key="VipBadgeBrush" Color="{DynamicResource VipBadge}"/>
    <SolidColorBrush x:Key="DiscordBrush" Color="{DynamicResource DiscordColor}"/>
    <SolidColorBrush x:Key="OrangeBadgeBrush" Color="{DynamicResource OrangeBadge}"/>

    <!-- ===== Flow Canvas Brushes ===== -->
    <SolidColorBrush x:Key="FlowCanvasBackgroundBrush" Color="{DynamicResource FlowCanvasBackground}"/>
    <SolidColorBrush x:Key="FlowCanvasGridDotBrush" Color="{DynamicResource FlowCanvasGridDot}"/>
    <SolidColorBrush x:Key="FlowCanvasNodeBackgroundBrush" Color="{DynamicResource FlowCanvasNodeBackground}"/>
    <SolidColorBrush x:Key="FlowCanvasNodeBorderBrush" Color="{DynamicResource FlowCanvasNodeBorder}"/>
    <SolidColorBrush x:Key="FlowCanvasNodeHoverBrush" Color="{DynamicResource FlowCanvasNodeHover}"/>
    <SolidColorBrush x:Key="FlowCanvasSelectionBrush" Color="{DynamicResource FlowCanvasSelection}"/>
    <SolidColorBrush x:Key="FlowCanvasTextPrimaryBrush" Color="{DynamicResource FlowCanvasTextPrimary}"/>
    <SolidColorBrush x:Key="FlowCanvasTextSecondaryBrush" Color="{DynamicResource FlowCanvasTextSecondary}"/>
    <SolidColorBrush x:Key="FlowCanvasDescriptionTextBrush" Color="{DynamicResource FlowCanvasDescriptionText}"/>
    <SolidColorBrush x:Key="FlowCanvasPortNeutralBrush" Color="{DynamicResource FlowCanvasPortNeutral}"/>
    <SolidColorBrush x:Key="FlowCanvasMainWireBrush" Color="{DynamicResource FlowCanvasMainWire}"/>
    <SolidColorBrush x:Key="FlowCanvasCasePortBrush" Color="{DynamicResource FlowCanvasCasePort}"/>
    <SolidColorBrush x:Key="FlowCanvasTriggerAccentBrush" Color="{DynamicResource FlowCanvasTriggerAccent}"/>
    <SolidColorBrush x:Key="FlowCanvasRejectedBrush" Color="{DynamicResource FlowCanvasRejected}"/>
    <SolidColorBrush x:Key="FlowCanvasButtonBackgroundBrush" Color="{DynamicResource FlowCanvasButtonBackground}"/>
    <SolidColorBrush x:Key="FlowCanvasButtonHoverBrush" Color="{DynamicResource FlowCanvasButtonHover}"/>
    <SolidColorBrush x:Key="FlowCanvasButtonForegroundBrush" Color="{DynamicResource FlowCanvasButtonForeground}"/>
    <SolidColorBrush x:Key="FlowCanvasChipBackgroundBrush" Color="{DynamicResource FlowCanvasChipBackground}"/>
    <SolidColorBrush x:Key="FlowCanvasChipBorderBrush" Color="{DynamicResource FlowCanvasChipBorder}"/>
    <SolidColorBrush x:Key="FlowCanvasChipBorderHoverBrush" Color="{DynamicResource FlowCanvasChipBorderHover}"/>

    <!-- App logo, replaced at runtime by ThemeManager (pack URI of the active variant PNG) -->
    <ImageSource x:Key="AppLogoSource">/Resources/Images/vyral-logo.png</ImageSource>

    <!-- ========================================= -->
    <!-- Styles -->
    <!-- ========================================= -->

    <!-- Premium Scrollbar Style -->
    <Style x:Key="VyralScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="4"
                            Opacity="0.6"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource VyralScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Drop Shadows -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="20"
                      ShadowDepth="0"
                      Opacity="0.3"
                      Color="#000000"/>

    <DropShadowEffect x:Key="HoverShadow"
                      BlurRadius="30"
                      ShadowDepth="0"
                      Opacity="0.5"
                      Color="#000000"/>

</ResourceDictionary>
