<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================= -->
    <!-- Arctic Frost — cool light theme, sky-blue accent -->
    <!-- ========================================= -->

    <!-- ===== Primary Brand Colors ===== -->
    <Color x:Key="PrimaryColor">#0284C7</Color>
    <Color x:Key="PrimaryHover">#0EA5E9</Color>
    <Color x:Key="PrimaryPressed">#0369A1</Color>
    <Color x:Key="PrimaryLight">#7DD3FC</Color>
    <Color x:Key="PrimaryDark">#075985</Color>

    <!-- ===== Background Colors ===== -->
    <Color x:Key="BackgroundPrimary">#F8FAFC</Color>
    <Color x:Key="BackgroundSecondary">#FFFFFF</Color>
    <Color x:Key="BackgroundTertiary">#EEF2F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHover">#EEF2F7</Color>
    <Color x:Key="SurfacePressed">#E2E8F0</Color>

    <!-- ===== Overlay/Modal Colors ===== -->
    <Color x:Key="OverlayBackground">#33000000</Color>
    <Color x:Key="ModalBackground">#66000000</Color>
    <Color x:Key="GlassBackground">#B3FFFFFF</Color>
    <Color x:Key="GlassBorder">#330284C7</Color>

    <!-- ===== Text Colors ===== -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TextDisabled">#94A3B8</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextOnDark">#0F172A</Color>
    <Color x:Key="TextOnLight">#0F172A</Color>

    <!-- ===== Border Colors ===== -->
    <Color x:Key="BorderPrimary">#CBD5E1</Color>
    <Color x:Key="BorderSecondary">#E2E8F0</Color>
    <Color x:Key="BorderLight">#94A3B8</Color>
    <Color x:Key="BorderAccent">#0284C7</Color>

    <!-- ===== Semantic Colors ===== -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHover">#059669</Color>
    <Color x:Key="SuccessLight">#34D399</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningHover">#D97706</Color>
    <Color x:Key="WarningLight">#FBBF24</Color>

    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorHover">#DC2626</Color>
    <Color x:Key="ErrorLight">#F87171</Color>

    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoHover">#2563EB</Color>
    <Color x:Key="InfoLight">#60A5FA</Color>

    <!-- ===== Platform-Specific Colors (brand colors — identical in every theme) ===== -->
    <Color x:Key="TwitchPrimary">#9146FF</Color>
    <Color x:Key="TwitchHover">#772CE8</Color>
    <Color x:Key="TwitchPressed">#5C16C5</Color>
    <Color x:Key="TwitchBackground">#0E0E10</Color>
    <Color x:Key="TwitchSurface">#18181B</Color>
    <Color x:Key="TwitchDark">#1F1F23</Color>

    <Color x:Key="KickPrimary">#53FC18</Color>
    <Color x:Key="KickHover">#42D412</Color>
    <Color x:Key="KickPressed">#32A40E</Color>
    <Color x:Key="KickBackground">#0E0E10</Color>
    <Color x:Key="KickOnPrimary">#0E0E10</Color>

    <Color x:Key="YouTubePrimary">#FF0000</Color>
    <Color x:Key="YouTubeHover">#CC0000</Color>

    <Color x:Key="TikTokPrimary">#00F2EA</Color>
    <Color x:Key="TikTokAccent">#FF0050</Color>

    <!-- ===== Input/Control Colors ===== -->
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBorder">#CBD5E1</Color>
    <Color x:Key="InputFocusBorder">#0284C7</Color>
    <Color x:Key="InputDisabled">#EEF2F7</Color>
    <Color x:Key="InputPlaceholder">#94A3B8</Color>

    <!-- ===== Chat Badge Colors (constant across themes) ===== -->
    <Color x:Key="ModeratorBadge">#00AD03</Color>
    <Color x:Key="SubscriberBadge">#9146FF</Color>
    <Color x:Key="VipBadge">#E005B9</Color>
    <Color x:Key="DiscordColor">#5865F2</Color>
    <Color x:Key="OrangeBadge">#FFA500</Color>

    <!-- ===== Flow Canvas (frost light) ===== -->
    <Color x:Key="FlowCanvasBackground">#F1F5F9</Color>
    <Color x:Key="FlowCanvasGridDot">#D8DEE9</Color>
    <Color x:Key="FlowCanvasNodeBackground">#FFFFFF</Color>
    <Color x:Key="FlowCanvasNodeBorder">#CBD5E1</Color>
    <Color x:Key="FlowCanvasNodeHover">#EEF2F7</Color>
    <Color x:Key="FlowCanvasSelection">#6366F1</Color>
    <Color x:Key="FlowCanvasTextPrimary">#0F172A</Color>
    <Color x:Key="FlowCanvasTextSecondary">#475569</Color>
    <Color x:Key="FlowCanvasDescriptionText">#64748B</Color>
    <Color x:Key="FlowCanvasPortNeutral">#64748B</Color>
    <Color x:Key="FlowCanvasMainWire">#0284C7</Color>
    <Color x:Key="FlowCanvasCasePort">#D97706</Color>
    <Color x:Key="FlowCanvasTriggerAccent">#D97706</Color>
    <Color x:Key="FlowCanvasRejected">#DC2626</Color>
    <Color x:Key="FlowCanvasButtonBackground">#FFFFFF</Color>
    <Color x:Key="FlowCanvasButtonHover">#EEF2F7</Color>
    <Color x:Key="FlowCanvasButtonForeground">#0F172A</Color>
    <Color x:Key="FlowCanvasChipBackground">#FFFFFF</Color>
    <Color x:Key="FlowCanvasChipBorder">#CBD5E1</Color>
    <Color x:Key="FlowCanvasChipBorderHover">#94A3B8</Color>

</ResourceDictionary>
