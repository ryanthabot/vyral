                                            </StackPanel>

                                            <materialDesign:PackIcon Grid.Column="2"
                                                                     Kind="ChevronRight"
                                                                     Width="20"
                                                                     Height="20"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </materialDesign:Card>
                                </Grid>

                                <!-- Support Section -->
                                <StackPanel Margin="32,16,32,32">
                                    <TextBlock Text="Support"
