<Window x:Class="VyralBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:VyralBot.UI.Views"
        xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
        xmlns:converters="clr-namespace:VyralBot.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundDarkBrush}"
        Icon="{DynamicResource AppLogoSource}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToExpandIconConverter x:Key="BoolToExpandIconConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            BorderThickness="0"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Title Bar -->
                <RowDefinition Height="32"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Image Source="{DynamicResource AppLogoSource}"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Vyral"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="MinimizeButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46"
                                Height="32"
                                Padding="0"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                        </Button>
                        <Button Click="MaximizeButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46"
                                Height="32"
                                Padding="0"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                        </Button>
                        <Button Click="CloseButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46"
                                Height="32"
                                Padding="0"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar (wide enough for the longest nav label, "Currency & Rewards") -->
                <ColumnDefinition Width="220"/>
                <!-- Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,1,0"
                    CornerRadius="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Navigation with ScrollViewer -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,16,0,0">
                    <!-- Home -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Chat -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Command="{Binding NavigateToChatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chat" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Chat" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- OBS -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Command="{Binding NavigateToObsCommand}"
                            ToolTip="Embedded OBS studio and scene collections">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Video" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="OBS" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Restream group (Restream + StreamDeck) -->
                    <StackPanel>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding ToggleRestreamCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Cast" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restream" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1"
                                                        Kind="{Binding IsRestreamExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                        Width="16" Height="16"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            </Grid>
                        </Button>

                        <!-- Restream Items (Collapsible) -->
                        <StackPanel Visibility="{Binding IsRestreamExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToRestreamCommand}"
                                    ToolTip="FFmpeg restream: send one OBS output to multiple platforms">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cast" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restream" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToStreamDeckCommand}"
                                    ToolTip="StreamDeck: customizable action buttons + mobile companion app">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="StreamDeck" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Platforms Dropdown -->
                    <StackPanel>
                        <!-- Platforms Header Button -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding TogglePlatformsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Connection" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Platforms" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1"
                                                        Kind="{Binding IsPlatformsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                        Width="16" Height="16"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            </Grid>
                        </Button>

                        <!-- Platform Items (Collapsible) -->
                        <StackPanel Visibility="{Binding IsPlatformsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Twitch (only shown when connected) -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToTwitchSettingsCommand}"
                                    Visibility="{Binding IsTwitchConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/Images/twitch-logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Twitch" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Kick (only shown when connected) -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToKickSettingsCommand}"
                                    Visibility="{Binding IsKickConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/Images/kick-logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kick" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- YouTube (only shown when connected) -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToYouTubeSettingsCommand}"
                                    Visibility="{Binding IsYouTubeConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/Images/youtube-logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="YouTube" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Discord (multi-bot management home, always reachable) -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToDiscordBotsCommand}"
                                    ToolTip="Manage all of your Discord bots">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/Images/discord-logo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Discord" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Chat Features Dropdown -->
                    <StackPanel>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding ToggleChatFeaturesCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Star" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chat Features" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1"
                                                        Kind="{Binding IsChatFeaturesExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                        Width="16" Height="16"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsChatFeaturesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Events & Alerts -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToAlertSettingsCommand}"
                                    ToolTip="Configure on-screen alerts for stream events">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Bell" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Events &amp; Alerts" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Currency & Rewards -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToCurrencyCommand}"
                                    ToolTip="Currency &amp; Rewards">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CurrencyUsd" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Currency &amp; Rewards" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Commands -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToCommandsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Commands" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Automation (workflow builder) -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToAutomationCommand}"
                                    ToolTip="Build workflows: triggers, ordered steps and If branches">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SourceBranch" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Automation" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Event History -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToEventHistoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="History" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Event History" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Stream Tools Dropdown -->
                    <StackPanel>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding ToggleStreamToolsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Video" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stream Tools" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="1"
                                                        Kind="{Binding IsStreamToolsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                        Width="16" Height="16"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsStreamToolsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Browser Sources -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToAudioSettingsCommand}"
                                    ToolTip="Browser source setup lives in Audio Settings">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Web" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browser Sources" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Audio Settings -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToAudioSettingsCommand}"
                                    ToolTip="Configure sound playback and browser source audio">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="VolumeHigh" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Audio Settings" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Sounds Management -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToSoundsCommand}"
                                    ToolTip="Upload and assign sounds to chat events">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MusicNote" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sounds Management" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Statistics -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToStatisticsCommand}"
                                    ToolTip="View event statistics and leaderboards">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Statistics" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Visual Alerts -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToAlertSettingsCommand}"
                                    ToolTip="Configure on-screen alerts for stream events">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BellRing" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Visual Alerts" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Conditional Rules -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToConditionalRulesCommand}"
                                    ToolTip="Create conditional auto-reply rules for events">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Conditional Rules" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Giveaways -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToGiveawaysCommand}"
                                    ToolTip="Manage giveaways with weighted entry system">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Gift" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Giveaways" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Polls -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToPollsCommand}"
                                    ToolTip="Create and manage polls with multi-option voting">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Poll" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Polls" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Watchtime -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="48,0,16,0"
                                    Command="{Binding NavigateToWatchtimeCommand}"
                                    ToolTip="View watchtime statistics and leaderboards">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Watchtime" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <Separator Margin="0,0,0,8" Background="{DynamicResource BorderLightBrush}"/>

                        <!-- Settings -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding NavigateToSettingsCommand}"
                                ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Event Testing (Developer Tool) -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding NavigateToEventTestingCommand}"
                                ToolTip="Test chat events manually (Developer Tool)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TestTube" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Testing" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Demo Setup Wizard -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                Command="{Binding NavigateToDemoWizardCommand}"
                                ToolTip="Demo Setup Wizard (Reusable Component)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WizardHat" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Demo Wizard" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Help -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="48"
                                HorizontalContentAlignment="Left"
                                Padding="16,0"
                                ToolTip="Open the built-in documentation"
                                Command="{Binding NavigateToDocumentationCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircle" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Help" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" Padding="24">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <!-- Home View -->
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <DataTemplate.Resources>
                                <converters:AnyTrueToCollapsedConverter x:Key="AnyTrueToCollapsedConverter"/>
                                <!-- Quick-link keyboard access: focusable cards/borders with a visible focus ring -->
                                <Style x:Key="HomeQuickLinkCard"
                                       TargetType="materialDesign:Card"
                                       BasedOn="{StaticResource {x:Type materialDesign:Card}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="HomeQuickLinkBorder" TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Support-list variant: keeps the bottom separator when unfocused -->
                                <Style x:Key="HomeSupportLinkBorder"
                                       TargetType="Border"
                                       BasedOn="{StaticResource HomeQuickLinkBorder}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataTemplate.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Get started strip (first-run onboarding; hidden once dismissed or any platform connects) -->
