                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Moderator Card (second row, full width) -->
                                    <materialDesign:Card Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="7"
                                                        Style="{StaticResource HomeQuickLinkCard}"
                                                        Padding="20"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        Cursor="Hand"
                                                        Focusable="True"
                                                        TabIndex="5"
                                                        Margin="0,12,0,0"
                                                        ToolTip="Open Moderator">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToModeratorCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.NavigateToModeratorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.NavigateToModeratorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </materialDesign:Card.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0"
                                                                     Kind="ShieldAccount"
                                                                     Width="36"
                                                                     Height="36"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource PrimaryBrush}"/>

                                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Moderator"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Mod channel, mod roles, action log and the !mod command builder"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
