                                                     Padding="0"
                                                     Background="{DynamicResource CardBackgroundBrush}">
                                    <materialDesign:Card.Visibility>
                                        <MultiBinding Converter="{StaticResource AnyTrueToCollapsedConverter}">
                                            <Binding Path="IsGettingStartedDismissed"/>
                                            <Binding Path="DataContext.IsTwitchConnected" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding Path="DataContext.IsKickConnected" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding Path="DataContext.IsYouTubeConnected" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding Path="DataContext.IsDiscordConnected" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </materialDesign:Card.Visibility>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <Grid Grid.Row="0" Margin="20,14,8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="RocketLaunch"
                                                                         Width="18"
                                                                         Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource PrimaryBrush}"/>
                                                <TextBlock Text="Get started"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="New here? Three quick steps to your first stream"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DismissGettingStartedCommand}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Dismiss this guide — every page stays available in the sidebar">
                                                <materialDesign:PackIcon Kind="Close"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                        </Grid>

                                        <!-- Steps -->
                                        <UniformGrid Grid.Row="1" Columns="3" Margin="12,0,12,14">
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open the Platforms hub (the Connections card below)">
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="22"
                                                            Height="22"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="1"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BackgroundPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Connect a platform"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Link Twitch, Kick, YouTube or Discord"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.NavigateToAlertSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open Events &amp; Alerts (sidebar, under Chat features)">
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="22"
                                                            Height="22"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="2"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BackgroundPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Set up alerts"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="Events &amp; Alerts — on-screen overlays"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.NavigateToAutomationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open Automation and press TEMPLATES">
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Border Width="22"
                                                            Height="22"
                                                            CornerRadius="11"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="3"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BackgroundPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Import a workflow template"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="TEMPLATES button on the Automation page"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>
                                </materialDesign:Card>

                                <!-- Main Content Cards -->
                                <Grid Margin="32,24,32,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Connections Card -->
                                    <materialDesign:Card Grid.Column="0"
                                                        Style="{StaticResource HomeQuickLinkCard}"
                                                        Padding="24"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        Cursor="Hand"
                                                        Focusable="True"
                                                        TabIndex="1"
                                                        ToolTip="Open the Platforms hub (Connections)">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Connection"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,12"/>
                                            <TextBlock Text="Connections"
                                                     FontSize="16"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Text="Manage your platform connections"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Chat Card -->
                                    <materialDesign:Card Grid.Column="2"
                                                        Style="{StaticResource HomeQuickLinkCard}"
                                                        Padding="24"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        Cursor="Hand"
                                                        Focusable="True"
                                                        TabIndex="2"
                                                        ToolTip="Open Chat">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToChatHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.NavigateToChatHubCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.NavigateToChatHubCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Chat"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,12"/>
                                            <TextBlock Text="Chat"
                                                     FontSize="16"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Text="Complete chat management for all platforms"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Tools Card -->
                                    <materialDesign:Card Grid.Column="4"
                                                        Style="{StaticResource HomeQuickLinkCard}"
                                                        Padding="24"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        Cursor="Hand"
                                                        Focusable="True"
                                                        TabIndex="3"
                                                        ToolTip="Open Tools">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToToolsCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.NavigateToToolsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.NavigateToToolsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Toolbox"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,12"/>
                                            <TextBlock Text="Tools"
                                                     FontSize="16"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,6"/>
                                            <TextBlock Text="Stream tools, chat features, and more"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Integrations Card -->
                                    <materialDesign:Card Grid.Column="6"
                                                        Style="{StaticResource HomeQuickLinkCard}"
                                                        Padding="24"
                                                        Background="{DynamicResource CardBackgroundBrush}"
                                                        Cursor="Hand"
                                                        Focusable="True"
                                                        TabIndex="4"
                                                        ToolTip="Open Integrations">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToIntegrationsCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.NavigateToIntegrationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.NavigateToIntegrationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Puzzle"
                                                                   Width="48"
                                                                   Height="48"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,12"/>
                                            <TextBlock Text="Integrations"
                                                     FontSize="16"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     HorizontalAlignment="Center"
                                                     Margin="0,0,0,6"/>
