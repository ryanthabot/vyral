                            <local:ToolsView/>
                        </DataTemplate>

                        <!-- Integrations View -->
                        <DataTemplate DataType="{x:Type vm:IntegrationsViewModel}">
                            <local:IntegrationsView/>
                        </DataTemplate>

                        <!-- Documentation View -->
                        <DataTemplate DataType="{x:Type vm:DocumentationViewModel}">
                            <local:DocumentationView/>
                        </DataTemplate>

                        <!-- Moderator View -->
                        <DataTemplate DataType="{x:Type vm:ModeratorViewModel}">
                            <local:ModeratorView/>
                        </DataTemplate>

                        <!-- OBS View -->
                        <DataTemplate DataType="{x:Type vm:ObsViewModel}">
                            <local:ObsView/>
                        </DataTemplate>

                        <!-- Restream View -->
                        <DataTemplate DataType="{x:Type vm:RestreamViewModel}">
                            <local:RestreamView/>
                        </DataTemplate>

                        <!-- StreamDeck View -->
                        <DataTemplate DataType="{x:Type vm:StreamDeckViewModel}">
                            <local:StreamDeckView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
            </Grid>

            <!-- Profile Selector Overlay - Shows on startup if multiple profiles -->
            <Border Grid.RowSpan="2"
                    Background="{DynamicResource ModalBackgroundBrush}"
                    Panel.ZIndex="2000"
                    Visibility="{Binding ShowProfileSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <!-- Profile Selection Card -->
                    <materialDesign:Card Width="500"
                                        MaxHeight="600"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Padding="40"
                                        Visibility="{Binding ShowCreateProfile, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Vyral"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource VyralRedBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Select Your Profile"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Profile List -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="15,10"
                                                Margin="0,2"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"
                                                              MouseAction="LeftClick"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <materialDesign:PackIcon Grid.Column="1"
                                                                         Kind="Lock"
                                                                         Width="16"
                                                                         Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource TextMutedBrush}"
                                                                         ToolTip="PIN Protected"
                                                                         Visibility="{Binding HasPin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- PIN Entry (if needed) -->
                        <StackPanel Grid.Row="2"
                                    Margin="0,15,0,0"
                                    Visibility="{Binding ShowPinEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Enter PIN:"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ProfilePinBox"
                                         MaxLength="6"
                                         FontSize="14"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Padding="8"
                                         PasswordChanged="ProfilePinBox_PasswordChanged"/>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding ProfileErrorMessage}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ProfileErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button Content="Continue"
                                    Command="{Binding ConfirmProfileSelectionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource VyralRedBrush}"
                                    Width="120"
                                    FontSize="14"
                                    Margin="0,0,8,0"/>
                            <Button Content="New Profile"
                                    Command="{Binding CreateNewProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="120"
                                    FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                    <!-- Profile Creation Card -->
                    <materialDesign:Card Width="500"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Padding="40"
                                        Visibility="{Binding ShowCreateProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,25">
                            <TextBlock Text="Create New Profile"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Set up your Vyral profile"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Form Fields -->
                        <StackPanel Grid.Row="1">
                            <!-- Profile Name -->
                            <TextBlock Text="Profile Name *"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="e.g., mybotaccount"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,15"/>

                            <TextBlock Text="(letters, numbers, underscore, hyphen only)"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,-12,0,15"/>

                            <!-- Display Name -->
                            <TextBlock Text="Display Name (optional)"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="e.g., My Bot Account"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,15"/>

                            <!-- PIN Code -->
                            <TextBlock Text="PIN Code (optional)"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="NewProfilePinBox"
                                         materialDesign:HintAssist.Hint="4-6 digits"
                                         MaxLength="6"
                                         FontSize="14"
                                         Padding="8"
                                         Margin="0,0,0,5"
                                         PasswordChanged="NewProfilePinBox_PasswordChanged"/>

                            <TextBlock Text="Protect this profile with a PIN"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,0"/>
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding ProfileErrorMessage}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="12"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ProfileErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button Content="Create"
                                    Command="{Binding ConfirmCreateProfileCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource VyralRedBrush}"
                                    Width="120"
                                    FontSize="14"
                                    Margin="0,0,8,0"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelCreateProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="120"
                                    FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
