                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.OpenDiscordLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.OpenDiscordLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.OpenDiscordLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0"
                                                                   Kind="Forum"
                                                                   Width="24"
                                                                   Height="24"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource DiscordBrush}"/>

                                            <StackPanel Grid.Column="1" Margin="16,0">
                                                <TextBlock Text="Discord"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Join the Vyral community!"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <materialDesign:PackIcon Grid.Column="2"
                                                                   Kind="ChevronRight"
                                                                   Width="20"
                                                                   Height="20"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Ideas & Suggestions -->
                                    <Border Style="{StaticResource HomeQuickLinkBorder}"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            Padding="16"
                                            Cursor="Hand"
                                            Focusable="True"
                                            ToolTip="Share ideas and suggestions for Vyral">
                                        <Border.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.OpenIdeasLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                            <KeyBinding Key="Enter" Command="{Binding DataContext.OpenIdeasLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <KeyBinding Key="Space" Command="{Binding DataContext.OpenIdeasLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Grid.Column="0"
                                                                   Kind="Lightbulb"
                                                                   Width="24"
                                                                   Height="24"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource OrangeBadgeBrush}"/>

                                            <StackPanel Grid.Column="1" Margin="16,0">
                                                <TextBlock Text="Ideas &amp; Suggestions"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Share and discuss ideas for new features or improvements to Vyral"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <materialDesign:PackIcon Grid.Column="2"
                                                                   Kind="ChevronRight"
                                                                   Width="20"
                                                                   Height="20"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

