<UserControl x:Class="VyralBot.UI.Controls.ColorPicker.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="280"
             SnapsToDevicePixels="True"
             d:DesignHeight="330" d:DesignWidth="280">
    <!-- Every chrome brush resolves via DynamicResource so the picker itself follows live theme switches. -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderPrimaryBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10">
        <StackPanel Width="240" HorizontalAlignment="Center">

            <!-- Saturation / Value square: white -> pure hue (horizontal) layered under transparent -> black (vertical). -->
            <Grid x:Name="SatValArea" Width="240" Height="140" Cursor="Cross" Margin="0,0,0,8"
                  MouseLeftButtonDown="SatValArea_MouseLeftButtonDown"
                  MouseMove="SatValArea_MouseMove"
                  MouseLeftButtonUp="SatValArea_MouseLeftButtonUp"
                  LostMouseCapture="SatValArea_LostMouseCapture">
                <Rectangle x:Name="SatValFill" RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FF14B8A6" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle RadiusX="6" RadiusY="6">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas>
                    <Ellipse x:Name="SatValThumb" Width="14" Height="14"
                             Stroke="White" StrokeThickness="2" Fill="Transparent"
                             IsHitTestVisible="False"/>
                </Canvas>
            </Grid>

            <!-- Hue strip -->
            <Grid x:Name="HueArea" Width="240" Height="18" Cursor="Cross" Margin="0,0,0,10"
                  MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                  MouseMove="HueArea_MouseMove"
                  MouseLeftButtonUp="HueArea_MouseLeftButtonUp"
                  LostMouseCapture="HueArea_LostMouseCapture">
                <Rectangle RadiusX="9" RadiusY="9">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                            <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                            <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FFFF0000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas>
                    <Border x:Name="HueThumb" Width="12" Height="26" CornerRadius="6"
                            BorderBrush="White" BorderThickness="2" Background="Transparent"
                            IsHitTestVisible="False"/>
                </Canvas>
            </Grid>

            <!-- Preview swatch + current values -->
            <Grid Width="240" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewBorder" Grid.Column="0" Width="44" Height="30" CornerRadius="6"
                        BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HexLabel" Text="#14B8A6" FontFamily="Consolas" FontSize="13"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="RgbLabel" Text="R 20 &#xB7; G 184 &#xB7; B 166" FontFamily="Consolas" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Hex entry: accepts with or without '#', live-validates while typing, reverts garbage on Enter/LostFocus. -->
            <Grid Width="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hex" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" x:Name="HexBox"
                         Style="{StaticResource MaterialDesignTextBox}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontFamily="Consolas" FontSize="12"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
