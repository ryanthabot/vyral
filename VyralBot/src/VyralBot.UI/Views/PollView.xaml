<UserControl x:Class="VyralBot.UI.Views.PollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:PollViewModel}">
    
    <UserControl.Resources>
        <Style x:Key="StatusChip" TargetType="materialDesign:Chip">
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                    <Setter Property="Content" Value="⏳ Pending"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    <Setter Property="Content" Value="✅ Active"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                    <Setter Property="Content" Value="📊 Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                    <Setter Property="Content" Value="❌ Cancelled"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <converters:PlusOneConverter x:Key="PlusOneConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Poll List & Create Form -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="📊 Polls" 
                          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                          Margin="0,0,0,8"/>
                <Button Content="➕ Create New Poll"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Click="CreatePollButton_Click"
                       Margin="0,0,0,8"/>
                <Button Content="🔄 Refresh"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <!-- Poll List -->
            <ListBox Grid.Row="1" 
                    ItemsSource="{Binding Polls}"
                    SelectedItem="{Binding SelectedPoll, Mode=TwoWay}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8">
                            <TextBlock Text="{Binding Question}" 
                                      FontWeight="Bold"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,4"/>
                            <WrapPanel>
                                <materialDesign:Chip Style="{StaticResource StatusChip}"/>
                                <materialDesign:Chip Content="{Binding TotalVotes, StringFormat='{}{0} votes'}" 
                                                    Margin="4,0" Background="{DynamicResource SurfacePressedBrush}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" 
                                      FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right Panel: Poll Details -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Poll Details -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Poll Details" 
                          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                          Margin="0,0,0,16"/>

                <StackPanel Visibility="{Binding SelectedPoll, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedPoll.Question}" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      TextWrapping="Wrap"
                                      Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <!-- DataContext here is PollViewModel (no Status property):
                                     point the chip at the selected poll like the list template. -->
                                <materialDesign:Chip Style="{StaticResource StatusChip}"
                                                     DataContext="{Binding SelectedPoll}"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="▶️ Start"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Command="{Binding StartPollCommand}"
                                   Margin="4"/>
                            <Button Content="🏁 End"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Command="{Binding EndPollCommand}"
                                   Margin="4"/>
                            <Button Content="❌ Cancel"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Command="{Binding CancelPollCommand}"
                                   Margin="4"/>
                            <Button Content="🗑️ Delete"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Command="{Binding DeletePollCommand}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Margin="4"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,16"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Statistics" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalVotes, StringFormat='Total Votes: {0}'}" Margin="0,4"/>
                            <TextBlock Text="{Binding SelectedPoll.AllowedPlatforms, StringFormat='Allowed Platforms: {0}'}" Margin="0,4"/>
                            <TextBlock Text="{Binding SelectedPoll.CreatedAt, StringFormat='Created: {0:g}'}" Margin="0,4"/>
                            <TextBlock Text="{Binding SelectedPoll.StartedAt, StringFormat='Started: {0:g}'}" Margin="0,4"
                                      Visibility="{Binding SelectedPoll.StartedAt, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding SelectedPoll.EndedAt, StringFormat='Ended: {0:g}'}" Margin="0,4"
                                      Visibility="{Binding SelectedPoll.EndedAt, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Vote Results" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding VoteResults}" 
                                      TextWrapping="Wrap"
                                      Margin="0,4"
                                      VerticalAlignment="Top"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Select a poll to view details"
                          Foreground="{DynamicResource TextMutedBrush}"
                          Visibility="{Binding SelectedPoll, Converter={StaticResource InverseNullToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Votes List -->
            <GroupBox Grid.Row="1" Header="Votes" Margin="0,16,0,0"
                     Style="{StaticResource MaterialDesignCardGroupBox}">
                <DataGrid ItemsSource="{Binding Votes}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100"/>
                        <DataGridTextColumn Header="Option #" Binding="{Binding OptionIndex, Converter={StaticResource PlusOneConverter}}" Width="80"/>
                        <DataGridTextColumn Header="Voted At" Binding="{Binding VotedAt, StringFormat='{}{0:g}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Status Message -->
            <materialDesign:Snackbar Grid.Row="2" 
                                     MessageQueue="{materialDesign:MessageQueue}"
                                     x:Name="Snackbar"/>
            <TextBlock Grid.Row="2" 
                      Text="{Binding StatusMessage}" 
                      Margin="0,8,0,0"
                      FontWeight="Bold"
                      TextWrapping="Wrap"/>
        </Grid>

        <!-- Create Poll Dialog. Identifier MUST match the "RootDialog" used by
             CreatePollButton_Click (DialogHost.Show) and CreatePollAsync
             (DialogHost.Close) — without it the Show call throws. -->
        <materialDesign:DialogHost x:Name="CreatePollDialog" Identifier="RootDialog" Grid.ColumnSpan="2">
            <materialDesign:DialogHost.DialogContent>
                <StackPanel Width="500" Margin="16">
                    <TextBlock Text="Create New Poll" 
                              Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                              Margin="0,0,0,16"/>

                    <TextBox materialDesign:HintAssist.Hint="Poll Question"
                            Text="{Binding NewPollQuestion, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="0,0,0,16"/>

                    <TextBox materialDesign:HintAssist.Hint="Options (one per line)"
                            Text="{Binding NewPollOptions, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="100"
                            VerticalScrollBarVisibility="Auto"
                            Margin="0,0,0,16"/>

                    <CheckBox Content="Allow Vote Changes"
                             IsChecked="{Binding NewPollAllowMultipleVotes}"
                             Margin="0,0,0,8"/>

                    <CheckBox Content="Followers Only"
                             IsChecked="{Binding NewPollFollowersOnly}"
                             Margin="0,0,0,8"/>

                    <CheckBox Content="Subscribers Only"
                             IsChecked="{Binding NewPollSubscribersOnly}"
                             Margin="0,0,0,8"/>

                    <TextBox materialDesign:HintAssist.Hint="Minimum Watchtime (minutes)"
                            Text="{Binding NewPollMinWatchtime, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="0,0,0,16"/>

                    <TextBox materialDesign:HintAssist.Hint="Allowed Platforms (e.g., All, Twitch,Kick)"
                            Text="{Binding NewPollAllowedPlatforms, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                               CommandParameter="False"
                               Margin="0,0,8,0"/>
                        <Button Content="Create Poll"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding CreatePollCommand}"
                               CommandParameter="{Binding ElementName=CreatePollDialog}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>
