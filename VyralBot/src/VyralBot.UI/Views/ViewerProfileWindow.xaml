<Window x:Class="VyralBot.UI.Views.ViewerProfileWindow"
        Icon="/Resources/Images/vyral-logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundDarkBrush}">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar (borderless chrome, drag to move) ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountDetails"
                                             Width="22" Height="22"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding WindowTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding CanRefresh}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Reload this profile"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Close_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close"
                                                 Width="18" Height="18"
                                                 Foreground="{DynamicResource ErrorRedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Scrollable body ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12">

                <!-- ===== Identity ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Identity" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Loading…"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Viewer"
                                       Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding HeaderUsername, Mode=OneWay}"/>
                                <Run Text="("/><Run Text="{Binding HeaderPlatform, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Viewer ID"
                                       Style="{StaticResource MutedText}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewerIdDisplay}"
                                       Margin="0,2"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                       Text="Not linked — this account has no unified viewer identity yet."
                                       Foreground="{DynamicResource ErrorRedBrush}"
                                       Visibility="{Binding IsLinked, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Linked accounts ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Linked Accounts" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding WatchingNowSummary}" Margin="0,0,0,6"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasAccounts, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Accounts}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Account" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" Style="{StaticResource GridCell}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CurrentMarker}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Presence" Binding="{Binding LiveDisplay}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="State" Binding="{Binding VerifiedDisplay}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Linked At" Binding="{Binding LinkedAtDisplay}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding UnlinkCommand}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    ToolTip="Remove this account from the link group (banned-user override)">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="LinkOff"
                                                                             Width="16" Height="16"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0"
                                                                             Foreground="{DynamicResource ErrorRedBrush}"/>
                                                    <TextBlock Text="Unlink" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Platform status ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Platform Status" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasStatusRows, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding StatusRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="170"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasStatusRows, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding Username}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Sub" Binding="{Binding SubscriberDisplay}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tier" Binding="{Binding SubTierDisplay}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Months" Binding="{Binding SubscriberMonthsDisplay}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Follower" Binding="{Binding FollowerDisplay}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdatedDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Economy ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Economy" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasEconomyRows, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding EconomyRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="150"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasEconomyRows, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding Username}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Earned" Binding="{Binding EarnedDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Spent" Binding="{Binding SpentDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Recent transactions ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Recent Transactions" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasTransactions, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Transactions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="180"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasTransactions, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding TimestampDisplay}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Account" Binding="{Binding Username}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Amount" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AmountDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEarn}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Activity ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Activity" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasActivityRows, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding ActivityRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="150"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasActivityRows, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding Username}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Watchtime" Binding="{Binding TotalWatchtimeDisplay}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionMinutesDisplay}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Streak" Binding="{Binding StreakDisplay}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Now" Binding="{Binding ActiveDisplay}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Vyral goals completed ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Vyral Goals Completed" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasGoals, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Goals}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="140"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasGoals, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Goal" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Completed" Binding="{Binding CompletedDisplay}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Giveaway entries ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Giveaway Entries" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasGiveaways, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Giveaways}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="150"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasGiveaways, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Giveaway" Binding="{Binding GiveawayName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Entries" Binding="{Binding EntryCountDisplay}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Result" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WinnerDisplay}" Style="{StaticResource GridCell}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessGreenBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Entered" Binding="{Binding EnteredDisplay}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Perks ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Active Perks" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasPerks, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding Perks}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="140"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasPerks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Perk" Binding="{Binding PerkType}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Account" Binding="{Binding Username}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cost" Binding="{Binding CostDisplay}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ===== Event activity ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Event Activity" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Total events:" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalEvents}" Margin="6,0,14,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding EventsWindowDisplay}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Text="—" Margin="0,0,0,8"
                                   Visibility="{Binding HasEventStats, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        <DataGrid ItemsSource="{Binding EventStats}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  MaxHeight="160"
                                  Background="Transparent"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderColorBrush}"
                                  RowBackground="Transparent"
                                  Visibility="{Binding HasEventStats, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Count" Binding="{Binding CountDisplay}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCell}">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
