<UserControl x:Class="VyralBot.UI.Views.DiscordBotsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{DynamicResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Plain raised button template: deterministic hit area, no adorner-layer ripple -->
        <Style x:Key="VyralPlainDiscordButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DiscordBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain outline button: transparent with a hairline border -->
        <Style x:Key="VyralPlainOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain danger button: red, for destructive actions -->
        <Style x:Key="VyralPlainDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Robot"
                                            Width="28"
                                            Height="28"
                                            Foreground="{DynamicResource DiscordBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>
                    <TextBlock Text="Discord Bots"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Every Discord bot Vyral runs, each with its own dashboard"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="DashboardToggleButton"
                        Content="DASHBOARD"
                        Click="DashboardToggleButton_Click"
                        Style="{StaticResource VyralPlainOutlineButton}"
                        Margin="0,0,12,0"
                        ToolTip="Show the setup-bot dashboard: servers, active channel, connection status"/>
                <Button x:Name="AddBotButton"
                        Content="ADD BOT"
                        Command="{Binding ToggleAddBotCommand}"
                        Style="{StaticResource VyralPlainDiscordButton}"
                        Margin="0,0,12,0"/>
                <Button Content="BACK TO HOME →"
                        Command="{Binding DataContext.NavigateToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource VyralPlainOutlineButton}"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1"
                      x:Name="BotsContent"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">

                <!-- Quick Add card (primary add path) -->
                <materialDesign:Card Padding="24"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     Effect="{DynamicResource CardShadow}"
                                     Margin="0,0,0,16"
                                     Visibility="{Binding IsAddPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Quick Add"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Paste a bot token to add it right away — Vyral verifies the token by connecting the bot. The bot needs the MESSAGE CONTENT INTENT enabled in the Discord Developer Portal (Bot tab &gt; Privileged Gateway Intents), or it cannot read messages."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NewBotName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Bot name (e.g. Community Bot)"
                                     FontSize="13"
                                     Padding="8"
                                     VerticalAlignment="Center"/>

                            <PasswordBox Grid.Column="2"
                                     x:Name="NewBotTokenBox"
                                     PasswordChanged="NewBotTokenBox_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Bot token"
                                     FontSize="13"
                                     FontFamily="Consolas"
                                     Padding="8"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="4"
                                    Content="ADD"
                                    Command="{Binding AddBotCommand}"
                                    Style="{StaticResource VyralPlainDiscordButton}"
                                    IsEnabled="{Binding IsAdding, Converter={StaticResource InvertBooleanConverter}}"/>

                            <Button Grid.Column="6"
                                    Content="RUN FULL WIZARD"
                                    Command="{Binding RunFullWizardCommand}"
                                    Style="{StaticResource VyralPlainOutlineButton}"
                                    ToolTip="Opens the full Discord setup wizard (configures the primary setup bot)"/>
                        </Grid>

                        <TextBlock Text="{Binding AddStatus}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding AddStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Bot cards -->
                <ItemsControl ItemsSource="{Binding Bots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Padding="20,16"
                                                 Background="{DynamicResource CardBackgroundBrush}"
                                                 Effect="{DynamicResource CardShadow}"
                                                 Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Title row: name (or inline rename) + live status -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Rocket badge: this bot starts with the app -->
                                                <materialDesign:PackIcon Kind="Rocket"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource DiscordBrush}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,6,0"
                                                                         ToolTip="Starts with the app"
                                                                         Visibility="{Binding AutoStart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsRenaming, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="260"
                                                         FontSize="14"
                                                         Padding="6"
                                                         materialDesign:HintAssist.Hint="New name"
                                                         VerticalAlignment="Center"/>
                                                <Button Content="SAVE"
                                                        Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VyralPlainDiscordButton}"
                                                        Height="34"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="CANCEL"
                                                        Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource VyralPlainOutlineButton}"
                                                        Height="34"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorRedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Detected identity (auto-detected when this bot connects) -->
                                    <TextBlock Text="{Binding IdentityText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,6,0,0"/>

                                    <!-- Meta: bot account + server count (live, when connected) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding BotUsername, StringFormat='Bot account: {0}'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,0,16,0"
                                                   Visibility="{Binding BotUsername, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ServerCountText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding ServerCountText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="OPEN"
                                                Command="{Binding DataContext.OpenBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VyralPlainDiscordButton}"/>

                                        <Button Content="START"
                                                Command="{Binding DataContext.StartBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VyralPlainOutlineButton}"
                                                Margin="12,0,0,0"
                                                Visibility="{Binding IsConnected, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"/>

                                        <Button Content="STOP"
                                                Command="{Binding DataContext.StopBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VyralPlainDangerButton}"
                                                Margin="12,0,0,0"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"/>

                                        <Button Content="RENAME"
                                                Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VyralPlainOutlineButton}"
                                                Margin="12,0,0,0"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"/>

                                        <Button Content="REMOVE"
                                                Command="{Binding DataContext.RemoveBotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VyralPlainDangerButton}"
                                                Margin="12,0,0,0"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="24"
                            Visibility="{Binding HasBots, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Robot"
                                             Width="48"
                                             Height="48"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,12"/>
                    <TextBlock Text="No Discord bots yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Add your first bot above — paste its name and token, or run the full setup wizard."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Page status line -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Dashboard tab host: the DiscordDashboardView is created here from DI on
             first open (code-behind), which triggers its Loaded → InitializeAsync. -->
        <ContentControl x:Name="DashboardHost"
                        Grid.Row="1"
                        Visibility="Collapsed"/>
    </Grid>
</UserControl>
