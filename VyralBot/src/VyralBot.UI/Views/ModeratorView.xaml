<UserControl x:Class="VyralBot.UI.Views.ModeratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModeratorViewModel}"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}">

            <!-- Back Button -->
            <Button Content="&#8592; BACK TO HOME"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding DataContext.NavigateToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="0,0,0,16"/>

            <!-- Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <materialDesign:PackIcon Kind="ShieldAccount" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Moderator"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Mod channel, mod roles, action log and !mod commands"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,20"/>

            <!-- Status Message -->
            <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,12"
                    Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ============================================================ -->
            <!-- Section 1: Mod Channel                                        -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Mod Channel"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="The private channel where !mod commands and mod-action announcements are posted."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Shield" Width="20" Height="20"
                                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ModChannelStatus}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <Button Content="Create mod channel"
                                Command="{Binding CreateModChannelCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Creates the channel on the primary running bot and saves its ID"/>
                    </StackPanel>

                    <!-- Auto-create toggle -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-create when missing"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Create the mod channel automatically the first time a mod action needs it"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding AutoCreateModChannel}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                    </Grid>

                    <!-- Mod role name -->
                    <TextBlock Text="Mod role name"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ModRoleName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             materialDesign:HintAssist.Hint="Vyral Mod"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="280"
                             HorizontalAlignment="Left"
                             ToolTip="Name of the Discord role granted to mods (used when creating the mod channel)"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 2: Mod Roles                                          -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Mod Roles"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Assign one of the four mod tiers to a Discord user. Tiers map to the ModTiers rank order."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Add form -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewModDiscordUserId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Discord user ID"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding NewModUsername, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Username"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding Tiers}"
                                  SelectedItem="{Binding SelectedModTier}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  VerticalAlignment="Center"/>
                        <Button Grid.Column="6"
                                Content="Assign"
                                Command="{Binding AssignModRoleCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Assignment rows -->
                    <ItemsControl ItemsSource="{Binding ModAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DiscordUserId, StringFormat=&lt;{0}&gt;}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource PrimaryLightBrush}"
                                                CornerRadius="3"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tier}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AssignedBy, StringFormat=by {0}}"
                                                   ToolTip="{Binding AssignedBy, StringFormat=by {0}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.RemoveModRoleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4"
                                                ToolTip="Remove this mod role assignment"
                                                AutomationProperties.Name="Remove mod role assignment">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                                     Foreground="{DynamicResource ErrorBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 3: Command Channels                                   -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pound" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Command Channels"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Channels where !mod commands are accepted (Moderation or Admin purpose). None configured means every channel."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding LoadCommandChannelsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                VerticalAlignment="Center"
                                ToolTip="Reloads the monitored channels tagged Moderation or Admin">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CommandChannels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 4: Discord Role Tiers                                 -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAccount" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Discord Role Tiers"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Map Discord roles to mod tiers — members holding a mapped role gain that tier. Pick a role and change its tier to save."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding LoadRolesCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                VerticalAlignment="Center"
                                ToolTip="Loads the primary bot's guild roles and the stored tier mappings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Load roles" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox ItemsSource="{Binding RoleTiers}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DiscordRoleId}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.RoleTierOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding SelectedTier, Mode=TwoWay}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Tier granted to members holding this role — None removes the mapping"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding RoleTierStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding RoleTierStatus, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 5: Action Log                                         -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Action Log"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="The latest 100 moderation actions performed by your mod team"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding ModActionFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Filter (user / action / reason)"
                                     Width="220"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     ToolTip="Filters the loaded batch by action kind, target, mod or reason — e.g. AutoMod, ban, a username"/>
                            <Button Command="{Binding RefreshModActionsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ModActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Action}"
                                                   ToolTip="{Binding Action}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,12,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} &#8594; {1}">
                                                    <Binding Path="ModUsername"/>
                                                    <Binding Path="TargetUsername"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Details}"
                                                   ToolTip="{Binding Details}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="260"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 5b: Auto-Moderation (chat content filter)             -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Shield" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Auto-Moderation"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Chat content filter evaluated for every incoming message: caps, links, emojis, banned words, repeated messages and ASCII art, with a warning → timeout → ban escalation ladder. Platforms without a moderation API degrade gracefully (delete/warn) instead of failing."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,12,0"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding AutoModEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Top"
                                      Margin="16,0,0,0"
                                      ToolTip="Master switch — off passes every message"/>
                    </Grid>

                    <!-- Column headers for the rule rows -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rule" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="Threshold" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="Action" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="Second value" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="Timeout (s)" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="Enabled" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0"/>
                    </Grid>

                    <!-- Rule rows -->
                    <ItemsControl ItemsSource="{Binding AutoModRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="{Binding ThresholdLabel}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding DataContext.AutoModActionOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Action, Mode=TwoWay}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="3"
                                                 Text="{Binding MinLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="{Binding MinLengthLabel}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="4"
                                                 Text="{Binding TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>

                                        <ToggleButton Grid.Column="5"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Enable this rule"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Exemptions (uniform across all rules) + platform filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Exempt from all rules:"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <CheckBox Content="Moderators"
                                  IsChecked="{Binding AutoModExemptModerators}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                        <CheckBox Content="VIPs"
                                  IsChecked="{Binding AutoModExemptVips}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                        <CheckBox Content="Subscribers"
                                  IsChecked="{Binding AutoModExemptSubscribers}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,24,0"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="(the broadcaster is always exempt)"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Text="{Binding AutoModPlatformsText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Platforms (comma-separated, empty = all — e.g. Twitch, Kick)"
                             Width="420"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,12"/>

                    <!-- Escalation ladder -->
                    <TextBlock Text="Escalation (strikes per viewer per platform)"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ToggleButton IsChecked="{Binding EscalationEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"
                                      ToolTip="Upgrade repeat offenders: warn/delete → timeout → ban"/>
                        <TextBox Text="{Binding EscalationStrikesToTimeout, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Strikes → timeout"
                                 Width="130"
                                 Margin="0,0,8,0"/>
                        <TextBox Text="{Binding EscalationStrikesToBan, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Strikes → ban"
                                 Width="120"
                                 Margin="0,0,8,0"/>
                        <TextBox Text="{Binding EscalationWindowMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Window (min)"
                                 Width="110"
                                 Margin="0,0,8,0"/>
                        <TextBox Text="{Binding EscalationBaseTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Base timeout (s)"
                                 Width="130"/>
                    </StackPanel>

                    <!-- Allowlists / banned words / word overrides / exempt users -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LinkAllowlistText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Link allowlist (one domain per line)"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="90"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding BannedWordsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Banned words / phrases (one per line)"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="90"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Column="4"
                                 Text="{Binding WordAllowlistText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Word allowlist (one per line — never banned)"
                                 ToolTip="Words that never count as violations, even if they appear in the banned list"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="90"
                                 VerticalContentAlignment="Top"/>
                        <TextBox Grid.Column="6"
                                 Text="{Binding ExemptUsersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Exempt users (one per line)"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="90"
                                 VerticalContentAlignment="Top"/>
                    </Grid>

                    <!-- Test a message against the live rules -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Text="{Binding AutoModTestMessage, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Test a message against the live rules"
                                 Width="420"
                                 VerticalAlignment="Center"/>
                        <Button Content="Test"
                                Command="{Binding TestAutoModMessageCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Evaluates the message as a plain Twitch viewer — no action is executed"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AutoModTestResult}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding AutoModTestResult, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                    <!-- Platform enforcement parity (renders ModerationPlatformParity.Table
                         via ModerationPlatformParity.Snapshot — level badge + detail per row) -->
                    <TextBlock Text="Platform enforcement parity"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding AutoModPlatformStatus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Platform}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Width="64" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding LevelText}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Width="90" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Full">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="NoticeOnly">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="None">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Save / reset -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save auto-mod rules"
                                Command="{Binding SaveAutoModConfigCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryBrush}"/>
                        <Button Content="Reset escalation state"
                                Command="{Binding ResetAutoModEscalationCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="16,0,0,0"
                                ToolTip="Clears every viewer's strike and repeat tracking"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AutoModStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding AutoModStatus, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ============================================================ -->
            <!-- Section 6: Moderator Commands (visual Flow editor workflows)  -->
            <!-- ============================================================ -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                 Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Terminal" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Moderator Commands"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Custom !mod verbs as workflows: author them in the visual Flow editor, Discord runs them with mod-tier gating (built-in verbs keep precedence)."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,12,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenModeratorCommandEditorCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center"
                                ToolTip="Opens the Flow editor on a new moderator command workflow">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Add moderator command" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Existing mod_command workflow rows -->
                    <ItemsControl ItemsSource="{Binding ModCommandWorkflows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CommandLabel}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}"
                                            ToolTip="{Binding Name}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StepSummary, StringFormat=· {0}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Enabled"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Command="{Binding DataContext.ToggleModCommandWorkflowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0"
                                                      ToolTip="Disabled commands never fire — flip this to arm them"/>
                                            <Button Content="Edit in visual builder"
                                                    Click="OnModCommandCanvasClick"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Open this workflow in the visual Flow editor"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ModCommandStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding ModCommandStatus, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>

        <!-- ============================================================
             VISUAL EDITOR overlay: full-size host for FlowEditorView
             (collapsed until "Add moderator command" opens it — same
             hosting pattern as AutomationView; the editor's own close
             command hides it again)
             ============================================================ -->
        <Border x:Name="FlowEditorOverlay"
                Panel.ZIndex="100"
                Background="{DynamicResource BackgroundDarkBrush}"
                Visibility="Collapsed">
            <ContentControl x:Name="FlowEditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
