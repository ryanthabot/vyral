<UserControl x:Class="VyralBot.UI.Views.TwitchDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Inverse Boolean Converter -->
        <Style x:Key="InverseVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowStreamPreview}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Live/Offline Status Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TwitchBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Text" Value="LIVE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- Stream Manager Layout - Flexible Grid -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Column - Vertically Stacked Panels -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="300"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>
                
                <!-- Stream Preview Panel -->
                <materialDesign:Card Grid.Row="0" 
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid>
                                <TextBlock Text="Stream Preview" 
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Username}" 
                                             FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTextStyle}"/>
                                    </Border>
                                    <Button Command="{Binding TogglePreviewPanelCommand}"
                                          Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="Hide Panel"
                                          Width="28"
                                          Height="28"
                                          Padding="0"
                                          Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    
                        <!-- Stream Preview Content -->
                        <Grid Grid.Row="1" Background="{DynamicResource TwitchBackgroundBrush}">
                        <!-- Show Preview Button (shown when preview is not active) -->
                        <Border Style="{StaticResource InverseVisibilityStyle}"
                                Background="{DynamicResource TwitchSurfaceBrush}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Button Command="{Binding PreviewStreamCommand}"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Height="120"
                                  Width="250">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="PlayCircle" 
                                                           Width="48" 
                                                           Height="48"
                                                           Foreground="{DynamicResource TwitchBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                    <TextBlock Text="SHOW PREVIEW" 
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click to load stream" 
                                             FontSize="12"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        
                        <!-- WebView2 Stream Player (shown when preview is active) -->
                        <Grid Visibility="{Binding ShowStreamPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- WebView2 created programmatically on-demand to avoid spawning Edge processes at startup -->
                            <Border x:Name="StreamPreviewWebViewContainer"/>
                            
                            <!-- Close Preview Button -->
                            <Button Command="{Binding CloseStreamPreviewCommand}"
                                  Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                  Background="{DynamicResource TwitchDarkBrush}"
                                  Foreground="White"
                                  ToolTip="Hide Preview"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="12"
                                  Width="32"
                                  Height="32">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                    </Grid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
                
                <!-- Vertical Splitter -->
                <GridSplitter Grid.Row="1" 
                             Height="4" 
                             HorizontalAlignment="Stretch" 
                             Background="{StaticResource BorderLightBrush}"
                             ShowsPreview="True"
                             Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Activity Feed Panel -->
                <materialDesign:Card Grid.Row="2" 
                                    Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Activity Feed" 
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <!-- Activity List -->
                        <ScrollViewer Grid.Row="1" 
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="12">
                            <StackPanel>
                                <TextBlock Text="It's quiet. Too quiet..." 
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,32,0,8"/>
                                <TextBlock Text="We'll show your new follows, subs, cheers, and raids activity here." 
                                         FontSize="12"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Margin="12,0,12,32"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>
            
            <!-- Horizontal Splitter -->
            <GridSplitter Grid.Column="1" 
                         Width="4" 
                         HorizontalAlignment="Stretch" 
                         Background="{StaticResource BorderLightBrush}"
                         ShowsPreview="True"/>
            
            <!-- Right Column - Quick Actions Panels -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="250"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*" MinHeight="250"/>
                </Grid.RowDefinitions>
                
                <!-- Quick Actions Panel 1: Stream Management -->
                <materialDesign:Card Grid.Row="0" 
                                    Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Stream Management" 
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <!-- Actions Grid -->
                        <ScrollViewer Grid.Row="1" 
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="8">
                            <UniformGrid Columns="2">
                                <!-- Edit Stream Info -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Pencil" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Edit Stream Info" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Add Stream Marker -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Bookmark" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Add Stream Marker" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Add Marker with Description -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="BookmarkPlus" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Marker + Desc" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Clip That -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ContentCut" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Clip That" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Stop Raids 1hr -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ShieldOff" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Stop Raids 1hr" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Raid Channel -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountGroup" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Raid Channel" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Manage Goals -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Target" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Manage Goals" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Stream Together -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountMultiple" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Stream Together" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
                
                <!-- Vertical Splitter -->
                <GridSplitter Grid.Row="1" 
                             Height="4" 
                             HorizontalAlignment="Stretch" 
                             Background="{StaticResource BorderLightBrush}"
                             ShowsPreview="True"/>
                
                <!-- Quick Actions Panel 2: Chat Moderation -->
                <materialDesign:Card Grid.Row="2" 
                                    Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Chat Moderation" 
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <!-- Actions Grid -->
                        <ScrollViewer Grid.Row="1" 
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="8">
                            <UniformGrid Columns="2">
                                <!-- Clear Chat -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Eraser" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Clear Chat" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Emote Only -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="EmoticonHappy" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Emote Only" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Follower Only -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountCheck" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Follower Only" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                
                                <!-- Shield Mode -->
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Height="70"
                                      Margin="4">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Shield" 
                                                               Width="20" 
                                                               Height="20"
                                                               Margin="0,0,0,6"/>
                                        <TextBlock Text="Shield Mode" 
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
