<UserControl x:Class="VyralBot.UI.Views.ObsHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ObsHostViewModel}"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="16,8,16,16">

        <!-- Top strip: host status + actions + remote-control line -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Video" Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HostStatusText}" Margin="8,0,12,0" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- "hosted" badge while the real OBS window lives inside the page -->
                    <Border CornerRadius="6" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                            Visibility="{Binding IsHosted, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="hosted" FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <Button Command="{Binding RelaunchCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Relaunch" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenInOwnWindowCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Open in own window" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RemoteStatusText}" FontSize="11" TextAlignment="Right"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>

            <!-- Transient notes (remote-control enable, timeout hint, install result) -->
            <TextBlock Text="{Binding StatusNote}" Margin="28,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding DeembedNoteText}" Margin="28,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding IsObsInstalled, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Grid>
            <!-- Installed: the real OBS window, embedded -->
            <Border Background="#FF101010" Visibility="{Binding IsObsInstalled, Converter={StaticResource BoolToVis}}">
                <controls:ObsWindowEmbedHost x:Name="Embed"/>
            </Border>

            <!-- Not installed: silent acquisition panel -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding IsObsInstalled, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="Download" Width="22" Height="22"
                                             Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="OBS Studio isn't installed yet." FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <Button Command="{Binding InstallObsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Install OBS Studio" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ProgressBar Maximum="100" Height="6" Margin="0,0,0,8"
                             Value="{Binding AcquirePercent, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AcquirePercent}" Value="-1">
                                    <Setter Property="IsIndeterminate" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding AcquireProgressText}" FontSize="12" Margin="0,0,0,12"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding AttributionNotice}" FontSize="11" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="The Bot Studio tab still works without OBS." FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
