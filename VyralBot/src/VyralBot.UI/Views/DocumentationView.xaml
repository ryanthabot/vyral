<UserControl x:Class="VyralBot.UI.Views.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DocumentationViewModel}"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <!-- Translucent red wash behind the selected doc-nav entry (tracks the
             palette's canonical ErrorColor; same pattern as FlowEditorView). -->
        <SolidColorBrush x:Key="DocNavSelectedBackgroundBrush" Color="{DynamicResource ErrorColor}" Opacity="0.2"/>
    </UserControl.Resources>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← BACK TO HOME"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding DataContext.NavigateToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}" ToolTip="Back (Alt+Left)" Padding="8,4"
                            AutomationProperties.Name="Back">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding GoForwardCommand}"
                            IsEnabled="{Binding CanGoForward}" ToolTip="Forward (Alt+Right)" Padding="8,4"
                            AutomationProperties.Name="Forward">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,12,0">
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentPath}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" VerticalAlignment="Center" Margin="0,0,8,0"
                         ToolTip="Filter pages by title"/>
                <Button Grid.Column="4" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding RefreshDocsCommand}"
                        ToolTip="Reload documentation (picks up edits to the markdown files)" Padding="8,4"
                        AutomationProperties.Name="Reload documentation">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding OpenDocsFolderCommand}"
                        ToolTip="Open the AppDocs folder" Padding="8,4"
                        AutomationProperties.Name="Open docs folder">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Status / error bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Left navigation tree (sections always expanded, GitBook-style) -->
        <Border DockPanel.Dock="Left" Width="290" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10,12,6,12">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocNavSection}">
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,4"
                                           ToolTip="{Binding Title}"/>
                                <ItemsControl ItemsSource="{Binding Pages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DocNavPage}">
                                            <Button Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,1,0,1"
                                                    ToolTip="{Binding Title}"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="4"
                                                                Padding="10,5" Margin="0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource DocNavSelectedBackgroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock x:Name="NavText" Text="{Binding Title}" FontSize="12.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource ErrorLightBrush}"/>
                                                                                <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Content browser -->
        <Grid Background="{DynamicResource BackgroundPrimaryBrush}">
            <Border x:Name="BrowserHost"/>
        </Grid>
    </DockPanel>
</UserControl>
