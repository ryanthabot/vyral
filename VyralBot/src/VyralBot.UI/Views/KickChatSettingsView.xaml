<UserControl x:Class="VyralBot.UI.Views.KickChatSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12" CornerRadius="6" MaxWidth="400">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
            <StackPanel>
                <TextBlock Text="Kick — Event Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                <!-- Follow Events -->
                <Expander Header="🎉 Follow Events" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <!-- Show in Chat Toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowFollowsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <!-- Auto-Reply Toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding FollowAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <!-- Auto-Reply Message -->
                        <TextBox Text="{Binding FollowAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding FollowAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {count}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Subscribe Events -->
                <Expander Header="⭐ Subscribe Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowSubscribesInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding SubscribeAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding SubscribeAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding SubscribeAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {months}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Gift Sub Events -->
                <Expander Header="🎁 Gift Sub Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowGiftSubsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding GiftSubAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding GiftSubAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding GiftSubAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {gifter}, {count}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Host Events -->
                <Expander Header="📡 Host Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowHostsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding HostAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding HostAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding HostAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {hoster}, {viewers}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Kicks Gifted Events -->
                <Expander Header="💰 Kicks Gifted Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowKicksGiftedInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding KicksGiftedAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding KicksGiftedAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding KicksGiftedAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {sender}, {amount}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Reward Redeemed Events -->
                <Expander Header="🎯 Reward Redeemed Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowRewardsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding RewardAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding RewardAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding RewardAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {reward}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Stream Status Events -->
                <Expander Header="📺 Stream Status Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowStreamStatusInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>
                        <TextBlock Text="Stream start/end notifications" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Save Button -->
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource KickBrush}"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch"/>

                <!-- Status Message -->
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource KickBrush}"
                          HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
