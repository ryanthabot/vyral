<Window x:Class="VyralBot.UI.Views.ShareCommandDialog"
        Icon="/Resources/Images/vyral-logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Share to Marketplace"
        Height="470"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="20,16">
                <TextBlock Text="🛒 Share to Marketplace"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="24,18">
                <TextBlock Text="Command name"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox"
                         Height="38"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Giveaway Roll"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBlock Text="Description"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,4"/>
                <TextBox x:Name="DescriptionBox"
                         Height="64"
                         Padding="8,6"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Category"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryBox"
                                  Height="38"
                                  ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Label"
                                  SelectedIndex="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Author (optional)"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AuthorBox"
                                 Height="38"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="The command is published under a share code (copied to your clipboard after sharing). Anyone can import it from the Marketplace."
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="CANCEL"
                            Click="Cancel_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Width="100"
                            Height="40"
                            Margin="0,0,12,0"/>
                    <Button Content="SHARE"
                            Click="Share_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource TextOnPrimaryBrush}"
                            Width="120"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
