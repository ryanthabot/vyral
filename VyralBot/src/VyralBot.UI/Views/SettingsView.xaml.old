<UserControl x:Class="VyralBot.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             Background="{DynamicResource BackgroundPrimaryBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category Navigation -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profile Category -->
                        <RadioButton Content="Profile" 
                                     GroupName="SettingsCategory"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Profile}"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Profile"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Account" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Profile" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Theme Category -->
                        <RadioButton Content="Theme" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Theme"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Palette" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Theme" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Data Management Category -->
                        <RadioButton Content="Data" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Data"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Database" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Data Management" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Notifications Category -->
                        <RadioButton Content="Notifications" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Notifications"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Bell" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Notifications" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Commands Category -->
                        <RadioButton Content="Commands" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Commands"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Commands" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Timers Category -->
                        <RadioButton Content="Timers" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Timers"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Timers" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Automation Category -->
                        <RadioButton Content="Automation" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Automation"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Robot" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Automation" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- API & Webhooks Category -->
                        <RadioButton Content="API" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="API"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Api" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="API &amp; Webhooks" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Performance Category -->
                        <RadioButton Content="Performance" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Performance"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Speedometer" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Performance" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Security Category -->
                        <RadioButton Content="Security" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Security"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Security" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Security" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>

                        <!-- Advanced Category -->
                        <RadioButton Content="Advanced" 
                                     GroupName="SettingsCategory"
                                     Command="{Binding SelectCategoryCommand}"
                                     CommandParameter="Advanced"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Margin="0,4">
                            <RadioButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog" 
                                                             Width="20" 
                                                             Height="20" 
                                                             Margin="0,0,12,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Advanced" 
                                               FontSize="14" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton.Content>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!-- Status Message -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource VyralRedBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,12"
                    Margin="0,0,0,16"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- General Settings Section -->
            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Auto-Login Setting -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-Login" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Skip profile selection and automatically login to the current profile" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding AutoLogin}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                    </Grid>

                    <Button Content="Save Settings"
                            Command="{Binding SaveAutoLoginCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource VyralRedBrush}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Profile Management Section -->
            <materialDesign:Card Padding="24">
                <StackPanel>
                    <TextBlock Text="Profile Management" 
                               FontSize="20" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Current Profile:" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource VyralRedBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CurrentProfile.DisplayName}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentProfile.Name}" 
                                           FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding ShowChangePinDialogForProfileCommand}"
                                    CommandParameter="{Binding CurrentProfile}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Lock" 
                                                             Width="16" 
                                                             Height="16" 
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Change PIN" 
                                               Margin="4,0,0,0" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="All Profiles:" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1"
                                Command="{Binding ShowCreateProfileDialogForSettingsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource VyralRedBrush}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" 
                                                         Width="16" 
                                                         Height="16" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="New Profile" 
                                           Margin="4,0,0,0" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Profiles List -->
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock FontSize="10" 
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,4,0,0">
                                                <Run Text="Last used: "/>
                                                <Run Text="{Binding LastUsedAt, StringFormat='MMM dd, yyyy'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.ShowSwitchProfileDialogForProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" 
                                                                             Width="16" 
                                                                             Height="16" 
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Switch" 
                                                               Margin="4,0,0,0" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Export" 
                                                                             Width="16" 
                                                                             Height="16" 
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Export" 
                                                               Margin="4,0,0,0" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Command="{Binding DataContext.RequestDeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4"
                                                    Foreground="{DynamicResource ErrorBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" 
                                                                             Width="16" 
                                                                             Height="16" 
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Delete" 
                                                               Margin="4,0,0,0" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- Delete Confirmation Overlay -->
            <Grid Visibility="{Binding ShowDeleteConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource ModalBackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                
                <materialDesign:Card Width="400"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="24">
                    <StackPanel>
                        <TextBlock Text="Delete Profile?" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                        
                        <TextBlock Text="This action cannot be undone. All profile data will be permanently deleted." 
                                   FontSize="13" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelDeleteCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Delete"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource ErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Change PIN Overlay -->
            <Grid Visibility="{Binding ShowChangePinDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource ModalBackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                
                <materialDesign:Card Width="450"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="32">
                    <StackPanel>
                        <TextBlock Text="Change PIN" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Current PIN -->
                        <TextBlock Text="Current PIN (if set)" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="CurrentPinBox"
                                     MaxLength="6"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,15"
                                     PasswordChanged="CurrentPinBox_PasswordChanged"/>

                        <!-- New PIN -->
                        <TextBlock Text="New PIN (4-6 digits, leave blank to remove)" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="NewPinBox"
                                     MaxLength="6"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,15"
                                     PasswordChanged="NewPinBox_PasswordChanged"/>

                        <!-- Confirm New PIN -->
                        <TextBlock Text="Confirm New PIN" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ConfirmNewPinBox"
                                     MaxLength="6"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,20"
                                     PasswordChanged="ConfirmNewPinBox_PasswordChanged"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelChangePinCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Save"
                                    Command="{Binding ConfirmChangePinCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource VyralRedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Create Profile Overlay -->
            <Grid Visibility="{Binding ShowCreateProfileDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource ModalBackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                
                <materialDesign:Card Width="500"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="32">
                    <StackPanel>
                        <TextBlock Text="Create New Profile" 
                                   FontSize="20" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Profile Name -->
                        <TextBlock Text="Profile Name *" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="e.g., mybotaccount"
                                 FontSize="14"
                                 Padding="8"
                                 Margin="0,0,0,5"/>
                        <TextBlock Text="(letters, numbers, underscore, hyphen only)" 
                                   FontSize="10" 
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,15"/>

                        <!-- Display Name -->
                        <TextBlock Text="Display Name (optional)" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="e.g., My Bot Account"
                                 FontSize="14"
                                 Padding="8"
                                 Margin="0,0,0,15"/>

                        <!-- PIN -->
                        <TextBlock Text="PIN Code (optional)" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="NewProfilePinBoxSettings"
                                     MaxLength="6"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,5"
                                     PasswordChanged="NewProfilePinBoxSettings_PasswordChanged"/>
                        <TextBlock Text="Protect this profile with a 4-6 digit PIN" 
                                   FontSize="10" 
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelCreateProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Create"
                                    Command="{Binding ConfirmCreateProfileCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource VyralRedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Switch Profile Overlay -->
            <Grid Visibility="{Binding ShowSwitchProfileDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource ModalBackgroundBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                
                <materialDesign:Card Width="400"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="24">
                    <StackPanel>
                        <TextBlock Text="Switch Profile" 
                                   FontSize="20" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,20">
                            <Run Text="Enter the PIN for "/>
                            <Run Text="{Binding _profileToSwitchTo.DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" to switch to this profile."/>
                        </TextBlock>

                        <!-- PIN -->
                        <TextBlock Text="PIN Code" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="SwitchProfilePinBox"
                                     MaxLength="6"
                                     FontSize="14"
                                     Padding="8"
                                     Margin="0,0,0,20"
                                     PasswordChanged="SwitchProfilePinBox_PasswordChanged"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelSwitchProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Switch Profile"
                                    Command="{Binding ConfirmSwitchProfileCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource VyralRedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
