<UserControl x:Class="VyralBot.UI.Views.TiktokChatSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="6">
        <StackPanel Width="280">
            <TextBlock Text="TikTok — Chat Quick Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

            <!-- Coming-soon gate: no TikTok chat pipeline exists in this version. -->
            <TextBlock Text="Coming soon — VyralBot cannot read or send TikTok LIVE chat yet. Settings below take effect once TikTok chat support ships."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Show messages" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Show TikTok messages in the unified chat (coming soon)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsChatEnabled, Mode=TwoWay}"
                              IsEnabled="{x:Static vm:TiktokChatSettingsViewModel.ChatPipelineAvailable}"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"/>
            </Grid>

            <Separator Margin="8,10"/>
            <StackPanel Orientation="Vertical" IsEnabled="{x:Static vm:TiktokChatSettingsViewModel.ChatPipelineAvailable}">
                <CheckBox Content="Show Badges" IsChecked="{Binding ShowBadges, Mode=TwoWay}"/>
                <CheckBox Content="Show Timestamps" IsChecked="{Binding ShowTimestamps, Mode=TwoWay}"/>
                <CheckBox Content="Compact Mode" IsChecked="{Binding CompactMode, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
