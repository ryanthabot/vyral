<UserControl x:Class="VyralBot.UI.Views.TwitchChatSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="12" CornerRadius="6" MaxWidth="400"
            Effect="{DynamicResource CardShadow}">
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
            <StackPanel>
                <TextBlock Text="Twitch — Event Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                <!-- Follow Events -->
                <Expander Header="🎉 Follow Events" IsExpanded="True" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <!-- Show in Chat Toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowFollowsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <!-- Auto-Reply Toggle -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding FollowAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <!-- Auto-Reply Message -->
                        <TextBox Text="{Binding FollowAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding FollowAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Subscribe Events -->
                <Expander Header="⭐ Subscribe Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowSubscribesInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding SubscribeAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding SubscribeAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding SubscribeAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {tier}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Resub Events -->
                <Expander Header="🔁 Resub Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowResubsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ResubAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding ResubAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding ResubAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {months}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Gift Sub Events -->
                <Expander Header="🎁 Gift Sub Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowGiftSubsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding GiftSubAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding GiftSubAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding GiftSubAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {gifter}, {count}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Raid Events -->
                <Expander Header="🚀 Raid Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowRaidsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding RaidAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding RaidAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding RaidAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {raider}, {viewers}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Cheer Events -->
                <Expander Header="💎 Cheer Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowCheersInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding CheerAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding CheerAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding CheerAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {bits}" FontSize="10" 
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Save Button -->
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource TwitchBrush}"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch"/>

                <!-- Status Message -->
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TwitchBrush}"
                          HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
