<UserControl x:Class="VyralBot.UI.Views.SettingsView"
             x:Name="SettingsViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls.ColorPicker"
             Background="{DynamicResource BackgroundPrimaryBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:EqualsToVisibilityConverter x:Key="EqualsToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category Navigation Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profile Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Profile"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Profile" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Theme Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Theme"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Palette" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Theme" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Platforms Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Platforms"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Platforms" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Data Management Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Data"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Database" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Data Management" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Notifications Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Notifications"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bell" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Notifications" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Commands Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Commands"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CodeBraces" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Commands"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Viewer Hub Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="ViewerHub"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariant"
                                                         Width="20"
                                                         Height="20"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Viewer Hub"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Variables Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Variables"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Variable" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Variables" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Timers Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Timers"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Timers" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Automation Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Automation"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Automation" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- API & Webhooks Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="API"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Api" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="API &amp; Webhooks" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Performance Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Performance"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Speedometer" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Performance" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Security Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Security"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Security" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Security" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <!-- Advanced Category -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Advanced"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,10"
                                Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Advanced" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    CornerRadius="8">
                <Grid>
                    <!-- Main Settings Content (with ScrollViewer) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowPlatformGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="24">
                        
                        <!-- Status Message -->
                        <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="16,12"
                                Margin="0,0,0,16"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Profile Panel - Content will be added next -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Profile}">
                            
                            <!-- General Settings Section -->
                            <materialDesign:Card Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="General" 
                                               FontSize="20" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,16"/>

                                    <!-- Auto-Login Setting -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Login" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Skip profile selection and automatically login to the current profile" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding AutoLogin}"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      VerticalAlignment="Center"
                                                      Margin="16,0,0,0"/>
                                    </Grid>

                                    <Button Content="Save Settings"
                                            Command="{Binding SaveAutoLoginCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Support Links Section -->
                            <materialDesign:Card Padding="24" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Support Links"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Links opened by the Discord and Ideas &amp; Suggestions rows on the Home page"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>

                                    <TextBlock Text="Discord Invite URL"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DiscordInviteUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="https://discord.gg/your-invite"
                                             Margin="0,0,0,12"/>

                                    <TextBlock Text="Ideas &amp; Suggestions URL"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding IdeasUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="https://github.com/you/VyralBot/issues"
                                             Margin="0,0,0,16"/>

                                    <Button Content="Save Support Links"
                                            Command="{Binding SaveSupportLinksCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{DynamicResource PrimaryBrush}"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Profile Management Section -->
                            <materialDesign:Card Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Profile Management" 
                                               FontSize="20" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,16"/>

                                    <TextBlock Text="Current Profile:" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,8"/>
                                    
                                    <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CurrentProfile.DisplayName}" 
                                                           FontSize="16" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CurrentProfile.Name}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="1"
                                                    Command="{Binding ShowChangePinDialogForProfileCommand}"
                                                    CommandParameter="{Binding CurrentProfile}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Lock" 
                                                                             Width="16" 
                                                                             Height="16" 
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="Change PIN" 
                                                               Margin="4,0,0,0" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0"
                                                   Text="All Profiles:" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        
                                        <Button Grid.Column="1"
                                                Command="{Binding ShowCreateProfileDialogForSettingsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" 
                                                                         Width="16" 
                                                                         Height="16" 
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="New Profile" 
                                                           Margin="4,0,0,0" 
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Profiles List -->
                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="16,12"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DisplayName}" 
                                                                       FontSize="14" 
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Name}" 
                                                                       FontSize="11" 
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock FontSize="10" 
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,4,0,0">
                                                                <Run Text="Last used: "/>
                                                                <Run Text="{Binding LastUsedAt, StringFormat='MMM dd, yyyy'}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" 
                                                                    Orientation="Horizontal" 
                                                                    VerticalAlignment="Center">
                                                            <Button Command="{Binding DataContext.ShowSwitchProfileDialogForProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="SwapHorizontal" 
                                                                                             Width="16" 
                                                                                             Height="16" 
                                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Switch" 
                                                                               Margin="4,0,0,0" 
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            
                                                            <Button Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Padding="8,4"
                                                                    Margin="0,0,8,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Export" 
                                                                                             Width="16" 
                                                                                             Height="16" 
                                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Export" 
                                                                               Margin="4,0,0,0" 
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            
                                                            <Button Command="{Binding DataContext.RequestDeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                                    Padding="8,4"
                                                                    Foreground="{DynamicResource ErrorBrush}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Delete" 
                                                                                             Width="16" 
                                                                                             Height="16" 
                                                                                             VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Delete" 
                                                                               Margin="4,0,0,0" 
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                            
                        </StackPanel>

                        <!-- Theme Panel -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Theme}">
                            <TextBlock Text="Theme Settings"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,16"/>

                            <!-- Built-in Themes -->
                            <TextBlock Text="Built-in Themes" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Themes}" Margin="0,0,0,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Height="76" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1">
                                            <StackPanel Margin="12" Orientation="Horizontal">
                                                <!-- theme preview: background swatch + accent dot -->
                                                <Border Width="44" Height="44" CornerRadius="6"
                                                        BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding PreviewBackgroundHex,
                                                            Converter={StaticResource HexToColorConverter}}"/>
                                                    </Border.Background>
                                                    <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding AccentHex,
                                                                Converter={StaticResource HexToColorConverter}}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IsLight, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Light|Dark}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text=" · built-in" FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- selected indicator: visible when this item is the active theme -->
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource PrimaryBrush}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource ThemeEqualsConverter}">
                                                                            <Binding Path="Id"/>
                                                                            <Binding Path="DataContext.SelectedTheme.Id" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom Theme -->
                            <TextBlock Text="Custom Theme" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                                 UniformCornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Base:" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                        <RadioButton Content="Dark"
                                                     IsChecked="{Binding CustomIsLight, Converter={StaticResource InvertBooleanConverter}}"
                                                     GroupName="CustomBase" Margin="0,0,12,0"/>
                                        <RadioButton Content="Light" IsChecked="{Binding CustomIsLight}"
                                                     GroupName="CustomBase"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Accent color:" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                        <ItemsControl ItemsSource="{Binding CustomAccentSwatches}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Width="360"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectCustomAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Width="26" Height="26" Margin="2,0" Padding="0"
                                                            BorderThickness="1" BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                                            Style="{StaticResource MaterialDesignFlatButton}">
                                                        <Button.Background>
                                                            <SolidColorBrush Color="{Binding Converter={StaticResource HexToColorConverter}}"/>
                                                        </Button.Background>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <!-- Live accent picker: TwoWay-bound, updates the theme live while dragging -->
                                    <TextBlock Text="Pick accent color — updates live" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <controls:ColorPicker SelectedColor="{Binding CustomPrimaryHexPickerColor, Mode=TwoWay}"
                                                          HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Hex:" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding CustomPrimaryHex, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="110" VerticalAlignment="Center"
                                                 Style="{StaticResource MaterialDesignTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Logo color:" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding LogoVariants}" SelectedItem="{Binding CustomLogoVariant}" Width="120"/>
                                    </StackPanel>
                                    <Button Content="Apply Custom Theme" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding ApplyCustomThemeCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Brightness Levels -->
                            <TextBlock Text="Brightness Levels" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                                 UniformCornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="Slide to make the whole app darker or lighter — changes apply instantly."/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dark mode level" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100"
                                                TickFrequency="10" IsSnapToTickEnabled="False"
                                                SmallChange="5" LargeChange="20"
                                                VerticalAlignment="Center" Margin="12,0"
                                                Value="{Binding DarkShadeLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DarkShadeLevelText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Light mode level" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Slider Grid.Column="1" Minimum="-100" Maximum="100"
                                                TickFrequency="10" IsSnapToTickEnabled="False"
                                                SmallChange="5" LargeChange="20"
                                                VerticalAlignment="Center" Margin="12,0"
                                                Value="{Binding LightShadeLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LightShadeLevelText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Logo color note -->
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="Logo colors look for vyral-logo-{color}.png in Resources/Images (red, blue, green, white, black). Missing variants fall back to the native teal logo."/>
                        </StackPanel>

                        <!-- Platforms Panel -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Platforms}">
                            
                            <!-- Platform Selection Grid -->
                            <UniformGrid Rows="4"
                                         Columns="2"
                                         Margin="0,0,0,24"
                                         Visibility="{Binding ShowPlatformGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Twitch Platform Card -->
                                <Button Command="{Binding NavigateToTwitchSettingsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="0,0,8,8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="{Binding IsTwitchConnected}">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/twitch-logo.png" 
                                               Width="64" 
                                               Height="64" 
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="Twitch" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure Twitch integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTwitchConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- Kick Platform Card -->
                                <Button Command="{Binding NavigateToKickSettingsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="8,0,0,8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="{Binding IsKickConnected}">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/kick-logo.png" 
                                               Width="64" 
                                               Height="64" 
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="Kick" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure Kick integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKickConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- YouTube Platform Card -->
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="0,0,8,8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Configure YouTube chat in the Chat hub">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/youtube-logo.png"
                                               Width="64"
                                               Height="64"
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="YouTube" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure YouTube integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsYouTubeConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- TikTok Platform Card -->
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="8,0,0,8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="This platform is not available yet">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/tiktok-logo.png"
                                               Width="64"
                                               Height="64"
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="TikTok" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure TikTok integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTikTokConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- Discord Platform Card -->
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="This platform is not available yet">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/discord-logo.png"
                                               Width="64"
                                               Height="64"
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="Discord" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure Discord integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDiscordConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- OBS Platform Card -->
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="8,0,0,0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="This platform is not available yet">
                                    <StackPanel>
                                        <Image Source="/Resources/Images/obs-logo.png"
                                               Width="64"
                                               Height="64"
                                               Margin="0,0,0,12"/>
                                        <TextBlock Text="OBS" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Configure OBS integration"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOBSConnected}" Value="False">
                                                            <Setter Property="Text" Value="Not connected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>

                                <!-- Facebook Gaming Platform Card -->
                                <Button Command="{Binding SelectFacebookCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="0,8,8,0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Facebook"
                                                                 Width="64"
                                                                 Height="64"
                                                                 Margin="0,0,0,12"
                                                                 HorizontalAlignment="Center"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Facebook Gaming"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Configure Facebook integration"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Rumble Platform Card -->
                                <Button Command="{Binding SelectRumbleCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="140"
                                        Margin="8,8,0,0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="VideoOutline"
                                                                 Width="64"
                                                                 Height="64"
                                                                 Margin="0,0,0,12"
                                                                 HorizontalAlignment="Center"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Rumble"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Configure Rumble integration"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- Startup & Connection Behavior -->
                            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="Startup &amp; Connection"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Choose which platforms connect when the app launches, whether tokens refresh first, and connect or disconnect right now."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Content="Refresh Status"
                                                Command="{Binding PlatformStartupSettingsViewModel.RefreshStatusCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalAlignment="Right"
                                                Padding="12,4"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Launch VyralBot when the PC starts (Windows HKCU Run key) -->
                                    <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,8,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Launch VyralBot when my PC starts"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Start VyralBot automatically when you sign in to Windows"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding PlatformStartupSettingsViewModel.LaunchOnPcStart}"
                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Start VyralBot automatically when you sign in to Windows"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding PlatformStartupSettingsViewModel.Platforms}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="14"
                                                        Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding PlatformName}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    CornerRadius="10"
                                                                    Padding="10,3"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#339E9E9E"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Background" Value="#3310B981"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Auto-connect at startup -->
                                                            <StackPanel Grid.Column="0" Margin="0,0,12,8">
                                                                <TextBlock Text="Connect at startup"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <ToggleButton IsChecked="{Binding AutoConnectOnStartup}"
                                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                                                    <TextBlock Text="auto-connect on app launch"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Refresh tokens at startup -->
                                                            <StackPanel Grid.Column="1" Margin="0,0,12,8">
                                                                <TextBlock Text="Refresh tokens at startup"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <ToggleButton IsChecked="{Binding RefreshTokensOnStartup}"
                                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                                  IsEnabled="{Binding SupportsTokenRefresh}"/>
                                                                    <TextBlock Text="rotate tokens before connecting"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                                <Button Content="Connect"
                                                                        Command="{Binding ConnectCommand}"
                                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                                        Background="{DynamicResource PrimaryBrush}"
                                                                        Padding="12,4"
                                                                        Margin="0,0,8,0">
                                                                    <Button.Visibility>
                                                                        <Binding Path="IsConnected" Converter="{StaticResource InvertBooleanToVisibilityConverter}"/>
                                                                    </Button.Visibility>
                                                                </Button>
                                                                <Button Content="Disconnect"
                                                                        Command="{Binding DisconnectCommand}"
                                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                                        Padding="12,4"
                                                                        Margin="0,0,8,0"
                                                                        Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Button Content="Refresh Tokens"
                                                                        Command="{Binding RefreshTokensCommand}"
                                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                                        Padding="12,4"
                                                                        Visibility="{Binding SupportsTokenRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Discord bots -->
                                    <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Discord bots"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="Start every saved bot at app launch &#183; "/>
                                                    <Run Text="{Binding PlatformStartupSettingsViewModel.DiscordBotCount, Mode=OneWay}"/>
                                                    <Run Text=" saved"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1"
                                                          IsChecked="{Binding PlatformStartupSettingsViewModel.DiscordBotsAutoConnect}"
                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                          VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="The webhook server for Kick webhooks has its own auto-start switch in API &amp; Webhooks. First-time sign-in for a platform happens on the Connections page."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PlatformStartupSettingsViewModel.StatusMessage}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding PlatformStartupSettingsViewModel.StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Data Panel -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Data}">
                            <TextBlock Text="Data Management"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,16">
                                <Run Text="Everything VyralBot stores on disk for profile "/>
                                <Run Text="{Binding DataManagementViewModel.CurrentProfileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=", how much space it uses, and where it lives."/>
                            </TextBlock>

                            <!-- Storage Locations -->
                            <materialDesign:Card Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Storage Locations"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button Content="Refresh"
                                                Command="{Binding DataManagementViewModel.RefreshCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalAlignment="Right"
                                                Padding="12,4"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DataManagementViewModel.StorageLocations}">
                                        <ItemsControl.ItemTemplate>
