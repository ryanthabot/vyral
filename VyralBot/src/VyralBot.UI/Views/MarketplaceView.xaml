<UserControl x:Class="VyralBot.UI.Views.MarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels">

    <Grid Background="{DynamicResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== TOP BAR ============================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Store" Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="COMMAND MARKETPLACE"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         Margin="18,0,0,0"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         MaxWidth="420"
                         HorizontalAlignment="Left"
                         materialDesign:HintAssist.Hint="Search name, description, author, code…"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Button Grid.Column="2"
                        Command="{Binding ImportCodeCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        Height="34"
                        Margin="12,0,0,0"
                        ToolTip="Load a command from a pasted share code or offline code">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="14" Height="14"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="IMPORT CODE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Height="34"
                        Margin="8,0,0,0"
                        ToolTip="Reload the marketplace listing">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="REFRESH" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding ToggleSettingsCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Height="34"
                        Margin="8,0,0,0"
                        ToolTip="Marketplace connection settings">
                    <materialDesign:PackIcon Kind="Cog" Width="16" Height="16"/>
                </Button>

                <Button Grid.Column="5"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Height="34"
                        Margin="8,0,0,0"
                        Content="✕ CLOSE"
                        ToolTip="Close the marketplace"/>
            </Grid>
        </Border>

        <!-- ============================== SETTINGS PANEL ============================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <TextBlock Text="Marketplace connection (BotGhost relay + GitHub store)"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Sharing posts to your BotGhost webhook events, which commit to GitHub holding the write token. Browsing works without these keys; sharing and voting need them."
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="GitHub owner" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.GitHubOwner}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="GitHub repository" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.GitHubRepo}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Branch" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.Branch}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Share webhook URL (BotGhost event)" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,3"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.ShareWebhookUrl}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Rating webhook URL (BotGhost event)" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,3"/>
                    <TextBox Grid.Row="3" Grid.Column="2" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.RatingWebhookUrl}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="BotGhost API key" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,3"/>
                    <TextBox Grid.Row="3" Grid.Column="4" Height="34" Padding="8,0" VerticalContentAlignment="Center"
                             Text="{Binding Settings.ApiKey}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Width="120" Height="34"
                            Content="SAVE"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================== LISTING ============================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
            <StackPanel>
                <!-- Loading / empty states -->
                <TextBlock Text="Loading marketplace…"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Nothing here yet. Build a command in the flow editor and press SHARE to publish the first one."
                           FontSize="13.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,18">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15"
                                                             Foreground="{DynamicResource PrimaryBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Header}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Entries.Count, StringFormat=' ({0})'}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Sharecode, StringFormat='  ·  {0}'}"
                                                                       FontSize="11.5"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ByLine}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="620"
                                                                   HorizontalAlignment="Left"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.VoteUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                Height="30" Padding="6,0"
                                                                ToolTip="Thumbs up">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ThumbUpOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Up}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.VoteDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                Height="30" Padding="6,0"
                                                                ToolTip="Thumbs down">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ThumbDownOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Down}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.ImportEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Background="{DynamicResource PrimaryBrush}"
                                                                Foreground="White"
                                                                Height="30"
                                                                Margin="10,0,0,0"
                                                                Content="IMPORT"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== STATUS BAR ============================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
