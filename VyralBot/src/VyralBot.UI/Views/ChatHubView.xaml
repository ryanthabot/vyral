<UserControl x:Class="VyralBot.UI.Views.ChatHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:VyralBot.UI.Views"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             d:DataContext="{d:DesignInstance Type=vm:ChatHubViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Translucent red wash for the "not connected" warning callout
             (tracks the palette's canonical ErrorColor; FlowEditorView pattern). -->
        <SolidColorBrush x:Key="ErrorCalloutBrush" Color="{DynamicResource ErrorColor}" Opacity="0.1"/>

        <!-- Platform tab radio-button style -->
        <Style x:Key="PlatformTab" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent"
                                CornerRadius="8" Padding="16,10" Margin="0,0,4,0"
                                Cursor="Hand" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Event row style: label + toggle on same line -->
        <Style x:Key="EventToggleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <materialDesign:PackIcon Kind="ChatProcessing" Width="28" Height="28"
                                             Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Chat Management"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Moderator shortcut chip -->
                <Button Grid.Column="1"
                        Command="{Binding NavigateToModeratorCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        VerticalAlignment="Center"
                        ToolTip="Open the Moderator dashboard (mod channel, mod roles, action log, !mod builder)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAccount" Width="18" Height="18"
                                                 Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Moderator" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="Configure chat behavior, event notifications, and auto-replies for each platform"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,24"/>

            <!-- Platform Tabs -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PlatformTab}" GroupName="Platform"
                                 IsChecked="{Binding IsTwitchSelected, Mode=OneWay}"
                                 Command="{Binding SelectPlatformCommand}" CommandParameter="Twitch">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Images/twitch-logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Twitch" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PlatformTab}" GroupName="Platform"
                                 IsChecked="{Binding IsKickSelected, Mode=OneWay}"
                                 Command="{Binding SelectPlatformCommand}" CommandParameter="Kick">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Images/kick-logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Kick" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PlatformTab}" GroupName="Platform"
                                 IsChecked="{Binding IsYouTubeSelected, Mode=OneWay}"
                                 Command="{Binding SelectPlatformCommand}" CommandParameter="YouTube">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Images/youtube-logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="YouTube" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PlatformTab}" GroupName="Platform"
                                 IsChecked="{Binding IsTiktokSelected, Mode=OneWay}"
                                 Command="{Binding SelectPlatformCommand}" CommandParameter="TikTok">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Images/tiktok-logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="TikTok" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource PlatformTab}" GroupName="Platform"
                                 IsChecked="{Binding IsDiscordSelected, Mode=OneWay}"
                                 Command="{Binding SelectPlatformCommand}" CommandParameter="Discord">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/Images/discord-logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Discord" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Connection Status Bar -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="20,14" Margin="0,0,0,20"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} Chat Settings">
                                <Binding Path="SelectedPlatform"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Connection action result -->
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionActionMessage}"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="16,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionActionMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionActionMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Connect/Disconnect are hidden entirely when the platform isn't
                             manageable from here (TikTok): the commands would silently no-op. -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsCurrentPlatformManageable, Converter={StaticResource BoolToVis}}">
                            <Button Content="Connect"
                                    Command="{Binding ConnectCurrentPlatformCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsCurrentPlatformConnected, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectCurrentPlatformCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="12,4" Margin="0,0,8,0"
                                    Visibility="{Binding IsCurrentPlatformConnected, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Content="Refresh Tokens"
                                Command="{Binding RefreshCurrentPlatformTokensCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="12,4" Margin="0,0,12,0"
                                IsEnabled="{Binding CanRefreshCurrentPlatformTokens, Mode=OneWay}"/>
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPlatformConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Not Connected"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPlatformConnected}" Value="True">
                                            <Setter Property="Text" Value="Connected"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Not Connected Warning -->
            <Border Margin="0,0,0,20"
                    Background="{DynamicResource ErrorCalloutBrush}" CornerRadius="8" Padding="16"
                    Visibility="{Binding IsCurrentPlatformConnected, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20"
                                             Foreground="{DynamicResource ErrorBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <!-- For TikTok the generic advice is false — TikTok cannot be connected anywhere in this version. -->
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Connect this platform in Connections to manage chat settings"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentPlatformChatAvailable}" Value="False">
                                        <Setter Property="Text" Value="TikTok chat is not available in this version"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- TikTok coming-soon banner: truthful gate — no TikTok chat pipeline exists yet. -->
            <Border Margin="0,0,0,20"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentPlatformChatAvailable}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                             Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="TikTok chat integration is coming soon. VyralBot cannot read or send TikTok LIVE chat yet, so the settings below have no effect for TikTok."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Main Settings Content -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Setter Property="Opacity" Value="1.0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentPlatformConnected}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                            <!-- TikTok has no chat pipeline: settings would promise behavior that does not exist. -->
                            <DataTrigger Binding="{Binding IsCurrentPlatformChatAvailable}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- ══════════════════════════════════ -->
                    <!-- GENERAL SETTINGS CARD -->
                    <!-- ══════════════════════════════════ -->
                    <TextBlock Text="General" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="8" Padding="20" Margin="0,0,0,24"
                            BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Chat Enabled -->
                            <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Chat Enabled" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Show messages from this platform" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding CurrentPlatformSettings.IsChatEnabled, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Auto-Start -->
                            <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-Start Chat" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Connect on app launch" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding CurrentPlatformSettings.AutoStartChat, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Auto-Replies -->
                            <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-Replies" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Send automatic responses to events" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding CurrentPlatformSettings.AutoRepliesEnabled, Mode=TwoWay}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════ -->
                    <!-- TWITCH EVENT SETTINGS -->
                    <!-- ══════════════════════════════════ -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlatform}" Value="Twitch">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Event Notifications &amp; Auto-Replies" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="8" Padding="20" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- Follow -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Follow Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowFollowsInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.FollowAutoReplyEnabled, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <TextBox Text="{Binding TwitchSettings.FollowAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" TextWrapping="Wrap" IsEnabled="{Binding TwitchSettings.FollowAutoReplyEnabled}"
                                                 materialDesign:HintAssist.Hint="Auto-reply message"/>
                                        <TextBlock Text="Variables: {username}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Subscribe -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Subscribe Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowSubscribesInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.SubscribeAutoReplyEnabled, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <TextBox Text="{Binding TwitchSettings.SubscribeAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" TextWrapping="Wrap" IsEnabled="{Binding TwitchSettings.SubscribeAutoReplyEnabled}"
                                                 materialDesign:HintAssist.Hint="Auto-reply message"/>
                                        <TextBlock Text="Variables: {username}, {tier}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Resub -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Resub Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowResubsInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ResubAutoReplyEnabled, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <TextBox Text="{Binding TwitchSettings.ResubAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" TextWrapping="Wrap" IsEnabled="{Binding TwitchSettings.ResubAutoReplyEnabled}"
                                                 materialDesign:HintAssist.Hint="Auto-reply message"/>
                                        <TextBlock Text="Variables: {username}, {months}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Gift Sub -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Gift Sub Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowGiftSubsInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.GiftSubAutoReplyEnabled, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <TextBox Text="{Binding TwitchSettings.GiftSubAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" TextWrapping="Wrap" IsEnabled="{Binding TwitchSettings.GiftSubAutoReplyEnabled}"
                                                 materialDesign:HintAssist.Hint="Auto-reply message"/>
                                        <TextBlock Text="Variables: {gifter}, {count}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Raid -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Raid Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowRaidsInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.RaidAutoReplyEnabled, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <TextBox Text="{Binding TwitchSettings.RaidAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" TextWrapping="Wrap" IsEnabled="{Binding TwitchSettings.RaidAutoReplyEnabled}"
                                                 materialDesign:HintAssist.Hint="Auto-reply message"/>
                                        <TextBlock Text="Variables: {raider}, {viewers}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Cheer -->
                                <Expander Margin="0,0,0,6">
                                    <Expander.Header>
                                        <TextBlock Text="Cheer Events" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,8,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ToggleButton Grid.Column="1" IsChecked="{Binding TwitchSettings.ShowCheersInChat, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
