                            <TextBlock Text="✓ Manage channels" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="✓ Manage roles" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="✓ Manage webhooks" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="✓ View audit log" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="✓ Moderation" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="✓ Voice channels" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← BACK" Command="{Binding BackToPlatformSelectionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" Padding="24,0" VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="RECONNECT" Command="{Binding ReconnectDiscordCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource VyralRedBrush}" Margin="0,0,12,0" Height="40" Padding="24,0" VerticalContentAlignment="Center"/>
                            <Button Content="DISCONNECT" Command="{Binding DisconnectDiscordCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="40" Padding="24,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
