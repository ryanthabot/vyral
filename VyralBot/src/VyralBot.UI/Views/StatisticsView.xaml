<UserControl x:Class="VyralBot.UI.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:charts="clr-namespace:VyralBot.UI.Controls.Charts"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:RowIndexConverter x:Key="RowIndexConverter"/>
        <converters:NullToAllConverter x:Key="NullToAllConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Event Statistics" 
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}" 
                       Margin="0,0,0,5"/>
            <TextBlock Text="View analytics and leaderboards for chat events" 
                       Style="{StaticResource MaterialDesignBody2TextBlock}" 
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Start Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" Text="End Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" Margin="0,0,20,0"/>

                <TextBlock Grid.Column="4" Text="Platform:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="5" 
                          ItemsSource="{Binding AvailablePlatforms}" 
                          SelectedItem="{Binding SelectedPlatform}"
                          MinWidth="120"
                          Margin="0,0,20,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAllConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="Refresh" 
                            Command="{Binding RefreshCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Export CSV"
                            Command="{Binding ExportToCsvCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
                </Grid>

                <!-- Export status (success row count / failure reason) -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary Card -->
            <materialDesign:Card Grid.Row="0" Padding="20" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBox" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock Text="Total Events" 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock Text="{Binding TotalEvents}" 
                                   Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Tabs -->
            <TabControl Grid.Row="1" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                <!-- Sessions Tab (stream session summaries — the post-stream report) -->
                <TabItem Header="Sessions">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Last session card -->
                        <materialDesign:Card Grid.Row="0" Padding="20" Margin="0,0,0,15">
                          <Grid>
                            <!-- Populated state: duration, headline numbers, top-3 breakdown -->
                            <Grid Visibility="{Binding HasLastSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircle" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Last session" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                                            <TextBlock Text="{Binding LastSessionSummary.StartedLocalText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastSessionSummary.Platforms}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,15,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastSessionSummary.DurationText}"
                                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Headline numbers -->
                                <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="New followers" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.NewFollowers}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="New subs" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.NewSubs}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Raids" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.Raids}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Cheers" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.Cheers}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Chat messages" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.ChatMessages}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Currency awarded" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding LastSessionSummary.CurrencyAwarded}" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Top-3 breakdown: top chatters + top event types -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Top chatters" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding LastSessionSummary.TopChatters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14" Margin="0,2,0,0">
                                                        <Run Text="{Binding Username}" FontWeight="Bold"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding Messages}"/>
                                                        <Run Text=" messages"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Top events" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding LastSessionTopEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="14" Margin="0,2,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Empty state -->
                            <StackPanel Visibility="{Binding HasLastSession, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                        HorizontalAlignment="Center" Margin="0,10,0,10">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="No stream sessions yet" Style="{StaticResource MaterialDesignHeadline6TextBlock}" HorizontalAlignment="Center"/>
                                <TextBlock Text="A summary is compiled automatically when your stream ends (all platforms go offline)."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                          </Grid>
                        </materialDesign:Card>

                        <!-- Recent sessions list -->
                        <materialDesign:Card Grid.Row="1">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Recent sessions" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="5,5,0,10"/>
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding RecentSessions}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MinHeight="120"
                                          Visibility="{Binding HasRecentSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Started" Binding="{Binding StartedLocalText}" Width="170"/>
                                        <DataGridTextColumn Header="Platforms" Binding="{Binding Platforms}" Width="150"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90"/>
                                        <DataGridTextColumn Header="Headline numbers" Binding="{Binding HeadlineText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="1"
                                           Text="Sessions appear here after your first tracked stream ends."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasRecentSessions, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Event Counts Tab -->
                <TabItem Header="Event Counts">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Overview chart: top event types in the selected range -->
                        <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Events by type (selected range)"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Margin="0,0,0,10"/>
                                <charts:SimpleBarChart ItemsSource="{Binding EventTypeChartItems}"
                                                       LabelWidth="140"
                                                       EmptyText="No events in the selected range"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="1">
                            <DataGrid ItemsSource="{Binding EventCounts}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="150"/>
                                    <DataGridTextColumn Header="Event Type" Binding="{Binding EventType}" Width="200"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Top Contributors Tab -->
                <TabItem Header="Top Contributors">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Event Type Filter -->
                        <materialDesign:Card Grid.Row="0" Padding="15" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Event Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableEventTypes}"
                                          SelectedItem="{Binding SelectedEventType}"
                                          MinWidth="150"/>
                                <TextBlock Text="(Shows users with most contributions for selected event)"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Top contributors chart: top-8 bars for the selected event type -->
                        <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Top contributors (selected event type)"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Margin="0,0,0,10"/>
                                <charts:SimpleBarChart ItemsSource="{Binding ContributorChartItems}"
                                                       LabelWidth="140"
                                                       EmptyText="No contributors yet — pick a specific event type and refresh"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Top Contributors List -->
                        <materialDesign:Card Grid.Row="2">
                            <DataGrid ItemsSource="{Binding TopContributors}" 
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rank" Width="60">
                                        <DataGridTextColumn.Binding>
                                            <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                                     Converter="{StaticResource RowIndexConverter}"/>
                                        </DataGridTextColumn.Binding>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="200"/>
                                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValue}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <!-- Top Users Tab -->
                <TabItem Header="Top Users (All Events)">
                    <materialDesign:Card Margin="10">
                        <DataGrid ItemsSource="{Binding TopUsers}" 
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Margin="10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rank" Width="60">
                                    <DataGridTextColumn.Binding>
                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                                 Converter="{StaticResource RowIndexConverter}"/>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="250"/>
                                <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="120"/>
                                <DataGridTextColumn Header="Total Events" Binding="{Binding Count}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontSize" Value="16"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource OverlayBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="60"
                             Height="60"/>
                <TextBlock Text="Loading Statistics..." 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="18"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
