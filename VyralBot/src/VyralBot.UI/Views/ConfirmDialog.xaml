<Window x:Class="VyralBot.UI.Views.ConfirmDialog"
        Icon="/Resources/Images/vyral-logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm Navigation"
        Height="250"
        Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">
    
    <Border Background="{DynamicResource BackgroundDarkBrush}" 
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="20,16">
                <TextBlock Text="⚠️ Confirm Navigation" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
            
            <!-- Content -->
            <StackPanel Grid.Row="1" 
                        Margin="20"
                        VerticalAlignment="Center">
                <TextBlock x:Name="MessageText"
                           Text="You are in the middle of setting up Twitch."
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Going back to home will lose your progress."
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Do you want to continue?"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            
            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="NO"
                            Click="No_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Width="100"
                            Height="40"
                            Margin="0,0,12,0"/>
                    <Button Content="YES"
                            Click="Yes_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource ErrorBrush}"
                            Foreground="White"
                            Width="100"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
