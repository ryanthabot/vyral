<UserControl x:Class="VyralBot.UI.Views.AlertSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            
            <!-- Header -->
            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Visual Alerts Settings" 
                              Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Configure on-screen alerts for stream events"
                              Style="{StaticResource MaterialDesignBody2TextBlock}"
                              Foreground="{StaticResource MaterialDesignBodyLight}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- General Settings -->
            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="General Settings" 
                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                              Margin="0,0,0,15"/>

                    <!-- Enable Alerts -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable Visual Alerts"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Show on-screen popups for stream events"
                                      FontSize="12"
                                      Foreground="{StaticResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                        
                        <ToggleButton Grid.Column="1"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding AlertsEnabled}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Alert Duration -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Alert Duration (seconds)"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Slider Grid.Column="0"
                                   Value="{Binding AlertDuration}"
                                   Minimum="1"
                                   Maximum="15"
                                   TickFrequency="1"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,20,0"/>
                            
                            <TextBlock Grid.Column="1"
                                      Text="{Binding AlertDuration, StringFormat='{}{0}s'}"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      MinWidth="40"/>
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Animation Style -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Animation Style"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding Animations}"
                                 SelectedItem="{Binding SelectedAnimation}"
                                 materialDesign:HintAssist.Hint="Select animation"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Position -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Screen Position"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding Positions}"
                                 SelectedItem="{Binding SelectedPosition}"
                                 materialDesign:HintAssist.Hint="Select position"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Live preview of duration/animation/position (no save needed) -->
                    <Button Content="Preview Current Settings"
                           Command="{Binding TestAlertCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Left"
                           Padding="30,10"/>

                    <TextBlock Text="Preview shows the duration, animation and position selected above — changes apply to the preview immediately, before saving."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,8,0,0"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Event Type Toggles -->
            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Alert Events" 
                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                              Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Choose which events should trigger visual alerts"
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,15"/>

                    <!-- Follow Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="New Followers" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="follow"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowFollowAlerts}"/>
                    </Grid>

                    <!-- Subscribe Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="New Subscribers" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="subscribe"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowSubscribeAlerts}"/>
                    </Grid>

                    <!-- Gift Sub Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Gifted Subscriptions" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="giftsub"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowGiftSubAlerts}"/>
                    </Grid>

                    <!-- Raid Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Raids" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="raid"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowRaidAlerts}"/>
                    </Grid>

                    <!-- Host Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Hosts" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="host"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowHostAlerts}"/>
                    </Grid>

                    <!-- Cheer Alerts -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Bits/Cheers" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="TEST"
                                Command="{Binding TestEventAlertCommand}"
                                CommandParameter="cheer"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11"
                                Padding="15,4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="2"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding ShowCheerAlerts}"/>
                    </Grid>

                    <!-- Spoken alerts (TTS) — gated additionally by the TTS master
                         switch on the Text-to-Speech card below -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Speak Alerts (TTS)" VerticalAlignment="Center"/>
                            <TextBlock Text="Say &quot;{event}, {username}&quot; aloud after the popup shows"
                                      FontSize="12"
                                      Foreground="{StaticResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding SpeakAlertTts}"/>
                    </Grid>

                    <!-- Per-event test feedback (suppression explanations) -->
                    <TextBlock Text="{Binding StatusMessage}"
                              FontSize="12"
                              Foreground="{DynamicResource PrimaryBrush}"
                              Margin="0,5,0,0"
                              TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Separator Margin="0,15,0,15"/>

                    <!-- Scope notes: what this page does NOT control -->
                    <TextBlock Text="Notes"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="• Each TEST fires the alert with the exact title the live event uses (e.g. &quot;Bits!&quot;), so the popup matches what viewers see on stream. If the row's toggle is off, the preview is suppressed and explained above."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,5"
                              TextWrapping="Wrap"/>
                    <TextBlock Text="• Alert text is fixed per event (title + username + detail). {variables} like {username} are not substituted in alert text — they apply to commands, auto-replies and chat responses."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,5"
                              TextWrapping="Wrap"/>
                    <TextBlock Text="• Per-event sounds and per-event volumes are configured on the Sounds page, not here."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,5"
                              TextWrapping="Wrap"/>
                    <TextBlock Text="• Kicks gifting (&quot;Kicks Gifted!&quot;) and reward redemptions (&quot;Reward Redeemed!&quot;) always show alerts while visual alerts are enabled — they have no per-event toggle."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,0"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Text-to-Speech (TTS) Settings -->
            <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Text-to-Speech (TTS)"
                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                              Margin="0,0,0,15"/>

                    <TextBlock Text="Speaks text aloud through the Windows voices (SAPI): the !tts chat command and spoken event alerts. Do-not-disturb (Settings → Notifications) mutes TTS too."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,0,0,15"
                              TextWrapping="Wrap"/>

                    <!-- Enable TTS -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable Text-to-Speech"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="Off by default — when enabled, !tts works in chat and alerts can speak"
                                      FontSize="12"
                                      Foreground="{StaticResource MaterialDesignBodyLight}"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding TtsEnabled}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Voice -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Voice"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding TtsVoices}"
                                 SelectedItem="{Binding SelectedTtsVoice}"
                                 materialDesign:HintAssist.Hint="Installed Windows voice"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Rate -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Speaking Rate"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                   Value="{Binding TtsRatePercent}"
                                   Minimum="-50"
                                   Maximum="50"
                                   TickFrequency="5"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="{Binding TtsRatePercent, StringFormat='{}{0}%'}"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      MinWidth="40"/>
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Volume -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Volume"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                   Value="{Binding TtsVolumePercent}"
                                   Minimum="0"
                                   Maximum="100"
                                   TickFrequency="5"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="{Binding TtsVolumePercent, StringFormat='{}{0}%'}"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      MinWidth="40"/>
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Allow Viewers -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Allow Viewers (!tts)"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,5"/>
                            <TextBlock Text="When off, only moderators can use !tts (mods always skip the 30s per-user cooldown)"
                                      FontSize="12"
                                      Foreground="{StaticResource MaterialDesignBodyLight}"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1"
                                     Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                     IsChecked="{Binding TtsAllowViewers}"
                                     VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,10,0,15"/>

                    <!-- Max message length -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Max Message Length (characters)"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                   Value="{Binding TtsMaxLength}"
                                   Minimum="50"
                                   Maximum="500"
                                   TickFrequency="10"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,20,0"/>

                            <TextBlock Grid.Column="1"
                                      Text="{Binding TtsMaxLength, StringFormat='{}{0}'}"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      MinWidth="40"/>
                        </Grid>
                    </StackPanel>

                    <Button Content="Save &amp; Speak Test"
                           Command="{Binding TestTtsCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Left"
                           Padding="30,10"/>

                    <!-- TTS test feedback -->
                    <TextBlock Text="{Binding TtsStatusMessage}"
                              FontSize="12"
                              Foreground="{DynamicResource PrimaryBrush}"
                              Margin="0,8,0,0"
                              TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TtsStatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="The test saves the TTS settings on this page first, then speaks a sample sentence with the selected voice, rate and volume."
                              FontSize="12"
                              Foreground="{StaticResource MaterialDesignBodyLight}"
                              Margin="0,8,0,0"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to Defaults"
                       Command="{Binding ResetToDefaultsCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Margin="0,0,10,0"
                       Padding="20,10"/>
                
                <Button Content="Save Settings"
                       Command="{Binding SaveSettingsCommand}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Background="{DynamicResource SuccessBrush}"
                       Padding="30,10"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
