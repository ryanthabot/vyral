<UserControl x:Class="VyralBot.UI.Views.WebServerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:local="clr-namespace:VyralBot.UI.Views">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="0">
        <!-- Ngrok Settings/Setup View (shown when ShowNgrokSettings = true) -->
        <Grid Visibility="{Binding ShowNgrokSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Back button header -->
                <RowDefinition Height="*"/>     <!-- Content area -->
            </Grid.RowDefinitions>
            
            <!-- Header with Back Button -->
            <Border Grid.Row="0" 
                   Background="{StaticResource CardBackgroundBrush}"
                   Padding="24,16"
                   Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                           Content="← BACK"
                           Command="{Binding CloseNgrokSettingsCommand}"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           Height="36"
                           Padding="16,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1" 
                             Text="Ngrok Configuration"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0"/>
                </Grid>
            </Border>
            
            <!-- Content: Wizard or Settings -->
            <Grid Grid.Row="1">

                
                <!-- Ngrok Settings (shown when setup is complete) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!-- Ngrok Settings Content -->
                        <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Authentication Token" 
                                         FontSize="18" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,0,16"/>
                                
                                <TextBox Text="{Binding NgrokAuthToken, UpdateSourceTrigger=PropertyChanged}"
                                        materialDesign:HintAssist.Hint="Ngrok auth token"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        FontFamily="Consolas"
                                        Margin="0,0,0,24"/>

                                <TextBlock Text="Region" 
                                         FontSize="18" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,0,16"/>
                                
                                <ComboBox SelectedItem="{Binding NgrokRegion}"
                                         Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                         Margin="0,0,0,8">
                                    <ComboBoxItem Content="us" IsSelected="True"/>
                                    <ComboBoxItem Content="eu"/>
                                    <ComboBoxItem Content="ap"/>
                                    <ComboBoxItem Content="au"/>
                                    <ComboBoxItem Content="sa"/>
                                    <ComboBoxItem Content="jp"/>
                                    <ComboBoxItem Content="in"/>
                                </ComboBox>
                                <TextBlock Text="Closest server region for best latency"
                                         FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Save Button -->
                        <Button Content="SAVE SETTINGS"
                               Command="{Binding SaveCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="{DynamicResource PrimaryBrush}"
                               Foreground="White"
                               Height="40"
                               Padding="32,0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        
        <!-- Main API & Webhooks Overview (shown when ShowNgrokSettings = false) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding ShowNgrokSettings, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <StackPanel Margin="24">
                <!-- Header -->
                <TextBlock Text="API &amp; Webhooks" 
                         FontSize="32"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,0,0,8"/>
                <TextBlock Text="Configure external integrations and webhook delivery" 
                         FontSize="14"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Margin="0,0,0,32"/>

                <!-- Ngrok Card -->
                <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <materialDesign:PackIcon Kind="TunnelOutline" 
                                                Width="48" Height="48"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,24,0"/>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ngrok Tunnel" 
                                     FontSize="20" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap"
                                     FontSize="14"
                                     Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Configure ngrok to receive webhooks from external platforms"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSetupComplete}" Value="False">
                                                <Setter Property="Text" Value="Setup required - Configure ngrok to enable webhook delivery"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Button -->
                        <Button Grid.Column="2" 
                               Height="40"
                               Padding="24,0"
                               VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Command" Value="{Binding OpenNgrokConfigCommand}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSetupComplete}" Value="False">
                                            <Setter Property="Command" Value="{Binding RunSetupWizardCommand}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Cog"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSetupComplete}" Value="False">
                                                        <Setter Property="Kind" Value="WizardHat"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="CONFIGURE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSetupComplete}" Value="False">
                                                        <Setter Property="Text" Value="RUN SETUP"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </materialDesign:Card>

                <!-- Webhook Server Status Card -->
                <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Title and Status Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                     Text="Webhook Server" 
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"/>
                            
                            <!-- Status Indicator -->
                            <Border Grid.Column="1"
                                    Width="12"
                                    Height="12"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            
                            <!-- Start/Stop Buttons -->
                            <Button Grid.Column="2"
                                    Content="START"
                                    Command="{Binding StartCommand}"
                                    Background="{DynamicResource SuccessBrush}"
                                    Height="36"
                                    Padding="24,0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Grid.Column="3"
                                    Content="STOP"
                                    Command="{Binding StopCommand}"
                                    BorderBrush="{DynamicResource ErrorBrush}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Height="36"
                                    Padding="24,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        
                        <!-- Status Text and URL -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Status}" 
                                     FontSize="14"
                                     FontWeight="Medium"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PublicUrl}" 
                                     FontSize="12"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     TextWrapping="Wrap"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <!-- Public URL Actions -->
                        <StackPanel Grid.Row="2" 
                                   Orientation="Horizontal"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="COPY URL"
                                    Command="{Binding CopyPublicUrlCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"/>
                            <Button Content="TEST HEALTH"
                                    Command="{Binding OpenPublicUrlCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="32"
                                    Padding="12,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Server Configuration Card -->
                <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Server Configuration" 
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,24"/>
                        
                        <!-- Enable Toggle -->
                        <!-- Auto-start Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <ToggleButton IsChecked="{Binding AutoStartOnLaunch}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0"/>
                            <StackPanel>
                                <TextBlock Text="Auto-start on Launch"
                                         FontSize="14"
                                         FontWeight="Medium"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Start server when application launches"
                                         FontSize="12"
                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Port Configuration -->
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Local Port"
                               FontSize="14"
                               Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="Port for local web server (default: 5000)"
                                 FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- About Webhooks -->
                <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="About Webhook Infrastructure" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                 FontSize="14"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Margin="0,0,0,8">
                            <Run Text="VyralBot embeds a web server to receive webhooks:"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="• Embedded Kestrel server (~15-30 MB RAM)"/>
                            <LineBreak/>
                            <Run Text="• Ngrok tunnel for public URL"/>
                            <LineBreak/>
                            <Run Text="• Automatic reconnection when URL changes"/>
                            <LineBreak/>
                            <Run Text="• RSA signature validation for security"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="Free ngrok generates new URLs on restart. The system automatically updates webhook subscriptions without user intervention."/>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
