<UserControl x:Class="VyralBot.UI.Views.DiscordChatSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    <Border Background="{DynamicResource CardBackgroundBrush}" Padding="10" CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
            <StackPanel Width="280">
                <TextBlock Text="Discord — Chat Quick Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Show messages" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Show Discord messages in the unified chat" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsChatEnabled, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0"/>
                </Grid>

                <!-- Display preferences (same keys as the Chat Hub Display Options) -->
                <Separator Margin="0,8"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                    <CheckBox Content="Show Badges" FontSize="12" IsChecked="{Binding ShowBadges, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Show Timestamps" FontSize="12" IsChecked="{Binding ShowTimestamps, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <CheckBox Content="Compact Mode" FontSize="12" IsChecked="{Binding CompactMode, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Member Join Events -->
                <Separator Margin="0,8"/>
                <Expander Header="🎉 Member Join Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowMemberJoinsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding MemberJoinAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding MemberJoinAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding MemberJoinAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {guild}" FontSize="10"
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Server Boost Events -->
                <Expander Header="🚀 Server Boost Events" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Show in chat" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowBoostsInChat, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-reply" FontSize="12" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding BoostAutoReplyEnabled, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                        </Grid>

                        <TextBox Text="{Binding BoostAutoReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"
                                materialDesign:HintAssist.Hint="Message template"
                                IsEnabled="{Binding BoostAutoReplyEnabled}"/>
                        <TextBlock Text="Variables: {username}, {guild}" FontSize="10"
                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

                <!-- Save Button -->
                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryBrush}"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch"/>

                <!-- Status Message -->
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"
                          HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
