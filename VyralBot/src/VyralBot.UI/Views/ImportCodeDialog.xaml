<Window x:Class="VyralBot.UI.Views.ImportCodeDialog"
        Icon="/Resources/Images/vyral-logo.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Import Command Code"
        Height="360"
        Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="20,16">
                <TextBlock Text="⬇️ Import Command Code"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,18">
                <TextBlock Text="Paste a marketplace share code (VYRAL-…), an offline share code (VYRAL1-…), or a marketplace link."
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>
                <TextBox x:Name="CodeBox"
                         Height="110"
                         Padding="8,6"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="CANCEL"
                            Click="Cancel_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Width="100"
                            Height="40"
                            Margin="0,0,12,0"/>
                    <Button Content="IMPORT"
                            Click="Import_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Width="120"
                            Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
