<UserControl x:Class="VyralBot.UI.Views.NgrokSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             Background="{StaticResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToIconConverter x:Key="BoolToIconConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Stepper Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Step Navigation Header -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,24">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSuccess}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Ngrok Setup Wizard" 
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,0,0,24"/>
                
                <!-- Stepper -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Install -->
                    <Button Grid.Column="0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInstallCheck}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Install" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInstallCheck}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 1 -->
                    <Rectangle Grid.Column="1" 
                             Width="40" 
                             Height="2" 
                             Fill="{StaticResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 2: Authentication -->
                    <Button Grid.Column="2"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAuthSetup}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Authenticate" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowAuthSetup}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 2 -->
                    <Rectangle Grid.Column="3" 
                             Width="40" 
                             Height="2" 
                             Fill="{StaticResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 3: Test -->
                    <Button Grid.Column="4"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTesting}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Complete" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTesting}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                
                <!-- Welcome Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800"
                           Visibility="{Binding ShowWelcome, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="TunnelOutline" 
                                            Width="100" Height="100"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,32"/>

                    <TextBlock Text="Welcome to Ngrok Setup"
                              FontSize="32" FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16"/>

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="16" Margin="0,0,0,32">
                        This wizard will help you configure ngrok tunneling to receive webhooks from Kick and other platforms.
                    </TextBlock>

                    <materialDesign:Card Padding="32" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="What is Ngrok?" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="24">
                                Ngrok creates a secure tunnel from the internet to your local machine, allowing platforms like Kick to send webhook events to VyralBot. This enables real-time chat message reception and other event notifications.
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <Button Content="START SETUP"
                           Command="{Binding StartSetupCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Height="48" FontSize="16"/>
                </StackPanel>

                <!-- Install Check Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800"
                           Visibility="{Binding ShowInstallCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Download" 
                                            Width="80" Height="80"
                                            Foreground="{StaticResource PrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,24"/>

                    <TextBlock Text="Step 1: Install Ngrok"
                              FontSize="28" FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,32"/>

                    <materialDesign:Card Padding="20" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="{Binding IsNgrokInstalled, Converter={StaticResource BoolToIconConverter}, ConverterParameter='CheckCircle|AlertCircle'}"
                                                        Width="24" Height="24"
                                                        Foreground="{Binding IsNgrokInstalled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Success|Warning'}"
                                                        Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding StatusMessage, FallbackValue='Checking installation...'}"
                                          FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="DOWNLOAD FROM MICROSOFT STORE"
                               Command="{Binding OpenMicrosoftStoreCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Height="48" FontSize="14" Margin="0,0,0,16"/>

                        <Button Grid.Column="2" Content="CHECK INSTALLATION"
                               Command="{Binding CheckInstallationCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Height="48" FontSize="14" Margin="0,0,0,16"/>
                    </Grid>
                </StackPanel>

                <!-- Authentication Screen with WebView2 -->
                <Grid Visibility="{Binding ShowAuthSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Instructions Header -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="32,24"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Step 2: Get Your Authentication Token"
                                      FontSize="20" FontWeight="SemiBold"
                                      Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" 
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="14" Margin="0,0,0,16">
                                Sign in to your ngrok account below and copy your authentication token. If you don't have an account, you can create one for free.
                            </TextBlock>
                            <Button Content="OPEN NGROK DASHBOARD"
                                   Command="{Binding OpenNgrokDashboardCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Height="40"
                                   HorizontalAlignment="Left"
                                   Padding="24,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- WebView2 Browser -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource BackgroundDarkBrush}"
                            MinHeight="400">
                        <wv2:WebView2 x:Name="WebView2Browser"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"/>
                    </Border>
                </Grid>

                <!-- Testing Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800"
                           Visibility="{Binding ShowTesting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="{Binding TestPassed, Converter={StaticResource BoolToIconConverter}, ConverterParameter='CheckCircle|ClockOutline'}" 
                                            Width="80" Height="80"
                                            Foreground="{Binding TestPassed, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Success|Primary'}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,24"/>

                    <TextBlock Text="Testing Connection"
                              FontSize="28" FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,32"/>

                    <materialDesign:Card Padding="24" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage, FallbackValue='Preparing test...'}"
                                      FontSize="16" FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,16"/>

                            <ProgressBar IsIndeterminate="True"
                                        Height="4"
                                        Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,0,0,16"/>

                            <TextBlock Text="{Binding PublicUrl}"
                                      FontFamily="Consolas"
                                      FontSize="14"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource PrimaryBrush}"
                                      Visibility="{Binding PublicUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- Success Screen -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800"
                           Visibility="{Binding ShowSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="CheckCircle" 
                                            Width="100" Height="100"
                                            Foreground="{StaticResource SuccessBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,32"/>

                    <TextBlock Text="Setup Complete!"
                              FontSize="32" FontWeight="Bold"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource SuccessBrush}"
                              Margin="0,0,0,16"/>

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="16" Margin="0,0,0,32">
                        Ngrok has been successfully configured. You can now enable the webhook server to receive events.
                    </TextBlock>

                    <Button Content="FINISH"
                           Command="{Binding FinishSetupCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Height="48" FontSize="16"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Action Bar (Auth Step) -->
            <Border Grid.Row="2" 
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="32,24"
                    Visibility="{Binding ShowAuthSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Token Input -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Enter your ngrok auth token:"
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Margin="0,0,0,8"/>
                        
                        <TextBox Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Paste your ngrok auth token here"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontFamily="Consolas"
                                Height="48"
                                Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Status Messages -->
                    <StackPanel Grid.Row="1">
                        <Border Background="#1AF44336"
                               CornerRadius="8" Padding="16" Margin="0,0,0,8"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20" 
                                                        Foreground="{StaticResource ErrorBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" 
                                          Foreground="{StaticResource ErrorBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1A4CAF50"
                               CornerRadius="8" Padding="16" Margin="0,0,0,16"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" 
                                                        Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" 
                                          Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="BACK"
                               Command="{Binding BackToInstallCheckCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Width="120" Height="40" Margin="0,0,12,0"/>

                        <Button Content="AUTHENTICATE"
                               Command="{Binding AuthenticateNgrokCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Width="160" Height="40"
                               IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Action Bar (Install Step) -->
            <Border Grid.Row="2" 
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="32,24"
                    Visibility="{Binding ShowInstallCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="BACK"
                           Command="{Binding BackToWelcomeCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Width="120" Height="40" Margin="0,0,12,0"/>

                    <Button Content="CONTINUE"
                           Command="{Binding NextToAuthCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Width="160" Height="40"
                           IsEnabled="{Binding IsNgrokInstalled}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
