<UserControl x:Class="VyralBot.UI.Views.DiscordBotDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:localControls="clr-namespace:VyralBot.UI.Views.Controls"
             Background="{DynamicResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
        <vm:BotCommandToggleLabelConverter x:Key="BotCommandToggleLabelConverter"/>

        <!-- Plain raised button template: deterministic hit area, no adorner-layer ripple -->
        <Style x:Key="VyralPlainDiscordButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DiscordBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain outline button: transparent with a hairline border -->
        <Style x:Key="VyralPlainOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain danger button: red, for stop -->
        <Style x:Key="VyralPlainDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root: dashboard content + full-size visual-command-builder overlay -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Bot header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Margin="0,0,0,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← BACK TO BOTS"
                            Command="{Binding DataContext.NavigateToDiscordBotsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"/>
                    <materialDesign:PackIcon Kind="Robot"
                                             Width="18"
                                             Height="18"
                                             Foreground="{DynamicResource DiscordBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding BotName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource ErrorRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dashboard body: same layout as the single-bot Discord dashboard -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="300" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Servers -->
            <materialDesign:Card Grid.Column="0"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BackgroundDarkBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountGroup"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource DiscordBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Discord Servers"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Refresh servers and connection status"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    HorizontalAlignment="Right">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Servers List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Guilds list -->
                            <ItemsControl ItemsSource="{Binding Guilds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderColorBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,12">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MemberCountText}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Channel picker row (hidden when the bot sees no text channels) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChannels}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ComboBox Width="220"
                                                              ItemsSource="{Binding Channels}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedChannelId, Mode=TwoWay}"
                                                              materialDesign:HintAssist.Hint="Text channel"
                                                              VerticalAlignment="Center"/>

                                                    <Button Content="SET ACTIVE CHANNEL"
                                                            Command="{Binding DataContext.SetChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Height="34"
                                                            FontSize="11"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="No text channels visible to the bot"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChannels}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGuilds}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="AccountPlus"
                                                         Width="48"
                                                         Height="48"
                                                         Foreground="{DynamicResource TextMutedBrush}"
                                                         HorizontalAlignment="Center"
                                                         Margin="0,0,0,12"/>
                                <TextBlock Text="No servers yet"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Invite this bot to a server using its invite link, then refresh"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="12,0,12,16"/>
                                <Button Content="OPEN INVITE LINK"
                                        Command="{Binding OpenInviteLinkCommand}"
                                        Style="{StaticResource VyralPlainDiscordButton}"
                                        Height="44"
                                        IsEnabled="{Binding InviteUrlAvailable}"
                                        ToolTip="Requires the bot token saved for this bot"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Right Column: Connection Status + Test Message + Commands -->
            <Grid Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                <!-- Connection Status Card -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Connection"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorRedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessGreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Text="This is one of the Discord bot accounts Vyral runs — it listens for commands and posts messages in its servers."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="START"
                                        Command="{Binding StartCommand}"
                                        Style="{StaticResource VyralPlainDiscordButton}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                                        Margin="0,0,12,0"/>

                                <Button Content="STOP"
                                        Command="{Binding StopCommand}"
                                        Style="{StaticResource VyralPlainDangerButton}"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                                        Margin="0,0,12,0"/>

                                <Button Content="RECONNECT"
                                        Command="{Binding ReconnectCommand}"
                                        Style="{StaticResource VyralPlainOutlineButton}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"/>
                            </StackPanel>

                            <Button Content="REFRESH"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource VyralPlainOutlineButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Identity (auto-detected) Card -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountCircle"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource DiscordBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Identity (auto-detected)"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <StackPanel Orientation="Horizontal">
                                <!-- Avatar: small detected image, robot icon when never connected -->
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        Background="{DynamicResource BackgroundDarkBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding DetectedAvatarUrl}"
                                               Width="42"
                                               Height="42"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <materialDesign:PackIcon Kind="Robot"
                                                                 Width="24"
                                                                 Height="24"
                                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding HasAvatar, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Read-only detected fields (nothing to type) -->
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Application ID:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Width="110"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectedApplicationId}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DetectedApplicationId}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Bot Username:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Width="110"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetectedBotUsername}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DetectedBotUsername}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Detected automatically when this bot connects — nothing to type."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Bot roles Card: single-select per role, Primary bot handles the rest -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountGroup"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource DiscordBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Bot roles"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <CheckBox Content="Account linking bot (handles link DMs)"
                                      IsChecked="{Binding IsLinkingBot, Mode=TwoWay}"
                                      Command="{Binding ToggleLinkingRoleCommand}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="Only one bot answers link and delink DMs — checking this clears the role from any other bot."
                                      Margin="0,0,0,8"/>

                            <CheckBox Content="Giveaway announcements bot"
                                      IsChecked="{Binding IsGiveawayBot, Mode=TwoWay}"
                                      Command="{Binding ToggleGiveawayRoleCommand}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="Only one bot posts giveaway announcements — checking this clears the role from any other bot."
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Leave both unchecked to use your Primary bot for everything."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Startup Card: per-bot "start at app launch" flag -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Rocket"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource DiscordBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Startup"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <CheckBox Content="Start this bot when the app launches"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                      Command="{Binding ToggleAutoStartCommand}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="When enabled, Vyral starts this bot automatically the next time the app launches."/>

                            <TextBlock Text="Turn this off to keep the bot saved but stopped until you start it yourself."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Welcome & Auto-Role Card: per-bot welcome message + role grant on member join -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HandWave"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource DiscordBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Welcome &amp; Auto-Role"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <CheckBox Content="Welcome new members and grant a role when they join"
                                      IsChecked="{Binding WelcomeEnabled, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="When enabled, this bot posts the welcome message and grants the auto-role to every member joining its first server."/>

                            <TextBlock Text="Welcome message"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,4"/>

                            <!-- Inherits the app-wide variable-picker context menu -->
                            <TextBox Text="{Binding WelcomeMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Welcome to {server}, {user}! 🎉"
                                     AcceptsReturn="False"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Top"/>

                            <TextBlock Text="Variables: {user} mentions the joining member, {username} is their plain name, {server} is the server name — right-click the box for the variable picker."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>

                            <TextBlock Text="Welcome channel"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,4"/>
                            <ComboBox ItemsSource="{Binding WelcomeChannels}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding WelcomeChannelId, Mode=TwoWay}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Channel for the welcome message"
                                      IsEnabled="{Binding HasWelcomeOptions}"/>

                            <TextBlock Text="Auto-role on join"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,4"/>
                            <ComboBox ItemsSource="{Binding WelcomeRoles}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding WelcomeRoleId, Mode=TwoWay}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Role granted to new members"
                                      IsEnabled="{Binding HasWelcomeOptions}"/>

                            <TextBlock Text="Channel and role come from this bot's first server — the bot needs Manage Roles for the auto-role. Pick '(no welcome channel)' or '(no auto-role)' to turn that half off. Join events require the Server Members Intent in the Discord Developer Portal."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <!-- Offline hint (pickers need a connected bot) -->
                            <TextBlock Text="Start the bot and join it to a server to pick a channel and role."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWelcomeOptions}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="SAVE WELCOME SETTINGS"
                                    Command="{Binding SaveWelcomeSettingsCommand}"
                                    Style="{StaticResource VyralPlainDiscordButton}"
                                    Height="40"
                                    Margin="0,12,0,0"/>

                            <TextBlock Text="{Binding WelcomeStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Test Message Card -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Test Message"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">
                            <Button Content="SEND TEST MESSAGE"
                                    Command="{Binding SendTestMessageCommand}"
                                    Style="{StaticResource VyralPlainDiscordButton}"
                                    Height="44"
                                    Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding TestMessageStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="The active channel is where this bot listens for commands and sends its messages — pick one next to a server in the list on the left."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Commands Card: built-in moderation commands + this bot's custom commands -->
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}"
                                     Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Terminal"
                                                             Width="18"
                                                             Height="18"
                                                             Foreground="{DynamicResource DiscordBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Commands"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="EDIT COMMANDS"
                                        Command="{Binding DataContext.NavigateToCommandsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="Manage commands in the Visual Builder"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="16">

                            <!-- Visual command builder entry point -->
                            <Button Content="🎨 VISUAL COMMAND BUILDER"
                                    Click="OnVisualCommandBuilderClick"
                                    Style="{StaticResource VyralPlainDiscordButton}"
                                    Height="40"
                                    Margin="0,0,0,16"
                                    ToolTip="Create a new command flow in the Visual Builder"/>

                            <!-- Section A: built-in moderation commands (read-only) -->
                            <TextBlock Text="Built-in moderation commands"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding BuiltInModCommands}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Width="96"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Top"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Usage}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Content="EDIT"
                                                    Click="OnBuiltInCommandEditClick"
                                                    Style="{StaticResource VyralPlainOutlineButton}"
                                                    Height="26"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    VerticalAlignment="Top"
                                                    ToolTip="Edit in Visual Builder"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Usable in Discord with ! by moderators, or from the app chat with /."
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- Section B: custom commands for this bot -->
                            <TextBlock Text="Custom commands for this bot"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,16,0,0"/>
                            <TextBlock Text="Commands pinned to this bot plus the ones marked 'all bots', which every bot runs."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>

                            <ItemsControl ItemsSource="{Binding BotCommands}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderColorBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,0,0,8"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource BackgroundDarkBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Scope}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToStatusConverter}}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ResponsePreview}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="EDIT"
                                                            Click="OnBotCommandEditClick"
                                                            Style="{StaticResource VyralPlainOutlineButton}"
                                                            Height="30"
                                                            Padding="14,0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Edit in Visual Builder"/>
                                                    <Button Content="{Binding IsEnabled, Converter={StaticResource BotCommandToggleLabelConverter}}"
                                                            Command="{Binding DataContext.ToggleBotCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource VyralPlainOutlineButton}"
                                                            Height="30"
                                                            Padding="14,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Enable or disable this command"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state (only once commands have loaded) -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CommandsLoaded}" Value="True"/>
                                                    <Condition Binding="{Binding HasCustomCommands}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                           <TextBlock Text="No custom commands for this bot yet — build one in the Visual Builder and scope it to this bot."
                                                       FontSize="11"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Content="MANAGE IN COMMAND BUILDER"
                                    Command="{Binding DataContext.NavigateToCommandsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource VyralPlainOutlineButton}"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Manage commands in the Visual Builder (Chat Features → Commands)"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                    <!-- Integrations: external bot services + conflict detection -->
                    <localControls:DiscordBotIntegrationsCard Margin="0,12,0,0" VerticalAlignment="Top"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        </Grid>

        <!-- ============================================================
             VISUAL COMMAND BUILDER overlay: full-size FlowEditorView host
             (collapsed until the button opens it)
             ============================================================ -->
        <Border x:Name="FlowEditorOverlay"
                Grid.Row="0"
                Panel.ZIndex="100"
                Background="{DynamicResource BackgroundDarkBrush}"
                Visibility="Collapsed">
            <ContentControl x:Name="FlowEditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
