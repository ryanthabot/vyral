<UserControl x:Class="VyralBot.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:views="clr-namespace:VyralBot.UI.Views"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:behaviors="clr-namespace:VyralBot.UI.Behaviors"
             xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
             Background="{DynamicResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters:BadgesToImagesConverter x:Key="BadgesToImagesConverter"/>
        <converters:PlatformToImageConverter x:Key="PlatformToImageConverter"/>
        <converters:PlatformToBrushConverter x:Key="PlatformToBrushConverter"/>
        <!-- Platform Logo Style -->
        <Style x:Key="PlatformLogoStyle" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Platform}" Value="Twitch">
                    <Setter Property="Source" Value="/Resources/Images/twitch-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Kick">
                    <Setter Property="Source" Value="/Resources/Images/kick-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="YouTube">
                    <Setter Property="Source" Value="/Resources/Images/youtube-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="TikTok">
                    <Setter Property="Source" Value="/Resources/Images/tiktok-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Discord">
                    <Setter Property="Source" Value="/Resources/Images/discord-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Vyral">
                    <Setter Property="Source" Value="{DynamicResource AppLogoSource}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Margin="0,0,0,8">
            <Grid>
                <!-- Platform Filter Buttons (Left Side) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- All Platforms Button (Always Visible) -->
                    <Button x:Name="AllPlatformsSettingsButton"
                            Command="{Binding ToggleAllPlatformsSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="All Platforms Quick Actions"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="{DynamicResource AppLogoSource}" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- All Platforms quick-actions popup (PrimaryHue outline) -->
                    <Popup IsOpen="{Binding IsAllPlatformsSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=AllPlatformsSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource PrimaryHueMidBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="All Platforms Actions" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8"/>
                                
                                <!-- Quick Action Buttons -->
                                <Button Content="Start Giveaway"
                                        Command="{Binding StartGiveawayCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Start Poll"
                                        Command="{Binding StartPollCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Send Announcement"
                                        Command="{Binding SendAnnouncementCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Trigger Event"
                                        Command="{Binding TriggerEventCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                        <!-- Twitch Button -->
                        <Button x:Name="TwitchSettingsButton"
                            Visibility="{Binding IsTwitchConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleTwitchSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Twitch Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/twitch-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Twitch quick-settings popup (1px Twitch outline) -->
                    <Popup IsOpen="{Binding IsTwitchSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TwitchSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TwitchBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <controls:LazyPopupContent ContentType="{x:Type views:TwitchChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- Kick Button -->
                        <Button x:Name="KickSettingsButton"
                            Visibility="{Binding IsKickConfigured, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleKickSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Kick Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/kick-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Popup for Kick quick-settings (replaces ContextMenu for reliable display) -->
                    <Popup IsOpen="{Binding IsKickSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=KickSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource KickBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <controls:LazyPopupContent ContentType="{x:Type views:KickChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- YouTube Button -->
                        <Button x:Name="YoutubeSettingsButton"
                            Visibility="{Binding IsYoutubeConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleYoutubeSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="YouTube Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/youtube-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- YouTube quick-settings popup (1px YouTube outline) -->
                    <Popup IsOpen="{Binding IsYoutubeSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=YoutubeSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource YouTubeBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <controls:LazyPopupContent ContentType="{x:Type views:YoutubeChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- TikTok Button -->
                        <Button x:Name="TiktokSettingsButton"
                            Visibility="{Binding IsTiktokConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleTiktokSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="TikTok Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/tiktok-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- TikTok quick-settings popup (1px TikTok outline) -->
                    <Popup IsOpen="{Binding IsTiktokSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TiktokSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TikTokBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <controls:LazyPopupContent ContentType="{x:Type views:TiktokChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- Discord Button -->
                        <Button x:Name="DiscordSettingsButton"
                            Visibility="{Binding IsDiscordConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleDiscordSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Discord Settings"
                            Width="36"
                            Height="36">
                        <Image Source="/Resources/Images/discord-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Discord quick-settings popup (1px Discord outline) -->
                    <Popup IsOpen="{Binding IsDiscordSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=DiscordSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DiscordBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <controls:LazyPopupContent ContentType="{x:Type views:DiscordChatSettingsView}"/>
                        </Border>
                    </Popup>
                </StackPanel>
                
                <!-- Utility Buttons (Right Side) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- DM feed toggles: DMs reveals the Direct Messages feed;
                         Combined shows chat and DMs side by side (enabling it
                         forces the DM panel on — see ChatViewModel). -->
                    <ToggleButton IsChecked="{Binding ShowDmPanel, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="Show DMs sent to the bot"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chat" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="DMs" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding CombinedView, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="Show chat and DMs side by side"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SelectAll" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Combined" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Command="{Binding ToggleAutoScrollCommand}"
                          IsChecked="{Binding AutoScroll, Mode=OneWay}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Toggle Auto-Scroll"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ArrowCollapseDown" Width="18" Height="18"/>
                    </ToggleButton>
                    
                    <Button Command="{Binding LoadHistoryCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Load Chat History (200 messages)"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"/>
                    </Button>
                    
                    <Button Command="{Binding ClearChatCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Clear Chat (UI only)"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Eraser" Width="18" Height="18"/>
                    </Button>
                    
                    <Button Command="{Binding ClearHistoryCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Delete Chat History from Database"
                          Width="32"
                          Height="32">
                        <materialDesign:PackIcon Kind="DatabaseRemove" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Message area: chat on the LEFT and the DM feed on the RIGHT when
             CombinedView is on; the DM feed alone takes the full area when only
             ShowDmPanel is on; otherwise the plain single-column chat (all three
             columns are fixed *, the containers span/position themselves via
             style triggers below, so "both off" renders exactly as before). -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chat (spans the whole row except in combined mode; hidden only
                 when the DM panel shows on its own) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CombinedView}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DmOnlyView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- "Chat" header: combined mode only, so the classic
                             single-column view stays pixel-identical -->
                        <TextBlock Grid.Row="0"
                                   Text="Chat"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="14,10,0,0"
                                   Visibility="{Binding CombinedView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Grid Grid.Row="1">
            <ListBox x:Name="ChatScrollViewer"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Item"
                     VirtualizingStackPanel.CacheLength="5,5"
                     VirtualizingStackPanel.CacheLengthUnit="Item">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4"
                                  Margin="0,2"
                                  Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="0"
                                             Text="{Binding Timestamp, StringFormat='h:mm tt'}"
                                             FontSize="10"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                                    
                                    <!-- Platform Logo + Badges + Username -->
                                    <StackPanel Grid.Column="1" 
                                              Orientation="Horizontal"
                                              Margin="0,0,8,0">
                                        <!-- Platform Logo -->
                                        <Image Style="{StaticResource PlatformLogoStyle}"
                                               Margin="0,0,6,0"/>
                                        
                                        <!-- Badges - using Twitch badge images for both platforms -->
                                        <ItemsControl ItemsSource="{Binding BadgeImages}" Margin="0,0,4,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Width="18" Height="18" 
                                                           Margin="0,0,2,0" 
                                                           VerticalAlignment="Center"
                                                           Source="{Binding Image}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Stretch="Uniform"
                                                           ToolTip="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Username (clickable — opens the viewer profile window) -->
                                        <Button Command="{Binding DataContext.OpenViewerProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              Cursor="Hand"
                                              ToolTip="View viewer profile"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="{Binding Username}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Color}"
                                                   VerticalAlignment="Center"/>
                                        </Button>
                                        
                                        <TextBlock Text=":" 
                                                 FontSize="13"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="2,0,0,0"/>
                                    </StackPanel>

                                    
                                    
                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                             Text="{Binding Message}"
                                             FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                <!-- New messages banner shown when user scrolled up and new messages arrive -->
                <Button x:Name="NewMessagesButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        Padding="8,4"
                        Background="{DynamicResource TwitchBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="NewMessagesButton_Click">
                    New messages
                </Button>
            </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Thin separator between chat and DM feed (combined mode only) -->
            <Border Grid.Column="1"
                    Width="1"
                    Margin="8,0"
                    Background="{DynamicResource BorderLightBrush}"
                    Visibility="{Binding CombinedView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- DM inbox: full area on its own (ShowDmPanel only), right half in
                 combined mode. Shows the conversation list (inbox) or, when a
                 conversation is open, its thread + reply bar. The thread
                 auto-scrolls via the DmScrollTarget selection anchor (ListBox
                 brings its selected item into view). -->
            <Grid Visibility="{Binding ShowDmPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CombinedView}" Value="True">
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Inbox header: shown while NO conversation is open -->
                        <Grid Grid.Row="0"
                              Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Direct Messages"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="14,10,0,6"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                            <Button Command="{Binding LoadAllDmHistoryCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Load every saved DM conversation with full history" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="History" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Load all history" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ClearAllDmHistoryCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Delete ALL saved DM history">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource ErrorRedBrush}"/>
                                                    <TextBlock Text="Clear all" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                <!-- New DM: expands the inline user-ID input below;
                                     StartDmByUserIdCommand opens a replyable conversation
                                     (ChannelId + BotId set) and selects its thread. -->
                                <Button Command="{Binding ToggleNewDmInputCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Start a new DM by Discord user ID" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="New DM" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Inline New DM input + validation/API status -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="0,0,8,6"
                                        Visibility="{Binding IsNewDmInputOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Text="{Binding NewDmUserId, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Discord user ID (17-20 digits)"
                                             Width="220"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             Margin="0,0,4,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding StartDmByUserIdCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Command="{Binding StartDmByUserIdCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            ToolTip="Open DM">
                                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding NewDmStatus}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ErrorRedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,4,0"
                                           Visibility="{Binding NewDmStatus, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thread header: back button + username + history controls
                             (shown while a conversation IS open) -->
                        <Grid Grid.Row="0"
                              Margin="6,6,10,6"
                              Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding BackToDmInboxCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    ToolTip="All conversations">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="{Binding SelectedDmConversation.Username}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedDmConversation.Platform}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding LoadDmHistoryCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    ToolTip="Reload this conversation's full saved history">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18"/>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ClearDmHistoryCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    ToolTip="Delete this conversation's saved DM history">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                        <!-- Inbox list: one row per DM conversation (username bold,
                             muted single-line preview, short time right-aligned,
                             unread badge when > 0). Clicking a row opens the thread
                             (SelectedItem binds TwoWay to SelectedDmConversation). -->
                        <ListBox x:Name="DmConversationsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding DmConversations}"
                                 SelectedItem="{Binding SelectedDmConversation, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7"
                                            Margin="0,1"
                                            CornerRadius="4"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Platform logo -->
                                            <Image Grid.Column="0"
                                                   Style="{StaticResource PlatformLogoStyle}"
                                                   Margin="0,0,10,0"/>

                                            <!-- Username + last-message preview -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPreview}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Time + unread badge -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="8,0,0,0">
                                                <TextBlock Text="{Binding LastAtText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <Border CornerRadius="8"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        Padding="5,1"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Thread view: the open conversation's messages. Same
                             message layout as before (muted background + hairline
                             border). Auto-scrolls via the DmScrollTarget selection
                             anchor (ListBox brings its selected item into view). -->
                        <ListBox x:Name="DmThreadList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding SelectedDmConversation.Messages}"
                                 SelectedItem="{Binding DmScrollTarget, Mode=TwoWay}"
                                 Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item"
                                 VirtualizingStackPanel.CacheLength="5,5"
                                 VirtualizingStackPanel.CacheLengthUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <!-- Same message layout as the main chat, with a
                                     muted background and hairline border to mark
                                     DM entries (DynamicResource brushes only).
                                     Messages the BOT sent carry Username = bot
                                     username, so replies read like the main feed. -->
                                <DataTemplate>
                                    <Border Padding="8,4"
                                          Margin="0,2"
                                          Background="{DynamicResource CardHoverBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"
                                          BorderThickness="0,0,0,1"
                                          CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="0"
                                                     Text="{Binding TimestampDisplay}"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>

                                            <!-- Platform Logo + Badges + Username -->
                                            <StackPanel Grid.Column="1"
                                                      Orientation="Horizontal"
                                                      Margin="0,0,8,0">
                                                <Image Style="{StaticResource PlatformLogoStyle}"
                                                       Margin="0,0,6,0"/>

                                                <ItemsControl ItemsSource="{Binding BadgeImages}" Margin="0,0,4,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Width="18" Height="18"
                                                                   Margin="0,0,2,0"
                                                                   VerticalAlignment="Center"
                                                                   Source="{Binding Image}"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Stretch="Uniform"
                                                                   ToolTip="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Username (clickable — opens the viewer profile window) -->
                                                <Button Command="{Binding DataContext.OpenViewerProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      Cursor="Hand"
                                                      ToolTip="View viewer profile"
                                                      VerticalAlignment="Center"
                                                      Margin="4,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding Username}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Color}"
                                                           VerticalAlignment="Center"/>
                                                </Button>

                                                <TextBlock Text=":"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <!-- Message -->
                                            <TextBlock Grid.Column="2"
                                                     Text="{Binding Message}"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- Message Input -->
        <materialDesign:Card Grid.Row="2" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Platform Selector Button -->
                <Button Grid.Column="0"
                      Command="{Binding TogglePlatformSelectorCommand}"
                      Style="{StaticResource MaterialDesignIconButton}"
                      Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      ToolTip="Select Platform">
                    <Grid>
                        <!-- Platform Icon -->
                        <Image Width="24" Height="24" 
                               Source="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToImageConverter}}"/>
                        
                        <!-- Platform Selector Popup -->
                        <Popup IsOpen="{Binding IsPlatformSelectorOpen}"
                               StaysOpen="True"
                               Placement="Top"
                               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Button}}">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <ItemsControl ItemsSource="{Binding ConnectedPlatforms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectPlatformCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Height="40"
                                                    Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="20" Height="20" VerticalAlignment="Center"
                                                           Source="{Binding Name, Converter={StaticResource PlatformToImageConverter}}"/>
                                                    <TextBlock Text="{Binding Name}" 
                                                             Margin="8,0,0,0" 
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Button>
                
                <TextBox Grid.Column="1"
                       Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <!-- Unified reply box: the placeholder switches while a DM
                                 thread is open (the hint must only be set here — a local
                                 attribute value would override the trigger). -->
                            <Setter Property="materialDesign:HintAssist.Hint" Value="Send a message..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="materialDesign:HintAssist.Hint" Value="Reply as Vyral Bot (DM)..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                      Command="{Binding SendMessageCommand}"
                      Height="36"
                      Padding="24,0"
                      BorderBrush="{StaticResource PrimaryHueMidBrush}"
                      BorderThickness="0">
                    <!-- Platform brand background + readable Foreground (Facebook's
                         white needs dark-blue text — converter "foreground" param).
                         DM reply mode swaps the background for a Discord-blue → red
                         diagonal gradient. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background" Value="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToBrushConverter}}"/>
                            <Setter Property="Foreground" Value="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToBrushConverter}, ConverterParameter=foreground}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#5865F2" Offset="0"/>
                                                <GradientStop Color="#FF0000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Send"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                        <TextBlock Text="SEND"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Send to All Platforms Button -->
                <Border Grid.Column="3"
                        BorderBrush="{StaticResource PrimaryHueMidBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="8,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Hidden in DM reply mode so a DM draft cannot be
                                 broadcast to every platform. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SendToAllPlatformsCommand}"
                          Height="36"
                          Width="36"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Send to all connected platforms">
                        <Image Source="{DynamicResource AppLogoSource}" 
                               Width="20" 
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
