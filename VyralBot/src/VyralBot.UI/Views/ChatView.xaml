<UserControl x:Class="VyralBot.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:views="clr-namespace:VyralBot.UI.Views"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:behaviors="clr-namespace:VyralBot.UI.Behaviors"
             xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
             Background="{DynamicResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <!-- DM reply-mode send button gradient: Discord blue → theme red, both
             tracking the active palette via their canonical color keys (same
             pattern as FlowEditorView's local themed brushes). -->
        <LinearGradientBrush x:Key="DmReplyGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource DiscordColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource ErrorColor}" Offset="1"/>
        </LinearGradientBrush>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters:BadgesToImagesConverter x:Key="BadgesToImagesConverter"/>
        <converters:PlatformToImageConverter x:Key="PlatformToImageConverter"/>
        <converters:PlatformToBrushConverter x:Key="PlatformToBrushConverter"/>
        <!-- Platform Logo Style -->
        <Style x:Key="PlatformLogoStyle" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Platform}" Value="Twitch">
                    <Setter Property="Source" Value="/Resources/Images/twitch-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Kick">
                    <Setter Property="Source" Value="/Resources/Images/kick-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="YouTube">
                    <Setter Property="Source" Value="/Resources/Images/youtube-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="TikTok">
                    <Setter Property="Source" Value="/Resources/Images/tiktok-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Discord">
                    <Setter Property="Source" Value="/Resources/Images/discord-logo.png"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Platform}" Value="Vyral">
                    <Setter Property="Source" Value="{DynamicResource AppLogoSource}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Margin="0,0,0,8">
            <Grid>
                <!-- Platform Filter Buttons (Left Side) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- All Platforms Button (Always Visible) -->
                    <Button x:Name="AllPlatformsSettingsButton"
                            Command="{Binding ToggleAllPlatformsSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="All Platforms Quick Actions"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="{DynamicResource AppLogoSource}" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- All Platforms quick-actions popup (PrimaryHue outline) -->
                    <Popup IsOpen="{Binding IsAllPlatformsSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=AllPlatformsSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource PrimaryHueMidBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="All Platforms Actions" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,8"/>
                                
                                <!-- Quick Action Buttons -->
                                <Button Content="Start Giveaway"
                                        Command="{Binding StartGiveawayCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Start Poll"
                                        Command="{Binding StartPollCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Send Announcement"
                                        Command="{Binding SendAnnouncementCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4"/>

                                <Button Content="Trigger Event"
                                        Command="{Binding TriggerEventCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                        <!-- Twitch Button -->
                        <Button x:Name="TwitchSettingsButton"
                            Visibility="{Binding IsTwitchConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleTwitchSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Twitch Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/twitch-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Twitch quick-settings popup (1px Twitch outline) -->
                    <Popup IsOpen="{Binding IsTwitchSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TwitchSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TwitchBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <controls:LazyPopupContent ContentType="{x:Type views:TwitchChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- Kick Button -->
                        <Button x:Name="KickSettingsButton"
                            Visibility="{Binding IsKickConfigured, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleKickSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Kick Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/kick-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Popup for Kick quick-settings (replaces ContextMenu for reliable display) -->
                    <Popup IsOpen="{Binding IsKickSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=KickSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource KickBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <controls:LazyPopupContent ContentType="{x:Type views:KickChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- YouTube Button -->
                        <Button x:Name="YoutubeSettingsButton"
                            Visibility="{Binding IsYoutubeConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleYoutubeSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="YouTube Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/youtube-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- YouTube quick-settings popup (1px YouTube outline) -->
                    <Popup IsOpen="{Binding IsYoutubeSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=YoutubeSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource YouTubeBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <controls:LazyPopupContent ContentType="{x:Type views:YoutubeChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- TikTok Button -->
                        <Button x:Name="TiktokSettingsButton"
                            Visibility="{Binding IsTiktokConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleTiktokSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="TikTok Settings"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0">
                        <Image Source="/Resources/Images/tiktok-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- TikTok quick-settings popup (1px TikTok outline) -->
                    <Popup IsOpen="{Binding IsTiktokSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=TiktokSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource TikTokBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <controls:LazyPopupContent ContentType="{x:Type views:TiktokChatSettingsView}"/>
                        </Border>
                    </Popup>
                    
                        <!-- Discord Button -->
                        <Button x:Name="DiscordSettingsButton"
                            Visibility="{Binding IsDiscordConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding ToggleDiscordSettingsCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Discord Settings"
                            Width="36"
                            Height="36">
                        <Image Source="/Resources/Images/discord-logo.png" 
                               Width="20" 
                               Height="20"/>
                    </Button>

                    <!-- Discord quick-settings popup (1px Discord outline) -->
                    <Popup IsOpen="{Binding IsDiscordSettingsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=DiscordSettingsButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                Padding="8"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DiscordBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <controls:LazyPopupContent ContentType="{x:Type views:DiscordChatSettingsView}"/>
                        </Border>
                    </Popup>
                </StackPanel>
                
                <!-- Utility Buttons (Right Side) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- DM feed toggles: DMs reveals the Direct Messages feed;
                         Combined shows chat and DMs side by side (enabling it
                         forces the DM panel on — see ChatViewModel). -->
                    <ToggleButton IsChecked="{Binding ShowDmPanel, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="Show DMs sent to the bot"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chat" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="DMs" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding CombinedView, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="Show chat and DMs side by side"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SelectAll" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Combined" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Connected Channels: reveals the channel registry panel
                         (mutually exclusive with the DM panel — see ChatViewModel). -->
                    <ToggleButton IsChecked="{Binding ShowChannelsPanel, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignIconButton}"
                                  ToolTip="Connected channels the bot monitors"
                                  Height="32"
                                  Margin="0,0,8,0"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccessPoint" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Channels" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Chat appearance: font size +/- (clamped 8-36) and a
                         timestamp toggle; persisted via Chat.Appearance config -->
                    <Button Command="{Binding DecreaseChatFontSizeCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Decrease chat font size"
                          AutomationProperties.Name="Decrease chat font size"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="FormatFontSizeDecrease" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding IncreaseChatFontSizeCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Increase chat font size"
                          AutomationProperties.Name="Increase chat font size"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="FormatFontSizeIncrease" Width="18" Height="18"/>
                    </Button>

                    <ToggleButton IsChecked="{Binding ShowTimestamps, Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Toggle timestamps"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18"/>
                    </ToggleButton>

                    <ToggleButton Command="{Binding ToggleAutoScrollCommand}"
                          IsChecked="{Binding AutoScroll, Mode=OneWay}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Toggle Auto-Scroll"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ArrowCollapseDown" Width="18" Height="18"/>
                    </ToggleButton>
                    
                    <Button Command="{Binding LoadHistoryCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Load Chat History (200 messages)"
                          AutomationProperties.Name="Load chat history"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18"/>
                    </Button>
                    
                    <Button Command="{Binding ClearChatCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Clear Chat (UI only)"
                          AutomationProperties.Name="Clear chat"
                          Width="32"
                          Height="32"
                          Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Eraser" Width="18" Height="18"/>
                    </Button>
                    
                    <Button Command="{Binding ClearHistoryCommand}"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Delete Chat History from Database"
                          AutomationProperties.Name="Delete chat history"
                          Width="32"
                          Height="32">
                        <materialDesign:PackIcon Kind="DatabaseRemove" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Message area: chat on the LEFT and the DM feed on the RIGHT when
             CombinedView is on; the DM feed alone takes the full area when only
             ShowDmPanel is on; otherwise the plain single-column chat (all three
             columns are fixed *, the containers span/position themselves via
             style triggers below, so "both off" renders exactly as before). -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chat (spans the whole row except in combined mode; hidden only
                 when the DM panel shows on its own) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CombinedView}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DmOnlyView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowChannelsPanel}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- "Chat" header: combined mode only, so the classic
                             single-column view stays pixel-identical -->
                        <TextBlock Grid.Row="0"
                                   Text="Chat"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="14,10,0,0"
                                   Visibility="{Binding CombinedView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Grid Grid.Row="1">
            <ListBox x:Name="ChatScrollViewer"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Item"
                     VirtualizingStackPanel.CacheLength="5,5"
                     VirtualizingStackPanel.CacheLengthUnit="Item">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4"
                                  Margin="0,2"
                                  Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Timestamp (visibility follows the ShowTimestamps header toggle) -->
                                    <TextBlock Grid.Column="0"
                                             Text="{Binding Timestamp, StringFormat='h:mm tt'}"
                                             FontSize="10"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Visibility="{Binding DataContext.ShowTimestamps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    
                                    <!-- Platform Logo + Badges + Username -->
                                    <StackPanel Grid.Column="1" 
                                              Orientation="Horizontal"
                                              Margin="0,0,8,0">
                                        <!-- Platform Logo -->
                                        <Image Style="{StaticResource PlatformLogoStyle}"
                                               Margin="0,0,6,0"/>
                                        
                                        <!-- Badges - using Twitch badge images for both platforms -->
                                        <ItemsControl ItemsSource="{Binding BadgeImages}" Margin="0,0,4,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Width="18" Height="18" 
                                                           Margin="0,0,2,0" 
                                                           VerticalAlignment="Center"
                                                           Source="{Binding Image}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Stretch="Uniform"
                                                           ToolTip="{Binding Name}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Username (clickable — opens the viewer profile window) -->
                                        <Button Command="{Binding DataContext.OpenViewerProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              Cursor="Hand"
                                              ToolTip="View viewer profile"
                                              VerticalAlignment="Center"
                                              Margin="4,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="{Binding Username}"
                                                   FontSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Color}"
                                                   VerticalAlignment="Center"/>
                                        </Button>
                                        
                                        <TextBlock Text=":"
                                                 FontSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="2,0,0,0"/>
                                    </StackPanel>

                                    
                                    
                                    <!-- Message -->
                                    <TextBlock Grid.Column="2"
                                             Text="{Binding Message}"
                                             FontSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

                <!-- Empty state: shown while the message list is empty
                     (ObservableCollection raises Count changes on
                     add/remove/clear, so the trigger stays live) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="380"
                            Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="ChatOutline"
                                             Width="48"
                                             Height="48"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,12"/>
                    <TextBlock Text="Connect a platform to start chatting"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Link Twitch, Kick, YouTube or Discord on the Platforms page — chat messages appear here live."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- New messages banner shown when user scrolled up and new messages arrive -->
                <Button x:Name="NewMessagesButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        Padding="8,4"
                        Background="{DynamicResource TwitchBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="NewMessagesButton_Click">
                    New messages
                </Button>
            </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Thin separator between chat and DM feed (combined mode only) -->
            <Border Grid.Column="1"
                    Width="1"
                    Margin="8,0"
                    Background="{DynamicResource BorderLightBrush}"
                    Visibility="{Binding CombinedView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Channels-panel gate: the DM panel below binds Visibility
                 directly to ShowDmPanel (a local value a style trigger cannot
                 override), so this plain wrapper collapses the whole DM feed
                 while the Connected Channels panel is open. -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowChannelsPanel}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            <!-- DM inbox: full area on its own (ShowDmPanel only), right half in
                 combined mode. Shows the conversation list (inbox) or, when a
                 conversation is open, its thread + reply bar. The thread
                 auto-scrolls via the DmScrollTarget selection anchor (ListBox
                 brings its selected item into view). -->
            <Grid Visibility="{Binding ShowDmPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CombinedView}" Value="True">
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Inbox header: shown while NO conversation is open -->
                        <Grid Grid.Row="0"
                              Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Direct Messages"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="14,10,0,6"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                            <Button Command="{Binding LoadAllDmHistoryCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Load every saved DM conversation with full history" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="History" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Load all history" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ClearAllDmHistoryCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Delete ALL saved DM history">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource ErrorRedBrush}"/>
                                                    <TextBlock Text="Clear all" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                <!-- New DM: expands the inline user-ID input below;
                                     StartDmByUserIdCommand opens a replyable conversation
                                     (ChannelId + BotId set) and selects its thread. -->
                                <Button Command="{Binding ToggleNewDmInputCommand}" Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Start a new DM by Discord user ID" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="New DM" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Inline New DM input + validation/API status -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Margin="0,0,8,6"
                                        Visibility="{Binding IsNewDmInputOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBox Text="{Binding NewDmUserId, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Discord user ID (17-20 digits)"
                                             Width="220"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             Margin="0,0,4,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding StartDmByUserIdCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Command="{Binding StartDmByUserIdCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            ToolTip="Open DM"
                                            AutomationProperties.Name="Open DM">
                                        <materialDesign:PackIcon Kind="Check" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding NewDmStatus}"
                                           FontSize="11"
                                           Foreground="{DynamicResource ErrorRedBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,4,0"
                                           Visibility="{Binding NewDmStatus, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                            <!-- DM search: filters the inbox by username, Discord
                                 user id or message content (saved-history search)
                                 while non-empty; clearing restores the inbox. -->
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,0,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding DmSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Search users, IDs, keywords…"
                                         FontSize="12"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Thread header: back button + username + history controls
                             (shown while a conversation IS open) -->
                        <Grid Grid.Row="0"
                              Margin="6,6,10,6"
                              Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding BackToDmInboxCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    ToolTip="All conversations"
                                    AutomationProperties.Name="All conversations">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Text="{Binding SelectedDmConversation.Username}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <!-- Shows "(Discord • <user id>)" once the participant's
                                     Discord user id is known, else the platform name. -->
                                <TextBlock Text="{Binding SelectedDmConversation.HeaderDetail}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding LoadDmHistoryCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    ToolTip="Reload this conversation's full saved history"
                                    AutomationProperties.Name="Reload conversation history">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18"/>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ClearDmHistoryCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    ToolTip="Delete this conversation's saved DM history"
                                    AutomationProperties.Name="Delete conversation history">
                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                        <!-- Inbox list: one row per DM conversation (username bold,
                             muted single-line preview, short time right-aligned,
                             unread badge when > 0). Clicking a row opens the thread
                             (SelectedItem binds TwoWay to SelectedDmConversation).
                             Shares the thread's grid cell, so it hides while a
                             thread is open too (ShowDmInboxList) — otherwise it
                             bleeds through the transparent thread background. -->
                        <ListBox x:Name="DmConversationsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding DmConversations}"
                                 SelectedItem="{Binding SelectedDmConversation, Mode=TwoWay}"
                                 Visibility="{Binding ShowDmInboxList, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7"
                                            Margin="0,1"
                                            CornerRadius="4"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Platform logo -->
                                            <Image Grid.Column="0"
                                                   Style="{StaticResource PlatformLogoStyle}"
                                                   Margin="0,0,10,0"/>

                                            <!-- Username + last-message preview -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}"
                                                ToolTip="{Binding Username}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPreview}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Time + unread badge -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="8,0,0,0">
                                                <TextBlock Text="{Binding LastAtText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <Border CornerRadius="8"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        Padding="5,1"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- DM search results: replaces the conversation list while
                             a query is active. Each row is a lightweight hit
                             (username + matched snippet + time); clicking one opens
                             that conversation (full history loads) and clears the
                             search so the normal inbox returns. -->
                        <ListBox x:Name="DmSearchResultsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding DmSearchResults}"
                                 Visibility="{Binding IsDmSearching, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Click anywhere on the row to open the hit's conversation. -->
                                    <Border Padding="10,7"
                                            Margin="0,1"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenDmSearchResultCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Platform logo -->
                                            <Image Grid.Column="0"
                                                   Style="{StaticResource PlatformLogoStyle}"
                                                   Margin="0,0,10,0"/>

                                            <!-- Username + matched snippet -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}"
                                                ToolTip="{Binding Username}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Snippet}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Message time -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Thread view: the open conversation's messages. Same
                             message layout as before (muted background + hairline
                             border). Auto-scrolls via the DmScrollTarget selection
                             anchor (ListBox brings its selected item into view). -->
                        <ListBox x:Name="DmThreadList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding SelectedDmConversation.Messages}"
                                 SelectedItem="{Binding DmScrollTarget, Mode=TwoWay}"
                                 Visibility="{Binding HasSelectedDmConversation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item"
                                 VirtualizingStackPanel.CacheLength="5,5"
                                 VirtualizingStackPanel.CacheLengthUnit="Item">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <!-- Same message layout as the main chat, with a
                                     muted background and hairline border to mark
                                     DM entries (DynamicResource brushes only).
                                     Messages the BOT sent carry Username = bot
                                     username, so replies read like the main feed. -->
                                <DataTemplate>
                                    <Border Padding="8,4"
                                          Margin="0,2"
                                          Background="{DynamicResource CardHoverBrush}"
                                          BorderBrush="{DynamicResource BorderLightBrush}"
                                          BorderThickness="0,0,0,1"
                                          CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="0"
                                                     Text="{Binding TimestampDisplay}"
                                                     FontSize="10"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>

                                            <!-- Platform Logo + Badges + Username -->
                                            <StackPanel Grid.Column="1"
                                                      Orientation="Horizontal"
                                                      Margin="0,0,8,0">
                                                <Image Style="{StaticResource PlatformLogoStyle}"
                                                       Margin="0,0,6,0"/>

                                                <ItemsControl ItemsSource="{Binding BadgeImages}" Margin="0,0,4,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Width="18" Height="18"
                                                                   Margin="0,0,2,0"
                                                                   VerticalAlignment="Center"
                                                                   Source="{Binding Image}"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Stretch="Uniform"
                                                                   ToolTip="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Username (clickable — opens the viewer profile window) -->
                                                <Button Command="{Binding DataContext.OpenViewerProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      Cursor="Hand"
                                                      ToolTip="View viewer profile"
                                                      VerticalAlignment="Center"
                                                      Margin="4,0,0,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding Username}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Color}"
                                                           VerticalAlignment="Center"/>
                                                </Button>

                                                <TextBlock Text=":"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <!-- Message -->
                                            <TextBlock Grid.Column="2"
                                                     Text="{Binding Message}"
                                                     FontSize="13"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     TextWrapping="Wrap"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>
                </materialDesign:Card>
            </Grid>
            </Grid>

            <!-- Connected Channels panel: the registry of Discord channels the
                 bot monitors (third header state — exactly one of chat, DMs,
                 channels is visible). Rows come from the guild snapshot
                 overlayed with the stored registry (ConnectedChannelItem);
                 checkboxes persist through ChatViewModel toggle commands. -->
            <Grid Grid.ColumnSpan="3"
                  Visibility="{Binding ShowChannelsPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="12,10,12,4">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding RefreshChannelsCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="32" Height="32"
                                    ToolTip="Refresh from Discord"
                                    AutomationProperties.Name="Refresh channels from Discord">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccessPoint" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Connected Channels" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ConnectedChannels.Count, StringFormat='{}{0} channels'}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,4">
                            <TextBlock Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Channels the bot monitors. Tag a channel as Mod or Admin to allow tier-gated bot commands there. Support and Log mark its purpose. When nothing is configured, commands work in every channel (legacy mode)."/>
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Loading…"
                                       Visibility="{Binding ChannelsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <ListBox Grid.Row="2" Margin="12,0,12,12" ItemsSource="{Binding ConnectedChannels}"
                                 HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Pound" Width="18" Height="18" VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <!-- Stale row: stored but missing from the current guild snapshot -->
                                                    <TextBlock Text=" (no longer in guild)" FontSize="11" FontStyle="Italic" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding ExistsInGuild, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding GuildName, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding PurposeSummary, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <CheckBox Content="Monitor" Margin="6,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleChannelMonitoringCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <CheckBox Content="Mod" Margin="6,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsModeration, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleModerationPurposeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <CheckBox Content="Admin" Margin="6,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsAdmin, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleAdminPurposeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <CheckBox Content="Support" Margin="6,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSupport, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleSupportPurposeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <CheckBox Content="Log" Margin="6,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding IsLogging, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleLoggingPurposeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,4,0"
                                                        Width="32" Height="32"
                                                        ToolTip="Use as the bot's main channel"
                                                        AutomationProperties.Name="Set as main channel"
                                                        Command="{Binding DataContext.SetAsMainChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="StarOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="32" Height="32"
                                                        ToolTip="Open this channel in chat"
                                                        AutomationProperties.Name="Open channel in chat"
                                                        Command="{Binding DataContext.OpenChannelInChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- Message Input -->
        <materialDesign:Card Grid.Row="2" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Platform Selector Button -->
                <Button Grid.Column="0"
                      Command="{Binding TogglePlatformSelectorCommand}"
                      Style="{StaticResource MaterialDesignIconButton}"
                      Width="40"
                      Height="40"
                      Margin="0,0,8,0"
                      ToolTip="Select Platform">
                    <Grid>
                        <!-- Platform Icon -->
                        <Image Width="24" Height="24" 
                               Source="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToImageConverter}}"/>
                        
                        <!-- Platform Selector Popup -->
                        <Popup IsOpen="{Binding IsPlatformSelectorOpen}"
                               StaysOpen="False"
                               Placement="Top"
                               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Button}}">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <ItemsControl ItemsSource="{Binding ConnectedPlatforms}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectPlatformCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Height="40"
                                                    Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="20" Height="20" VerticalAlignment="Center"
                                                           Source="{Binding Name, Converter={StaticResource PlatformToImageConverter}}"/>
                                                    <TextBlock Text="{Binding Name}" 
                                                             Margin="8,0,0,0" 
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                </Button>
                
                <TextBox Grid.Column="1"
                       Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0">
                    <TextBox.Style>
                        <!-- BasedOn the implicit MaterialDesign style: keeps the dark
                             themed chrome (transparent background over the card, bottom
                             accent line, muted placeholder). A local style WITHOUT
                             BasedOn wipes it and falls back to white WPF chrome. -->
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <!-- Unified reply box: the placeholder switches while a DM
                                 thread is open (the hint must only be set here — a local
                                 attribute value would override the trigger). -->
                            <Setter Property="materialDesign:HintAssist.Hint" Value="Send a message..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="materialDesign:HintAssist.Hint" Value="Reply as Vyral Bot (DM)..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                      Command="{Binding SendMessageCommand}"
                      Height="36"
                      Padding="24,0"
                      BorderBrush="{StaticResource PrimaryHueMidBrush}"
                      BorderThickness="0">
                    <!-- Platform brand background + readable Foreground (Facebook's
                         white needs dark-blue text — converter "foreground" param).
                         DM reply mode swaps the background for a Discord-blue → red
                         diagonal gradient. -->
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background" Value="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToBrushConverter}}"/>
                            <Setter Property="Foreground" Value="{Binding SelectedPlatform.Name, Converter={StaticResource PlatformToBrushConverter}, ConverterParameter=foreground}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DmReplyGradientBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Send"
                                               Width="16"
                                               Height="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                        <TextBlock Text="SEND"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Send to All Platforms Button -->
                <Border Grid.Column="3"
                        BorderBrush="{StaticResource PrimaryHueMidBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Margin="8,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Hidden in DM reply mode so a DM draft cannot be
                                 broadcast to every platform. -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDmReplyMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Button Command="{Binding SendToAllPlatformsCommand}"
                          Height="36"
                          Width="36"
                          Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Send to all connected platforms">
                        <Image Source="{DynamicResource AppLogoSource}" 
                               Width="20" 
                               Height="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
