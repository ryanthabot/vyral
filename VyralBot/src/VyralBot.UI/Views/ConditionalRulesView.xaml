<UserControl x:Class="VyralBot.UI.Views.ConditionalRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ConditionalRulesViewModel}">
    <UserControl.Resources>
        <!-- Local converters -->
        <converters:InvertBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,5,0,3"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rules List Panel -->
        <Border Grid.Column="0" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="15" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Auto-Reply Rules" Style="{StaticResource HeaderStyle}"/>

                <!-- Rules List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" 
                         SelectedItem="{Binding SelectedRule}"
                         Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderPrimaryBrush}"
                         Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Grid.Row="1" FontSize="11" Opacity="0.8">
                                    <Run Text="{Binding Platform}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding EventType}"/>
                                    <Run Text=" • Priority: "/>
                                    <Run Text="{Binding Priority}"/>
                                </TextBlock>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="✓" Foreground="LimeGreen" FontWeight="Bold" 
                                               Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Triggered: " FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text="{Binding TriggerCount}" FontSize="10" Opacity="0.7"/>
                                    <TextBlock Text=" times" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="New Rule" Command="{Binding NewRuleCommand}"/>
                    <Button Content="Edit" Command="{Binding EditRuleCommand}" 
                            IsEnabled="{Binding SelectedRule, Converter={StaticResource NullToBoolConverter}}"/>
                    <Button Content="Delete" Command="{Binding DeleteRuleCommand}" 
                            IsEnabled="{Binding SelectedRule, Converter={StaticResource NullToBoolConverter}}"
                            Foreground="OrangeRed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edit Panel -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="15" 
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Rule Configuration" Style="{StaticResource HeaderStyle}"/>

                    <!-- Basic Info -->
                    <TextBlock Text="Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Platform:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Platforms}" 
                                      SelectedItem="{Binding EditPlatform}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Event Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding EventTypes}" 
                                      SelectedItem="{Binding EditEventType}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Priority:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditPriority, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                            <CheckBox Content="Enabled" IsChecked="{Binding EditIsEnabled}" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Condition Builder -->
                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Conditions" Style="{StaticResource HeaderStyle}"/>
                    
                    <TextBlock Text="Add Condition:" Style="{StaticResource LabelStyle}"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ConditionTypes}" 
                                      SelectedItem="{Binding ConditionType}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Field:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ConditionField, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g., count, username, is_subscriber, time_of_day"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Operator:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Operators}" 
                                      SelectedItem="{Binding ConditionOperator}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Value:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ConditionValue, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g., 100, true, 10:00"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                        <Button Content="Add Condition" Command="{Binding AddConditionCommand}"/>
                        <Button Content="Clear All" Command="{Binding ClearConditionsCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Condition JSON:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding EditConditionJson, UpdateSourceTrigger=PropertyChanged}" 
                             Height="120" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>

                    <TextBlock Text="Examples:" FontSize="10" Opacity="0.7" Margin="0,5"/>
                    <TextBlock Text="• count % 100 == 0: Field=count, Operator=Modulo, Value=100"  FontSize="10" Opacity="0.7"/>
                    <TextBlock Text="• is_subscriber: Field=is_subscriber, Type=Status, Operator=Equals, Value=true" FontSize="10" Opacity="0.7"/>
                    <TextBlock Text="• time_of_day >= 20:00: Field=time_of_day, Type=Time, Operator=GreaterOrEqual, Value=20:00" FontSize="10" Opacity="0.7"/>

                    <!-- Reply Template -->
                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Reply Message" Style="{StaticResource HeaderStyle}"/>
                    
                    <TextBlock Text="Template:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding EditReplyTemplate, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                    
                    <TextBlock Text="Available variables: {username}, {platform}, {count}, {amount}" 
                               FontSize="10" Opacity="0.7" Margin="0,5"/>

                    <!-- Save/Cancel Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Save Rule" Command="{Binding SaveRuleCommand}" Foreground="LimeGreen"/>
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rule Details Panel (when not editing) -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="15" 
                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Rule Details" Style="{StaticResource HeaderStyle}"/>
                
                <TextBlock Text="Select a rule from the list to view details, or click 'New Rule' to create one." 
                           Opacity="0.7" TextWrapping="Wrap"
                           Visibility="{Binding SelectedRule, Converter={StaticResource InverseNullToVisibilityConverter}}"/>

                <StackPanel Visibility="{Binding SelectedRule, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedRule.Name}" FontSize="20" FontWeight="Bold" Margin="0,10,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRule.Platform}" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Event Type:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRule.EventType}" Margin="0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Priority:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRule.Priority}" Margin="0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,5">
                            <Run Text="{Binding SelectedRule.IsEnabled, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Enabled|Disabled'}"/>
                        </TextBlock>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Triggered:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,5">
                            <Run Text="{Binding SelectedRule.TriggerCount}"/>
                            <Run Text=" times"/>
                        </TextBlock>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Last Triggered:" FontWeight="SemiBold" Margin="0,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRule.LastTriggeredAt}" Margin="0,5"/>
                    </Grid>

                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Condition JSON:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBox Text="{Binding SelectedRule.ConditionJson}" IsReadOnly="True" 
                             Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Background="{DynamicResource CardBackgroundBrush}"/>

                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Reply Template:" FontWeight="SemiBold" Margin="0,5"/>
                    <TextBox Text="{Binding SelectedRule.ReplyTemplate}" IsReadOnly="True" 
                             Height="60" TextWrapping="Wrap" Background="{DynamicResource CardBackgroundBrush}"/>

                    <Button Content="Test Rule" Command="{Binding TestRuleCommand}" 
                            HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
