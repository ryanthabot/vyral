<UserControl x:Class="VyralBot.UI.Views.YouTubeWebSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Stepper Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Step Navigation Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="YouTube Setup Wizard"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Margin="0,0,0,10"/>

                <!-- Stepper -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoToStep1Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46"
                            Padding="12,4"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="30" Height="30"
                                    CornerRadius="15"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource YouTubeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Enable API"
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 1 -->
                    <Rectangle Grid.Column="1"
                             Width="40"
                             Height="2"
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 2 -->
                    <Button Grid.Column="2"
                            Command="{Binding GoToStep2Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46"
                            Padding="12,4"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="30" Height="30"
                                    CornerRadius="15"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource YouTubeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Create App"
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Foreground" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 2 -->
                    <Rectangle Grid.Column="3"
                             Width="40"
                             Height="2"
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 3 -->
                    <Button Grid.Column="4"
                            Command="{Binding GoToStep3Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46"
                            Padding="12,4"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="30" Height="30"
                                    CornerRadius="15"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource YouTubeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Authorize"
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Foreground" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 3 -->
                    <Rectangle Grid.Column="5"
                             Width="40"
                             Height="2"
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 4 -->
                    <Button Grid.Column="6"
                            Command="{Binding GoToStep4Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46"
                            Padding="12,4"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="30" Height="30"
                                    CornerRadius="15"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource YouTubeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="4"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Test"
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="{DynamicResource YouTubeBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Success Screen (Step 3) -->
            <Border Background="{DynamicResource BackgroundDarkBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="600">
                    <TextBlock Text="✓ Setup Complete!"
                             FontSize="32"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SuccessGreenBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Your YouTube credentials have been saved securely."
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,32"/>

                    <materialDesign:Card Padding="24"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Margin="0,0,0,32">
                        <StackPanel>
                            <TextBlock Text="Saved Credentials"
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                         Text="Client ID:"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                         Text="{Binding MaskedClientId}"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="Consolas"
                                         Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                         Text="Client Secret:"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="••••••••••••••••"
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="Consolas"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <Button Content="FINISH SETUP"
                          Command="{Binding FinishSetupCommand}"
                          Style="{StaticResource MaterialDesignRaisedButton}"
                          Background="{DynamicResource PrimaryBrush}"
                          Foreground="White"
                          Height="40"
                          Padding="32,0"
                          FontSize="16"
                          FontWeight="Bold"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Step Content (Steps 1-2) - Shows instructions or browser -->
            <Grid Background="{DynamicResource BackgroundDarkBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Floating Buttons Bar (Step 2 only) -->
                <Border Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                        <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1">
                    <!-- WebView2 Browser (Steps 1 & 2) -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                            <Condition Binding="{Binding ShowModal}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border x:Name="WebView2Container"/>
                    </Border>

                    <!-- Step 1 Instructions -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                            <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 1: Enable YouTube API"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>

                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Google Cloud Console Setup"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                        <Run Text="You need to enable the YouTube Data API in Google Cloud Console so VyralBot can interact with YouTube Live Chat."/>
                                    </TextBlock>

                                    <TextBlock Text="Follow these steps:"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,8,0,8"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run FontWeight="SemiBold" Text="1."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Foreground="#FF0000" Text="SIGN IN WITH YOUTUBE"/> <Run Text="below to open Google Cloud Console in the browser."/>
                                        <LineBreak/>
                                        <Run Text="   Sign in with the Google account linked to your YouTube channel."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="2."/> <Run Text="Create a new project or select an existing one from the top bar."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="3."/> <Run Text="Click the"/> <Run FontWeight="SemiBold" Text="PROJECT ID"/> <Run Text="button in the bottom bar. A popup will ask you to paste your Google Cloud Project ID (found in the dashboard URL or project selector)."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="4."/> <Run Text="After saving your Project ID, a"/> <Run FontWeight="SemiBold" Text="COPY SEARCH"/> <Run Text="button appears. Click it — this copies 'YouTube Data API v3' to your clipboard. Paste it into the search bar in the browser above."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="5."/> <Run Text="Click on 'YouTube Data API v3' in the search results, then click"/> <Run FontWeight="SemiBold" Text="Enable"/> <Run Text="."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="6."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Text="CONTINUE"/> <Run Text="in the bottom-right to proceed to Step 2."/>
                                    </TextBlock>

                                    <Button Content="SIGN IN WITH YOUTUBE"
                                           Command="{Binding OpenStep1BrowserCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource YouTubeBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>

                    <!-- Step 2 Instructions -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                            <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 2: Create OAuth Credentials"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>

                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Create OAuth Client Credentials"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                        <Run Text="You need to create OAuth credentials so VyralBot can securely authenticate with YouTube on your behalf."/>
                                    </TextBlock>

                                    <TextBlock Text="Follow these steps:"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,8,0,8"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run FontWeight="SemiBold" Text="1."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Foreground="#FF0000" Text="OPEN GOOGLE CLOUD CONSOLE"/> <Run Text="below to open the Credentials page in the browser."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="2."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Text="'+ CREATE CREDENTIALS'"/> <Run Text="→"/> <Run FontWeight="SemiBold" Text="'OAuth client ID'"/> <Run Text="."/>
                                        <LineBreak/>
                                        <Run Text="   • If Google asks you to configure the OAuth consent screen first, do that."/>
                                        <LineBreak/>
                                        <Run Text="   • After completing it, click"/> <Run FontWeight="SemiBold" Text="OAUTH CONSENT RELOAD"/> <Run Text="in the bottom bar to return to the Credentials page."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="3."/> <Run Text="Set Application type to"/> <Run FontWeight="SemiBold" Text="'Web application'"/> <Run Text="and give it any name (e.g. VyralBot)."/>
                                        <LineBreak/>
                                        <Run Text="   • Under 'Authorized redirect URIs', click"/> <Run FontWeight="SemiBold" Text="COPY URI"/> <Run Text="in the bottom bar (this copies"/> <Run FontFamily="Consolas" Text="http://localhost:3000/oauth2callback"/> <Run Text="to your clipboard), then paste it into the URI field and press Enter."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="4."/> <Run Text="Click 'Create'. Google will display your Client ID and Client Secret."/>
                                        <LineBreak/>
                                        <Run Text="   • Click"/> <Run FontWeight="SemiBold" Text="SAVE CLIENT ID"/> <Run Text="in the bottom-right bar → paste your Client ID → click Save."/>
                                        <LineBreak/>
                                        <Run Text="   • Click"/> <Run FontWeight="SemiBold" Text="SAVE CLIENT SECRET"/> <Run Text="→ paste your Client Secret → click Save."/>
                                        <LineBreak/>
                                        <Run Text="   • Both buttons turn green when saved."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="5."/> <Run Text="After both are saved, click"/> <Run FontWeight="SemiBold" Text="ADD SCOPES"/> <Run Text="— this copies the YouTube scope URL to your clipboard and opens the Scopes page. Paste it into the scopes field at the bottom of the page and make sure to click update, then save."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="6."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Text="CONTINUE"/> <Run Text="to proceed to Step 3."/>
                                    </TextBlock>

                                    <Button Content="OPEN GOOGLE CLOUD CONSOLE"
                                           Command="{Binding OpenStep2BrowserCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource YouTubeBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>

                    <!-- Step 3 - OAuth Authorization -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Instructions Card (shows when WebView is NOT open) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBrowser}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Step 3: Authorize Account"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>

                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Authorize VyralBot with Your YouTube Account"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                        <Run Text="This step connects VyralBot to your YouTube account so it can read and send live chat messages."/>
                                    </TextBlock>

                                    <TextBlock Text="Follow these steps:"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,8,0,8"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                        <Run FontWeight="SemiBold" Text="1."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Text="ADD USER BEFORE AUTHORIZING"/> <Run Text="in the bottom-right. This opens Google's OAuth audience page where you must add your Google email as a test user (required while your app is in 'Testing' mode)."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="2."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Foreground="#FF0000" Text="AUTHORIZE WITH YOUTUBE"/> <Run Text="in the bottom-right. This opens Google's sign-in page in the browser."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="3."/> <Run Text="Sign in with your YouTube account and click 'Allow' to grant VyralBot access to YouTube Live Chat."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="4."/> <Run Text="The browser will close automatically after authorization. Your access and refresh tokens will be saved securely."/>
                                    </TextBlock>

                                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic">
                                            <Run Text="Troubleshooting: If the browser shows a '502 Bad Gateway' or 'This site can't be reached' error, use the OAuth URL box below to copy the URL and paste it into Chrome manually. After authorizing, copy the callback URL from your browser's address bar and paste it in the 'Manual Callback' box that appears."/>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="{Binding OAuthStatus}"
                                             FontSize="14"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16"/>

                                    <!-- OAuth URL Display for Testing -->
                                    <Border BorderBrush="{DynamicResource YouTubeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource TextPrimaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OAuthUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="🔗 OAuth URL (for debugging):"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding OAuthUrl, Mode=OneWay}"
                                                   IsReadOnly="True"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource TextOnLightBrush}"
                                                   Margin="0,0,0,8"/>
                                            <TextBlock Text="💡 If WebView2 shows 502 error, copy this URL and paste it into Chrome to test"
                                                     FontSize="11"
                                                     FontStyle="Italic"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                                <!-- Manual Callback URL Input (after browser opens) -->
                                                <Border BorderBrush="{DynamicResource YouTubeBrush}" BorderThickness="2" CornerRadius="8" Padding="20" Background="{DynamicResource BackgroundSecondaryBrush}" Margin="0,16,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowManualCallbackInput}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="📋 Paste the callback URL from your browser:"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,0,0,12"/>
                                                        <TextBlock Text="After authorizing in your browser, you'll be redirected to a page that says 'This site can't be reached'. Copy the FULL URL from the address bar and paste it below."
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,12"/>
                                                        <TextBox Text="{Binding CallbackUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="http://localhost:3000/?code=..."
                                                                 FontSize="13"
                                                                 FontFamily="Consolas"
                                                                 Margin="0,0,0,12"/>
                                                        <Button Content="SUBMIT"
                                                                Command="{Binding SubmitCallbackUrlCommand}"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Background="{DynamicResource YouTubeBrush}"
                                                                Foreground="White"
                                                                Height="40"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </StackPanel>
                                </StackPanel>

                    <!-- Step 4 - Test Connection -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 4: Test Connection"
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>

                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Verify Your Connection"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                        <Run Text="Almost done! Let's make sure everything is working by sending a test message to your YouTube live chat."/>
                                    </TextBlock>

                                    <TextBlock Text="Authorized Channel:"
                                             FontSize="13"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,12,0,4"/>

                                    <TextBox Text="{Binding ChannelName, Mode=OneWay}"
                                           materialDesign:HintAssist.Hint="Authorized channel"
                                           FontSize="14"
                                           IsReadOnly="True"
                                           Background="{DynamicResource BackgroundDarkBrush}"
                                           Margin="0,0,0,16"/>

                                    <TextBlock Text="How to test:"
                                             FontSize="14"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,8"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run FontWeight="SemiBold" Text="1."/> <Run Text="Start a YouTube live stream (or have one already running)."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="2."/> <Run Text="Click"/> <Run FontWeight="SemiBold" Foreground="#FF0000" Text="SEND TEST MESSAGE"/> <Run Text="below. This will post 'VyralBot test message' to your live chat."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="3."/> <Run Text="Check your YouTube live stream chat to confirm the message appeared."/>
                                        <LineBreak/><LineBreak/>
                                        <Run FontWeight="SemiBold" Text="4."/> <Run Text="If it worked, click"/> <Run FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="✓ IT WORKED!"/> <Run Text="in the bottom-right to save your configuration and finish setup."/>
                                    </TextBlock>

                                    <Button Content="SEND TEST MESSAGE"
                                           Command="{Binding SendTestMessageCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource YouTubeBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>

                                    <TextBlock Text="{Binding TestMessageStatus}"
                                             FontSize="14"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>
                </Grid>

                <!-- Bottom Action Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,16">
                    <Grid>
                        <!-- Back Button (Steps 2, 3, and 4) -->
                        <Button Content="← BACK"
                                Command="{Binding GoBackCommand}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Height="40"
                                Padding="24,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 1 Project ID / Copy Search Button (shown on Step 1) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Project ID Button (shown when project ID NOT saved) -->
                            <Button Content="PROJECT ID"
                                    Command="{Binding SaveProjectIdCommand}"
                                    Height="40"
                                    Padding="24,0"
                                    Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCopySearch}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Copy Search Button (shown when project ID IS saved) -->
                            <Button Content="📋 COPY SEARCH"
                                    Command="{Binding CopySearchCommand}"
                                    Height="40"
                                    Padding="24,0"
                                    Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCopySearch}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Step 2 Action Bar Buttons (OAuth Consent Reload + Copy URI - hidden when both creds saved) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                                <Condition Binding="{Binding BothCredentialsSaved}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- OAuth Consent Reload Button -->
                            <Button Content="OAUTH CONSENT RELOAD"
                                    Command="{Binding OAuthConsentReloadCommand}"
                                    Height="40"
                                    Padding="24,0"
                                    Margin="0,0,12,0"
                                    Foreground="White"
                                    Visibility="{Binding ShowOAuthConsentReload, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Copy URI Button -->
                            <Button Content="📋 COPY URI"
                                    Command="{Binding CopyRedirectUriCommand}"
                                    Background="{DynamicResource YouTubeBrush}"
                                    Foreground="White"
                                    Height="40"
                                    Padding="24,0"
                                    Margin="0,0,12,0"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>

                        <!-- Step 2 Credential Buttons (shown until both saved) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding BothCredentialsSaved}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Content="SAVE CLIENT ID"
                                  Command="{Binding SaveClientIdCommand}"
                                  Height="40"
                                  Padding="24,0"
                                  Margin="0,0,12,0"
                                  Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientIdSaved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="SAVE CLIENT SECRET"
                                  Command="{Binding SaveClientSecretCommand}"
                                  Height="40"
                                  Padding="24,0"
                                  Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientSecretSaved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Step 2 Add Scopes Button (shown when both creds saved, scopes NOT yet added) -->
                        <Button Content="ADD SCOPES"
                                Command="{Binding AddScopesCommand}"
                                Height="40"
                                Padding="24,0"
                                Foreground="White"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding BothCredentialsSaved}" Value="True"/>
                                                <Condition Binding="{Binding ScopesAdded}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 1 Continue Button (Non-Browser Mode) -->
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueFromStep1Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 1 Continue Button (Browser Mode) -->
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueFromStep1Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 2 Continue Button (shows when scopes added) -->
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueFromStep2Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding ScopesAdded}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 3 Continue Button (shows when OAuth authorized) -->
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueFromStep3Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="3"/>
                                                <Condition Binding="{Binding IsOAuthAuthorized}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 3 Add User Button (shows when user NOT yet added) -->
                        <Button Content="ADD USER BEFORE AUTHORIZING"
                                Command="{Binding AddUserCommand}"
                                Background="{DynamicResource YouTubeBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="3"/>
                                                <Condition Binding="{Binding UserAdded}" Value="False"/>
                                                <Condition Binding="{Binding IsOAuthAuthorized}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 3 Authorize Button (shows when user added but NOT authorized) -->
                        <Button Content="AUTHORIZE WITH YOUTUBE"
                                Command="{Binding AuthorizeOAuthCommand}"
                                Background="{DynamicResource YouTubeBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="3"/>
                                                <Condition Binding="{Binding UserAdded}" Value="True"/>
                                                <Condition Binding="{Binding IsOAuthAuthorized}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 4 Complete Setup Button (✓ IT WORKED!) -->
                        <Button Content="✓ IT WORKED!"
                                Command="{Binding CompleteSetupCommand}"
                                Background="{DynamicResource SuccessGreenBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                FontWeight="Bold"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Modal for Client ID/Secret Input - At root level to overlay everything -->
        <Border Grid.RowSpan="2"
                Background="{DynamicResource OverlayBackgroundBrush}"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowModal}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <materialDesign:Card Width="500"
                                Padding="32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ModalDescription}"
                             FontSize="14"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,24"/>

                    <TextBox Text="{Binding ModalInput, UpdateSourceTrigger=PropertyChanged}"
                           materialDesign:HintAssist.Hint="Paste here..."
                           FontFamily="Consolas"
                           FontSize="14"
                           Padding="12"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           x:Name="ModalInputTextBox"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL"
                              Command="{Binding CloseModalCommand}"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Margin="0,0,8,0"
                              Padding="16,8"/>

                        <Button Content="SAVE"
                              Command="{Binding SaveModalCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Background="{DynamicResource YouTubeBrush}"
                              Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
