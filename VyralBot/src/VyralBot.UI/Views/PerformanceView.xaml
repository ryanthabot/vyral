<UserControl x:Class="VyralBot.UI.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>

        <Style x:Key="MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="MutedCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Status pill: color follows the Status text. -->
        <Style x:Key="StatusPill" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Connected">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Connecting…">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- ===== Header: title + uptime + interval + pause ===== -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Speedometer"
                                             Width="24" Height="24"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Live Performance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding UptimeText, StringFormat=up {0}}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Refresh"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding RefreshIntervalOptions}"
                              SelectedItem="{Binding RefreshIntervalSeconds}"
                              Width="70"
                              Margin="0,0,12,0"/>
                    <Button Command="{Binding TogglePauseCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pause"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <materialDesign:PackIcon Kind="Play"
                                                     Width="18" Height="18"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsPaused, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Resume"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Pause"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsPaused, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Summary tiles ===== -->
            <UniformGrid Columns="6" Margin="0,0,-12,16">
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}">
                            <Run Text="{Binding CpuPercent, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}">
                            <Run Text="{Binding MemoryMb, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text=" MB"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Threads" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding ThreadCount, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="GC Collections" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding GcTotalCollections, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Events / s" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding EventsPerSecond, Mode=OneWay, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTile}">
                    <StackPanel>
                        <TextBlock Text="Workflows / s" Style="{StaticResource TileTitle}"/>
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding WorkflowsPerSecond, Mode=OneWay, StringFormat={}{0:F1}}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Charts ===== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CPU history" Style="{StaticResource TileTitle}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding CpuPeakText, StringFormat=peak {0}}"
                                       Style="{StaticResource TileTitle}"/>
                        </Grid>
                        <Polyline Height="64"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource PrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  Points="{Binding CpuHistoryPoints, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Memory history" Style="{StaticResource TileTitle}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding MemoryPeakText, StringFormat=peak {0}}"
                                       Style="{StaticResource TileTitle}"/>
                        </Grid>
                        <Polyline Height="64"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource SuccessBrush}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  Points="{Binding MemoryHistoryPoints, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Platforms ===== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Platforms"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" SharedSizeGroup="PlatformName"/>
                            <ColumnDefinition Width="110" SharedSizeGroup="PlatformStatus"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="PlatformBreakdown"/>
                            <ColumnDefinition Width="70" SharedSizeGroup="EventsTotal"/>
                            <ColumnDefinition Width="60" SharedSizeGroup="EventsRate"/>
                            <ColumnDefinition Width="80" SharedSizeGroup="MessagesTotal"/>
                            <ColumnDefinition Width="60" SharedSizeGroup="MessagesRate"/>
                            <ColumnDefinition Width="80" SharedSizeGroup="SendsTotal"/>
                            <ColumnDefinition Width="90" SharedSizeGroup="LastActivity"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PLATFORM" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="EVENT TYPES" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="EVENTS" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="4" Text="/S" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="5" Text="MSG IN" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="6" Text="/S" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="7" Text="SENT" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="8" Text="FAILED" Style="{StaticResource HeaderCell}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PlatformRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" SharedSizeGroup="PlatformName"/>
                                        <ColumnDefinition Width="110" SharedSizeGroup="PlatformStatus"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="PlatformBreakdown"/>
                                        <ColumnDefinition Width="70" SharedSizeGroup="EventsTotal"/>
                                        <ColumnDefinition Width="60" SharedSizeGroup="EventsRate"/>
                                        <ColumnDefinition Width="80" SharedSizeGroup="MessagesTotal"/>
                                        <ColumnDefinition Width="60" SharedSizeGroup="MessagesRate"/>
                                        <ColumnDefinition Width="80" SharedSizeGroup="SendsTotal"/>
                                        <ColumnDefinition Width="90" SharedSizeGroup="LastActivity"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Platform}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource StatusPill}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding EventBreakdown}" Style="{StaticResource MutedCell}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EventsTotal}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding EventsPerSecond, StringFormat={}{0:F1}}" Style="{StaticResource MutedCell}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MessagesTotal}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding MessagesPerSecond, StringFormat={}{0:F1}}" Style="{StaticResource MutedCell}"/>
                                    <TextBlock Grid.Column="7" Text="{Binding SendsTotal}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="8" Text="{Binding SendsFailed, StringFormat=failed {0}}" Style="{StaticResource MutedCell}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Components ===== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Components"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" SharedSizeGroup="ComponentName"/>
                            <ColumnDefinition Width="120" SharedSizeGroup="ComponentStatus"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="ComponentDetail"/>
                            <ColumnDefinition Width="90" SharedSizeGroup="ComponentTotal"/>
                            <ColumnDefinition Width="80" SharedSizeGroup="ComponentRate"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMPONENT" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="DETAIL" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="4" Text="/S" Style="{StaticResource HeaderCell}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ComponentRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" SharedSizeGroup="ComponentName"/>
                                        <ColumnDefinition Width="120" SharedSizeGroup="ComponentStatus"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="ComponentDetail"/>
                                        <ColumnDefinition Width="90" SharedSizeGroup="ComponentTotal"/>
                                        <ColumnDefinition Width="80" SharedSizeGroup="ComponentRate"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Component}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource MutedCell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource MutedCell}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Total}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PerSecond, StringFormat={}{0:F1}}" Style="{StaticResource MutedCell}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Child processes ===== -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Child Processes"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Text="WebView2 runtime + ngrok spawned by Vyral"
                                   Style="{StaticResource TileTitle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" SharedSizeGroup="ProcName"/>
                            <ColumnDefinition Width="80" SharedSizeGroup="ProcPid"/>
                            <ColumnDefinition Width="110" SharedSizeGroup="ProcMemory"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="ProcCpu"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="2" Text="MEMORY" Style="{StaticResource HeaderCell}"/>
                        <TextBlock Grid.Column="3" Text="TOTAL CPU" Style="{StaticResource HeaderCell}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProcessRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" SharedSizeGroup="ProcName"/>
                                        <ColumnDefinition Width="80" SharedSizeGroup="ProcPid"/>
                                        <ColumnDefinition Width="110" SharedSizeGroup="ProcMemory"/>
                                        <ColumnDefinition Width="*" SharedSizeGroup="ProcCpu"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProcessId, StringFormat={}{0}}" Style="{StaticResource MutedCell}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CpuText}" Style="{StaticResource MutedCell}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Secondary metrics strip ===== -->
            <Border Style="{StaticResource SectionCard}">
                <UniformGrid Columns="7">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Private memory" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding PrivateMemoryMb, StringFormat={}{0:F0} MB}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Managed heap" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding ManagedHeapMb, StringFormat={}{0:F0} MB}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Handles" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding HandleCount}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Allocated" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding AllocationRateMbPerSec, StringFormat={}{0:F1} MB/s}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Pool threads" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding ThreadPoolThreads}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Queue pending" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding ThreadPoolPending}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Web requests" Style="{StaticResource TileTitle}"/>
                        <TextBlock Text="{Binding RequestsPerSecond, StringFormat={}{0:F1}/s}" Style="{StaticResource Cell}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
