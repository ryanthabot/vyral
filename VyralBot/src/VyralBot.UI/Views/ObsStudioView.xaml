<UserControl x:Class="VyralBot.UI.Views.ObsStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ObsStudioViewModel}"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="16,8,16,16">

        <!-- Top status strip -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Television" Width="20" Height="20"
                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding EngineStatusText}" Margin="8,0,12,0" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Command="{Binding InitializeEngineCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Initialize engine"
                        Visibility="{Binding IsEngineReady, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
            </StackPanel>
            <!-- Friendly NotInstalled hint — JSON import still works on the Collections tab -->
            <TextBlock Margin="28,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}"
                       Text="Install OBS Studio to enable the embedded studio. JSON import still works in Collections."/>
            <!-- Missing plugin warning from the last collection load -->
            <StackPanel Orientation="Horizontal" Margin="28,4,0,0"
                        Visibility="{Binding HasMissingSources, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="Alert" Width="16" Height="16"
                                         Foreground="{DynamicResource ErrorRedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MissingSourcesText}" Margin="6,0,0,0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource ErrorRedBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom command strip -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ToggleStreamCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Broadcast" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="Start Stream"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StreamStarting}" Value="True">
                                            <Setter Property="Text" Value="Starting…"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding StreamActive}" Value="True"/>
                                                <Condition Binding="{Binding StreamStarting}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Stop Stream"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ToggleRecordCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CircleMedium" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="Record"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecordStarting}" Value="True">
                                            <Setter Property="Text" Value="Starting…"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RecordActive}" Value="True"/>
                                                <Condition Binding="{Binding RecordStarting}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Stop Record"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ToggleReplayCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Replay Buffer" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding SaveReplayCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Save Replay" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding LoadCollectionFromFileCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Load Collection JSON" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Bottom status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding EngineStatusText}" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding FpsText}" FontSize="11" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding UptimeText}" FontSize="11" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ResolutionText}" FontSize="11" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>

        <!-- Body: scenes | preview | sources -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Scenes -->
            <materialDesign:Card Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshScenesCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                ToolTip="Refresh scenes">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Layers" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="Scenes" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Scenes}"
                             SelectedItem="{Binding SelectedScene, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             Background="Transparent" BorderThickness="0" Margin="4,0,4,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <materialDesign:PackIcon Kind="Layers" Width="16" Height="16" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <!-- Program preview -->
            <materialDesign:Card Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,6">
                        <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Program Preview" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="preview active" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding ElementName=Preview, Path=IsPreviewActive, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Border Background="#FF101010" Margin="12,0,12,12" MinHeight="240">
                        <controls:ObsPreviewHost x:Name="Preview"/>
                    </Border>
                </DockPanel>
            </materialDesign:Card>

            <!-- Sources of the current scene -->
            <materialDesign:Card Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshItemsCommand}"
                                Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                ToolTip="Refresh sources">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <TextBlock Text="Sources of current scene" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding SceneSources}"
                             HorizontalContentAlignment="Stretch"
                             Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Visible, Mode=TwoWay}" Margin="0,0,8,0"
                                              VerticalAlignment="Center" ToolTip="Show / hide in the scene"
                                              Command="{Binding DataContext.SetItemVisibleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SourceId}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" IsChecked="{Binding Locked, Mode=TwoWay}" Margin="4,0,0,0"
                                                  VerticalAlignment="Center" ToolTip="Lock / unlock the source"
                                                  Command="{Binding DataContext.SetItemLockedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="LockOpenVariantOutline" Width="16" Height="16"
                                                                     Visibility="{Binding Locked, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                            <materialDesign:PackIcon Kind="Lock" Width="16" Height="16"
                                                                     Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</UserControl>
