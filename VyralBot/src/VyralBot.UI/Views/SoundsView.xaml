<UserControl x:Class="VyralBot.UI.Views.SoundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Sounds Management"
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Upload sound files and assign them to chat events"
                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            <!-- Global hotkey constraints (KI-55): hotkeys are OS-global, so they
                 fire while the game has focus too — combos the game/OS owns will
                 collide. Documented in-UI right where hotkeys get assigned. -->
            <TextBlock Text="Global hotkeys fire while any app has focus (including games). Avoid combos your game or Windows already uses (Alt+Tab, Win+G, ...). Up to 10 hotkeys."
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            <!-- Master volume: global multiplier applied on top of every per-event
                 volume (same AudioSettings value SoundService and the Audio Settings
                 page use). Persisted debounced on drag-release. -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <materialDesign:PackIcon Kind="VolumeHigh"
                                         Width="20"
                                         Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="Master Volume"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           VerticalAlignment="Center"
                           Margin="8,0,12,0"/>
                <Slider Minimum="0"
                        Maximum="100"
                        Width="240"
                        VerticalAlignment="Center"
                        Value="{Binding MasterVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Global multiplier for every event sound (Streamer and browser source)"/>
                <TextBlock Text="{Binding MasterVolumePercent, StringFormat={}{0}%}"
                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                           VerticalAlignment="Center"
                           MinWidth="42"
                           Margin="12,0,0,0"/>
            </StackPanel>
            <!-- Hotkey capture banner: shown while a row waits for a combo -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsCapturing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Keyboard"
                                             Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding CaptureHint}"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               VerticalAlignment="Center"
                               Margin="8,0,12,0"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelHotkeyCaptureCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="24"
                            Padding="8,0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Sound Library -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="15">
                        <TextBlock Text="🎵 Sound Library" 
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    </Border>

                    <!-- Sound Files List (accepts dragged audio files) -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SoundFiles}"
                             SelectedItem="{Binding SelectedSoundFile}"
                             AllowDrop="True"
                             Margin="10">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DragOver">
                                <i:InvokeCommandAction Command="{Binding DragOverSoundFilesCommand}"
                                                       PassEventArgsToCommand="True"/>
                            </i:EventTrigger>
                            <i:EventTrigger EventName="Drop">
                                <i:InvokeCommandAction Command="{Binding DropSoundFilesCommand}"
                                                       PassEventArgsToCommand="True"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Per-file test play (previews at master volume) -->
                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Name}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="26"
                                            MinWidth="26"
                                            Padding="4,0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Play (preview at master volume)">
                                        <materialDesign:PackIcon Kind="Play"
                                                                 Width="16"
                                                                 Height="16"/>
                                    </Button>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <!-- Duration (.wav only - read from the header) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Duration}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDuration}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Global hotkey (KI-55): click to capture a modifier+key
                                         combo; shows the assigned gesture ("Ctrl+Alt+1"). The
                                         click focuses the button so key events reach the page's
                                         PreviewKeyDown capture handler. -->
                                    <Button Grid.Column="3"
                                            Command="{Binding DataContext.BeginCaptureHotkeyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Height="26"
                                            MinWidth="72"
                                            Padding="6,0"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Focusable="True"
                                            ToolTip="Assign a global hotkey (fires even while a game has focus)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Content" Value="Set Hotkey"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHotkey}" Value="True">
                                                        <Setter Property="Content" Value="{Binding Hotkey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                        <Setter Property="Content" Value="Press combo..."/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- Clear the assigned hotkey -->
                                    <Button Grid.Column="4"
                                            Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Height="26"
                                            MinWidth="22"
                                            Padding="2,0"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            ToolTip="Clear hotkey">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Content" Value="✕"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasHotkey}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state: shown while the sound library is empty.
                         Hit-test disabled so drag-drop lands on the ListBox behind it. -->
                    <StackPanel Grid.Row="1"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SoundFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="MusicNote"
                                                 Width="48"
                                                 Height="48"
                                                 Foreground="{DynamicResource TextMutedBrush}"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12"/>
                        <TextBlock Text="No sounds yet — add your first sound"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Drop audio files here (.wav, .mp3, .ogg, .m4a) or use the Upload Sound button below, then assign them to chat events on the right."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="10">
                        <Button Content="Upload Sound" 
                                Command="{Binding UploadSoundCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,0,5"/>
                        <Button Content="Play Selected" 
                                Command="{Binding PlaySoundCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,5"/>
                        <Button Content="Delete Selected" 
                                Command="{Binding DeleteSoundCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Right Panel: Event Assignments -->
            <materialDesign:Card Grid.Column="1" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="15">
                        <StackPanel>
                            <TextBlock Text="🔔 Event Sound Assignments" 
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                            <TextBlock Text="Select a sound from the library, then click 'Assign' to link it to an event" 
                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Event Mappings DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding EventMappings}" 
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              Margin="10">
                        <DataGrid.Columns>
                            <!-- Event Name -->
                            <DataGridTextColumn Header="Event" 
                                                Binding="{Binding DisplayName}" 
                                                Width="150"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Assigned Sound -->
                            <DataGridTextColumn Header="Sound File" 
                                                Width="*"
                                                IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="SoundFile">
                                        <Binding.TargetNullValue>(No sound assigned)</Binding.TargetNullValue>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoundFile}" Value="">
                                                <Setter Property="Text" Value="(No sound assigned)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Volume Slider -->
                            <DataGridTemplateColumn Header="Volume" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" 
                                                    Minimum="0" 
                                                    Maximum="1" 
                                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                    TickFrequency="0.1"
                                                    VerticalAlignment="Center"
                                                    Margin="5,0">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="ValueChanged">
                                                        <i:InvokeCommandAction Command="{Binding DataContext.UpdateEventVolumeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding}"/>
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </Slider>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Volume, StringFormat=P0}" 
                                                       VerticalAlignment="Center"
                                                       MinWidth="40"
                                                       Margin="5,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Assign" 
                                                    Command="{Binding DataContext.AssignSoundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="30"
                                                    Padding="8,0"
                                                    Margin="2"/>
                                            <Button Content="Clear" 
                                                    Command="{Binding DataContext.UnassignSoundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="30"
                                                    Padding="8,0"
                                                    Margin="2"/>
                                            <Button Content="Test" 
                                                    Command="{Binding DataContext.TestEventSoundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Height="30"
                                                    Padding="8,0"
                                                    Margin="2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SoundFile, Converter={x:Static converters:StringNullOrEmptyConverter.Instance}}" Value="False">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Song Requests (wave 13): queue card for the songplayer.html browser
             source. Collapsed by default so the sounds layout is unchanged for
             streamers who don't use song requests. -->
        <materialDesign:Card Grid.Row="2" Margin="0,10,0,0">
            <Expander IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MusicBox"
                                                 Width="18"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Song Requests"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- Queue list: NOW PLAYING row highlighted, upcoming below -->
                    <Grid Grid.Column="0" Margin="0,0,10,0" MinHeight="150" MaxHeight="220">
                        <ListBox ItemsSource="{Binding SongQueue}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="2"
                                            Padding="6,4"
                                            Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                     Kind="PlayCircleOutline"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding VideoId}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Requester}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Platform, StringFormat=' · {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock FontSize="11"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="Queued">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="NOW PLAYING"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding HasDuration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- Empty state (hit-test disabled so the list stays usable) -->
                        <StackPanel IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSongQueueItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Queue is empty — the player page starts the next song automatically"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right panel: browser source URL, volume, limits, actions -->
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="OBS Browser Source"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SongPlayerUrl, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1"
                                    Content="Copy"
                                    Command="{Binding CopySongPlayerUrlCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="30"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copy the browser-source URL for OBS"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume (%)"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SongVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     VerticalAlignment="Center"
                                     ToolTip="Baked into the URL as ?volume=N (0-100)"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max per user"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding MaxSongsPerUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     VerticalAlignment="Center"
                                     ToolTip="Queued songs one requester may have (1-50)"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max queue total"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding MaxSongQueueTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     VerticalAlignment="Center"
                                     ToolTip="Total queue capacity across requesters (1-200)"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Skip"
                                    Command="{Binding SkipSongCommand}"
                                    IsEnabled="{Binding HasSongQueueItems}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    ToolTip="Advance the current song (the player picks up the change within 5s)"/>
                            <Button Content="Clear Queue"
                                    Command="{Binding ClearSongQueueCommand}"
                                    IsEnabled="{Binding HasSongQueueItems}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    ToolTip="Remove every queued song"/>
                        </StackPanel>

                        <TextBlock Text="The player page auto-advances when a video ends and reports titles back automatically. Use the copied URL as an OBS Browser source."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </materialDesign:Card>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource OverlayBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="50"
                             Height="50"/>
                <TextBlock Text="Loading..."
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="16"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
