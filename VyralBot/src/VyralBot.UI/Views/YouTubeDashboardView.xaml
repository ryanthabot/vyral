<UserControl x:Class="VyralBot.UI.Views.YouTubeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Inverse Boolean Converter -->
        <Style x:Key="InverseVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowStreamPreview}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Live/Offline Status Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource YouTubeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Text" Value="LIVE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="False">
                    <Setter Property="Text" Value="OFFLINE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stream actions hint: shown only when the platform is not connected -->
        <Style x:Key="ConnectHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One-line action status shown under the Stream Management panel -->
        <Style x:Key="PanelStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- Stream Manager Layout - Flexible Grid -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Column - Vertically Stacked Panels -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="300"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>
                
                <!-- Stream Preview Panel -->
                <materialDesign:Card Grid.Row="0" 
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <Grid>
                                <TextBlock Text="Stream Preview" 
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Username}" 
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Style="{StaticResource StatusTextStyle}"/>
                                    </Border>
                                    <Button Command="{Binding TogglePreviewPanelCommand}"
                                          Style="{StaticResource MaterialDesignIconButton}"
                                          ToolTip="Hide Panel"
                                          Width="28"
                                          Height="28"
                                          Padding="0"
                                          Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    
                        <!-- Stream Preview Content -->
                        <Grid Grid.Row="1" Background="{DynamicResource YouTubeBackgroundBrush}">
                        <!-- Show Preview Button (shown when preview is not active) -->
                        <Border Style="{StaticResource InverseVisibilityStyle}"
                                Background="{DynamicResource YouTubeSurfaceBrush}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Button Command="{Binding PreviewStreamCommand}"
                                  Style="{StaticResource MaterialDesignFlatButton}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Height="120"
                                  Width="250">
                                <StackPanel>
                                    <materialDesign:PackIcon Kind="PlayCircle" 
                                                           Width="48" 
                                                           Height="48"
                                                           Foreground="{DynamicResource YouTubeBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,12"/>
                                    <TextBlock Text="SHOW PREVIEW" 
                                             FontSize="16"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click to load stream" 
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             HorizontalAlignment="Center"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        
                        <!-- WebView2 Stream Player (shown when preview is active) -->
                        <Grid Visibility="{Binding ShowStreamPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- WebView2 created programmatically on-demand to avoid spawning Edge processes at startup -->
                            <Border x:Name="StreamPreviewWebViewContainer"/>
                            
                            <!-- Close Preview Button -->
                            <Button Command="{Binding CloseStreamPreviewCommand}"
                                  Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                  Background="{DynamicResource YouTubeDarkBrush}"
                                  Foreground="White"
                                  ToolTip="Hide Preview"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="12"
                                  Width="32"
                                  Height="32">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                    </Grid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
                
                <!-- Vertical Splitter -->
                <GridSplitter Grid.Row="1" 
                             Height="4" 
                             HorizontalAlignment="Stretch" 
                             Background="{DynamicResource BorderLightBrush}"
                             ShowsPreview="True"
                             Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Activity Feed Panel -->
                <materialDesign:Card Grid.Row="2" 
                                    Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Panel Header -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Activity Feed" 
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <!-- Activity List -->
                        <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="12">
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                     Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1"
                                                     Text="{Binding Text}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Horizontal Splitter -->
            <GridSplitter Grid.Column="1"
                         Width="4"
                         HorizontalAlignment="Stretch"
                         Background="{DynamicResource BorderLightBrush}"
                         ShowsPreview="True"/>

            <!-- Right Column - Stream Management Quick Actions -->
            <Grid Grid.Column="2">
                <materialDesign:Card Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BackgroundDarkBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <TextBlock Text="Stream Management"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Actions -->
                        <ScrollViewer Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="8">
                            <StackPanel>
                                <!-- Not-connected hint -->
                                <TextBlock Text="Connect YouTube to use stream actions"
                                         Style="{StaticResource ConnectHintStyle}"
                                         Margin="4,0,4,8"/>

                                <StackPanel IsEnabled="{Binding IsConnected}">
                                    <!-- Edit Stream Info (toggles the expander below) -->
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                          Height="70"
                                          Margin="4"
                                          Command="{Binding ToggleEditStreamInfoCommand}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Pencil"
                                                                   Width="20"
                                                                   Height="20"
                                                                   Margin="0,0,0,6"/>
                                            <TextBlock Text="Edit Stream Info"
                                                     FontSize="11"
                                                     TextAlignment="Center"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Edit Stream Info (inline editor) -->
                                    <Expander Header="Stream Info"
                                            IsExpanded="{Binding IsEditStreamInfoOpen}"
                                            Margin="4,4,4,0">
                                        <StackPanel Margin="8,8,0,0">
                                            <TextBox Text="{Binding EditStreamTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="12"
                                                   Margin="0,0,0,8"
                                                   materialDesign:HintAssist.Hint="Stream title"/>
                                            <TextBox Text="{Binding EditStreamDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   FontSize="12"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap"
                                                   AcceptsReturn="True"
                                                   materialDesign:HintAssist.Hint="Description (leave blank to keep)"/>
                                            <Button Content="APPLY"
                                                  Style="{StaticResource MaterialDesignFlatButton}"
                                                  Command="{Binding ApplyStreamInfoCommand}"
                                                  HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action status line -->
                        <TextBlock Grid.Row="2"
                                 Style="{StaticResource PanelStatusStyle}"
                                 Text="{Binding StatusMessage}"/>
                    </Grid>
                </materialDesign:Card>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
