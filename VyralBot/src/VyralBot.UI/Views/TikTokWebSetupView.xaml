<UserControl x:Class="VyralBot.UI.Views.TikTokWebSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Stepper Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Step Navigation Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,24">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="TikTok Setup Wizard" 
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Margin="0,0,0,24"/>
                
                <!-- Stepper -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 -->
                    <Button Grid.Column="0"
                            Command="{Binding GoToStep1Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TikTokBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sign In" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Foreground" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 1 -->
                    <Rectangle Grid.Column="1" 
                             Width="40" 
                             Height="2" 
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 2 -->
                    <Button Grid.Column="2"
                            Command="{Binding GoToStep2Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TikTokBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Create App" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Foreground" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 2 -->
                    <Rectangle Grid.Column="3" 
                             Width="40" 
                             Height="2" 
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 3 -->
                    <Button Grid.Column="4"
                            Command="{Binding GoToStep3Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TikTokBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Authorize" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Foreground" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Connector 3 -->
                    <Rectangle Grid.Column="5" 
                             Width="40" 
                             Height="2" 
                             Fill="{DynamicResource BorderLightBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0"/>

                    <!-- Step 4 -->
                    <Button Grid.Column="6"
                            Command="{Binding GoToStep4Command}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="60"
                            Padding="16,8"
                            IsEnabled="False"
                            Cursor="Arrow">
                        <StackPanel>
                            <Border Width="40" Height="40" 
                                    CornerRadius="20"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource TikTokBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="4" 
                                         FontSize="20" 
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Test" 
                                     FontSize="14"
                                     HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Foreground" Value="{DynamicResource TikTokBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Success Screen (Step 3) -->
            <Border Background="{DynamicResource BackgroundDarkBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="600">
                    <TextBlock Text="✓ Setup Complete!" 
                             FontSize="32"
                             FontWeight="Bold"
                             Foreground="{DynamicResource SuccessGreenBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"/>
                    
                    <TextBlock Text="Your TikTok credentials have been saved securely." 
                             FontSize="16"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,32"/>
                    
                    <materialDesign:Card Padding="24" 
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Margin="0,0,0,32">
                        <StackPanel>
                            <TextBlock Text="Saved Credentials" 
                                     FontSize="18"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,16"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                         Text="Client ID:" 
                                         FontSize="14"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Margin="0,0,16,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                         Text="{Binding MaskedClientId}" 
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="Consolas"
                                         Margin="0,0,0,8"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                         Text="Client Secret:" 
                                         FontSize="14"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="••••••••••••••••" 
                                         FontSize="14"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontFamily="Consolas"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                    
                    <Button Content="FINISH SETUP"
                          Command="{Binding FinishSetupCommand}"
                          Style="{StaticResource MaterialDesignRaisedButton}"
                          Background="{DynamicResource PrimaryBrush}"
                          Foreground="White"
                          Height="40"
                          Padding="32,0"
                          FontSize="16"
                          FontWeight="Bold"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Step Content (Steps 1-2) - Shows instructions or browser -->
            <Grid Background="{DynamicResource BackgroundDarkBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSuccessScreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Floating Buttons Bar (Step 2 only) -->
                <Border Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                        <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                
                <!-- Main Content Area -->
                <Grid Grid.Row="1">
                    <!-- WebView2 Browser (Steps 1 & 2) -->
                    <Border Background="{DynamicResource BackgroundDarkBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                            <Condition Binding="{Binding ShowModal}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border x:Name="WebView2Container"/>
                    </Border>
                    
                    <!-- Step 1 Instructions -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                            <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 1: Sign In to TikTok" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>
                            
                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Account Access Required" 
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>
                                    
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run Text="You will need to use your TikTok account in various steps throughout this setup:"/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="• Signing into TikTok"/>
                                        <LineBreak/>
                                        <Run Text="• Creating an application in TikTok Developer Portal"/>
                                        <LineBreak/>
                                        <Run Text="• Authorizing your app to manage your channel"/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="Click the button below to sign in with your TikTok account."/>
                                    </TextBlock>
                                    
                                    <Button Content="SIGN IN WITH TIKTOK"
                                           Command="{Binding OpenStep1BrowserCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource TikTokBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>
                    
                    <!-- Step 2 Instructions -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                            <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 2: Create Application" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>
                            
                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Get your Client ID and Secret" 
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>
                                    
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run Text="1. Click the button below to open the TikTok Developer Portal"/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="2. Register a new application:"/>
                                        <LineBreak/>
                                        <Run Text="   • Name: VyralBot (or anything you like)"/>
                                        <LineBreak/>
                                        <Run Text="   • OAuth Redirect URIs: http://localhost:3000"/>
                                        <LineBreak/>
                                        <Run Text="   • Category: Chat Bot"/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="3. Once created, use the buttons at the bottom right to save your Client ID and Client Secret"/>
                                    </TextBlock>
                                    
                                    <Button Content="OPEN DEVELOPER PORTAL"
                                           Command="{Binding OpenStep2BrowserCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource TikTokBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>
                    
                    <!-- Step 3 - OAuth Authorization -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- Instructions Card (shows when WebView is NOT open) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowBrowser}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <TextBlock Text="Step 3: Authorize Account" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>
                            
                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Get OAuth Access Token" 
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,16"/>
                                    
                                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                                        <Run Text="Click the button below to authorize VyralBot with your TikTok account."/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="This will:"/>
                                        <LineBreak/>
                                        <Run Text="• Open TikTok authorization inside the app"/>
                                        <LineBreak/>
                                        <Run Text="• Request permissions for TikTok Live chat, streaming, etc."/>
                                        <LineBreak/>
                                        <Run Text="• Generate access and refresh tokens"/>
                                        <LineBreak/><LineBreak/>
                                        <Run Text="After authorizing, the window will close automatically."/>
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding OAuthStatus}" 
                                             FontSize="14"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             HorizontalAlignment="Center"
                                             Margin="0,0,0,16"/>
                                    
                                    <!-- OAuth URL Display for Testing -->
                                    <Border BorderBrush="{DynamicResource TikTokBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="12"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource TextPrimaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OAuthUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="🔗 OAuth URL (for debugging):" 
                                                     FontSize="12" 
                                                     FontWeight="SemiBold"
                                                     Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding OAuthUrl, Mode=OneWay}"
                                                   IsReadOnly="True"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource TextOnLightBrush}"
                                                   Margin="0,0,0,8"/>
                                            <TextBlock Text="💡 If WebView2 shows 502 error, copy this URL and paste it into Chrome to test"
                                                     FontSize="11"
                                                     FontStyle="Italic"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                                <!-- Manual Callback URL Input (after browser opens) -->
                                                <Border BorderBrush="{DynamicResource TikTokBrush}" BorderThickness="2" CornerRadius="8" Padding="20" Background="{DynamicResource BackgroundSecondaryBrush}" Margin="0,16,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowManualCallbackInput}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="📋 Paste the callback URL from your browser:" 
                                                                   FontSize="14" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,0,0,12"/>
                                                        <TextBlock Text="After authorizing in your browser, you'll be redirected to a page that says 'This site can't be reached'. Copy the FULL URL from the address bar and paste it below."
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,12"/>
                                                        <TextBox Text="{Binding CallbackUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="http://localhost:3000/?code=..."
                                                                 FontSize="13"
                                                                 FontFamily="Consolas"
                                                                 Margin="0,0,0,12"/>
                                                        <Button Content="SUBMIT"
                                                                Command="{Binding SubmitCallbackUrlCommand}"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                                Background="{DynamicResource TikTokBrush}"
                                                                Foreground="White"
                                                                Height="40"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </StackPanel>
                                </StackPanel>
                    
                    <!-- Step 4 - Test Connection -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="800">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                            <TextBlock Text="Step 4: Test Connection" 
                                     FontSize="28"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,24"/>
                            
                            <materialDesign:Card Padding="32" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Your Authorized Channel" 
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,0,8"/>
                                    
                                    <TextBlock Text="This is the channel that was authorized in Step 3" 
                                             FontSize="12"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             Margin="0,0,0,16"/>
                                    
                                    <TextBox Text="{Binding ChannelName, Mode=OneWay}"
                                           materialDesign:HintAssist.Hint="Authorized channel"
                                           FontSize="14"
                                           IsReadOnly="True"
                                           Background="{DynamicResource BackgroundDarkBrush}"
                                           Margin="0,0,0,24"/>
                                    
                                    <Button Content="SEND TEST MESSAGE"
                                           Command="{Binding SendTestMessageCommand}"
                                           Style="{StaticResource MaterialDesignRaisedButton}"
                                           Background="{DynamicResource TikTokBrush}"
                                           Foreground="White"
                                           Height="48"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>
                                    
                                    <TextBlock Text="{Binding TestMessageStatus}" 
                                             FontSize="14"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,16"/>
                                </StackPanel>
                            </materialDesign:Card>
                    </StackPanel>
                </Grid>
                
                <!-- Bottom Action Bar -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,16">
                    <Grid>
                        <!-- Back Button (Steps 2, 3, and 4) -->
                        <Button Content="← BACK"
                                Command="{Binding GoBackCommand}"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Height="40"
                                Padding="24,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 2 Credential Buttons (shown until both saved) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding BothCredentialsSaved}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            
                            <Button Content="SAVE CLIENT ID"
                                  Command="{Binding SaveClientIdCommand}"
                                  Height="40"
                                  Padding="24,0"
                                  Margin="0,0,12,0"
                                  Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientIdSaved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="SAVE CLIENT SECRET"
                                  Command="{Binding SaveClientSecretCommand}"
                                  Height="40"
                                  Padding="24,0"
                                  Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClientSecretSaved}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        
                        <!-- Step 2 Copy Redirect URI Button (shows when browser is open) -->
                        <Button Content="📋 COPY REDIRECT URI"
                                Command="{Binding CopyRedirectUriCommand}"
                                Background="{DynamicResource TikTokBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="24,0"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 1 Continue Button (Non-Browser Mode) -->
                        <Button Content="CONTINUE"
                                Command="{Binding ContinueFromStep1Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Step 1 Continue Button (Browser Mode) -->
                        <Button Content="CONTINUE" 
                                Command="{Binding ContinueFromStep1Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="1"/>
                                                <Condition Binding="{Binding ShowBrowser}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 2 Continue Button (shows when both credentials saved) -->
                        <Button Content="CONTINUE" 
                                Command="{Binding ContinueFromStep2Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="2"/>
                                                <Condition Binding="{Binding BothCredentialsSaved}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 3 Continue Button (shows when OAuth authorized) -->
                        <Button Content="CONTINUE" 
                                Command="{Binding ContinueFromStep3Command}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="3"/>
                                                <Condition Binding="{Binding IsOAuthAuthorized}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 3 Authorize Button (shows when NOT authorized) -->
                        <Button Content="AUTHORIZE WITH TIKTOK" 
                                Command="{Binding AuthorizeOAuthCommand}"
                                Background="{DynamicResource TikTokBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentStep}" Value="3"/>
                                                <Condition Binding="{Binding IsOAuthAuthorized}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- Step 4 Complete Setup Button (✓ IT WORKED!) -->
                        <Button Content="✓ IT WORKED!" 
                                Command="{Binding CompleteSetupCommand}"
                                Background="{DynamicResource SuccessGreenBrush}"
                                Foreground="White"
                                Height="40"
                                Padding="32,0"
                                FontWeight="Bold"
                                HorizontalAlignment="Right">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Modal for Client ID/Secret Input - At root level to overlay everything -->
        <Border Grid.RowSpan="2" 
                Background="{DynamicResource OverlayBackgroundBrush}"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowModal}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <materialDesign:Card Width="500"
                                Padding="32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding ModalTitle}" 
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="0,0,0,16"/>
                    
                    <TextBlock Text="{Binding ModalDescription}" 
                             FontSize="14"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,24"/>
                    
                    <TextBox Text="{Binding ModalInput, UpdateSourceTrigger=PropertyChanged}"
                           materialDesign:HintAssist.Hint="Paste here..."
                           FontFamily="Consolas"
                           FontSize="14"
                           Padding="12"
                           Margin="0,0,0,24"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           x:Name="ModalInputTextBox"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL"
                              Command="{Binding CloseModalCommand}"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              Margin="0,0,8,0"
                              Padding="16,8"/>
                        
                        <Button Content="SAVE"
                              Command="{Binding SaveModalCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Background="{DynamicResource TikTokBrush}"
                              Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
