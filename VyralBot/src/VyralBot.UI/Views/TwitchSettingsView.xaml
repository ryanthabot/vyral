<UserControl x:Class="VyralBot.UI.Views.TwitchSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundPrimaryBrush}">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button (Sticky) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Twitch Settings" 
                         FontSize="32"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}" 
                         FontSize="14"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            
            <!-- Back Button -->
            <!-- Note: this view is hosted in MainWindow (DataContext is TwitchSettingsViewModel),
                     so the old ElementName=SettingsViewRoot binding crossed namescopes and silently
                     failed. Navigate back to the Platforms grid via the window's MainViewModel. -->
            <Button Grid.Column="1"
                    Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    VerticalAlignment="Top"
                    Margin="16,0,0,0"
                    Padding="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Back" 
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Twitch" 
                                         Width="64" 
                                         Height="64" 
                                         Foreground="#9146FF"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,16"/>
                <TextBlock Text="Configuration settings coming soon..." 
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
