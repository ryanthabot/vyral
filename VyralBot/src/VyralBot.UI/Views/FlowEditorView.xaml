<UserControl x:Class="VyralBot.UI.Views.FlowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:views="clr-namespace:VyralBot.UI.Views"
             xmlns:flow="clr-namespace:VyralBot.UI.Controls.FlowCanvas"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="{DynamicResource BackgroundDarkBrush}"
             Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>

        <!-- ============================================================
             BotGhost-builder palette (dark #1A1A2E family)
             ============================================================ -->
        <SolidColorBrush x:Key="FlowIndigoBrush" Color="{DynamicResource PrimaryColor}"/>
        <SolidColorBrush x:Key="FlowIndigoFocusBrush" Color="{DynamicResource PrimaryHover}"/>
        <SolidColorBrush x:Key="FlowPurpleBrush" Color="#A855F7"/>
        <SolidColorBrush x:Key="FlowPurpleDeepBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="FlowVioletBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="FlowGreenBrush" Color="{DynamicResource SuccessColor}"/>
        <SolidColorBrush x:Key="FlowRedBrush" Color="{DynamicResource ErrorColor}"/>
        <SolidColorBrush x:Key="FlowBlueBrush" Color="{DynamicResource InfoColor}"/>
        <SolidColorBrush x:Key="FlowInputBgBrush" Color="{DynamicResource FlowCanvasNodeBackground}"/>
        <SolidColorBrush x:Key="FlowInputBorderBrush" Color="{DynamicResource FlowCanvasNodeBorder}"/>
        <SolidColorBrush x:Key="FlowPanelBrush" Color="{DynamicResource FlowCanvasChipBackground}"/>
        <SolidColorBrush x:Key="FlowGhostBrush" Color="{DynamicResource FlowCanvasDescriptionText}"/>
        <SolidColorBrush x:Key="FlowInkBrush" Color="#111827"/>

        <!-- Side-rail panel accents (cards #2B2D42, 1px borders #374151,
             rail background darkest, per-icon accent colors). -->
        <SolidColorBrush x:Key="FlowCardBrush" Color="{DynamicResource FlowCanvasNodeBackground}"/>
        <SolidColorBrush x:Key="FlowCardBorderBrush" Color="{DynamicResource FlowCanvasNodeBorder}"/>
        <SolidColorBrush x:Key="FlowRailBrush" Color="{DynamicResource FlowCanvasBackground}"/>
        <SolidColorBrush x:Key="FlowPinkBrush" Color="#EC4899"/>
        <SolidColorBrush x:Key="FlowYellowBrush" Color="#F59E0B"/>

        <!-- ============================================================
             Implicit input styles (one per input type — every TextBox /
             ComboBox / CheckBox in this view picks these up, including the
             popups and the embed/condition builders). BasedOn the app-wide
             styles so MaterialDesign hints and the {variable} context menu
             keep working; only the colors / corner radius change.
             ============================================================ -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource FlowInputBgBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FlowInputBorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource FlowIndigoFocusBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowIndigoFocusBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FlowCanvasNodeBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource FlowInputBgBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource FlowIndigoFocusBrush}"/>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource FlowCanvasTextPrimaryBrush}"/>
        </Style>

        <!-- ============================================================
             Buttons
             ============================================================ -->

        <!-- Small outline tool button (toolbar / popups / settings panel). -->
        <Style x:Key="FlowToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FlowGhostBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom-bar primary action (SAVE): indigo #5865F2, white bold text. -->
        <Style x:Key="FlowPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FlowIndigoBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource FlowIndigoFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom-bar outline/ghost action (EXPORT / IMPORT). -->
        <Style x:Key="FlowActionButton" TargetType="Button" BasedOn="{StaticResource FlowToolButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Tiny ✕ / icon button. -->
        <Style x:Key="FlowCloseButton" TargetType="Button" BasedOn="{StaticResource FlowToolButton}">
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- Rounded-square icon chip button (palette hamburger, red close ✕,
             chip remove ✕): color comes from Background on each use. -->
        <Style x:Key="FlowIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chip" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chip" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width CTA of the side panels ("+ Create New Variable",
             "Add New Timed Event", "Save Selected Block") — Background comes
             from each use (indigo / yellow). -->
        <Style x:Key="FlowPanelCtaButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cta"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cta" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cta" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="cta" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White button on the red "Please save your changes!" bar. -->
        <Style x:Key="FlowSaveBarWhiteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#7F1D1D"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="saveBarBtn"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="saveBarBtn" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="saveBarBtn" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green/red enable-toggle dot of the side-panel workflow rows
             (green when the row's IsEnabled is true). -->
        <Style x:Key="FlowToggleDotButton" TargetType="Button" BasedOn="{StaticResource FlowIconButton}">
            <Setter Property="Background" Value="{StaticResource FlowRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter Property="Background" Value="{StaticResource FlowGreenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Icon rail (56px, six rounded-square buttons) ============ -->
        <Style x:Key="FlowRailButtonBase" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="railChip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="railChip" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="railChip" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One derived style per rail slot: the active panel gets a light
             border + full opacity (BotGhost's highlighted rail icon). -->
        <Style x:Key="FlowRailBlocksButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="0">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowRailVariablesButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="1">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowRailErrorsButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="2">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowRailCommandsButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="3">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowRailTimersButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="4">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlowRailTemplatesButton" TargetType="Button" BasedOn="{StaticResource FlowRailButtonBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="5">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Floating zoom-control square (white, dark glyph) — canvas bottom-left. -->
        <Style x:Key="FlowZoomButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource FlowInkBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="zoomBtn"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="zoomBtn" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="zoomBtn" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="zoomBtn" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Purple "+ Add" pill at the end of the options chips bar. -->
        <Style x:Key="FlowPillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource FlowPurpleBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding Foreground}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="#2A2440"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat row button used by the purple Options tab (single click /
             Enter adds the option). -->
        <Style x:Key="FlowPaletteRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="rowBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="rowBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset color swatch (Discord palette). -->
        <Style x:Key="FlowSwatchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatch"
                                Width="22" Height="22"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatch" Property="Margin" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Text styles
             ============================================================ -->
        <Style x:Key="FlowSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- Bold white BotGhost-style section header ("PARAMETERS", "ACTIONS"…). -->
        <Style x:Key="FlowSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FlowFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- Preset swatch row (instantiated fresh wherever used). -->
        <DataTemplate x:Key="SwatchRowTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource FlowSwatchButton}" Background="#5865F2" Margin="0,0,6,0"
                        Command="{Binding ApplySwatchCommand}" CommandParameter="#5865F2" ToolTip="Discord blurple #5865F2"/>
                <Button Style="{StaticResource FlowSwatchButton}" Background="#EF4444" Margin="0,0,6,0"
                        Command="{Binding ApplySwatchCommand}" CommandParameter="#EF4444" ToolTip="Red #EF4444"/>
                <Button Style="{StaticResource FlowSwatchButton}" Background="#10B981" Margin="0,0,6,0"
                        Command="{Binding ApplySwatchCommand}" CommandParameter="#10B981" ToolTip="Green #10B981"/>
                <Button Style="{StaticResource FlowSwatchButton}" Background="#F59E0B" Margin="0,0,6,0"
                        Command="{Binding ApplySwatchCommand}" CommandParameter="#F59E0B" ToolTip="Amber #F59E0B"/>
                <Button Style="{StaticResource FlowSwatchButton}" Background="#8B5CF6"
                        Command="{Binding ApplySwatchCommand}" CommandParameter="#8B5CF6" ToolTip="Purple #8B5CF6"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================
             Palette: group headers, block rows, Options-tab rows, tabs
             ============================================================ -->

        <!-- Bold white group header row (emitted when Block.Section changes). -->
        <DataTemplate x:Key="PaletteGroupHeader">
            <TextBlock Text="{Binding HeaderTitle}"
                       FontSize="12.5"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="12,14,8,4"/>
        </DataTemplate>

        <!-- Palette block entry: ⠿ drag handle + colored icon chip + bold
             title + grey description. Mouse-down starts the canvas drag-drop;
             double-click drops at the view center (FlowEditorView.xaml.cs). -->
        <DataTemplate x:Key="PaletteItem">
            <Border Background="Transparent"
                    Padding="8,7"
                    Margin="0,0,0,2"
                    Cursor="Hand"
                    ToolTip="{Binding Block.Description}"
                    MouseLeftButtonDown="OnPaletteItemMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Non-interactive drag-handle glyph column -->
                    <TextBlock Grid.Column="0"
                               Text="⠿"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,2"/>

                    <!-- Colored rounded-square icon chip -->
                    <Border Grid.Column="1"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{Binding AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="{Binding Block.Icon}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Block.Title}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Block.Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="30"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Purple Options-tab row: single click (or Enter) adds the option
             to the command and opens the options editor. Not canvas-draggable. -->
        <DataTemplate x:Key="OptionDefinitionItem">
            <Button Style="{StaticResource FlowPaletteRowButton}"
                    Padding="10,7"
                    Margin="0,0,0,2"
                    ToolTip="Adds this option to the command"
                    Command="{Binding DataContext.AddOptionFromDefinitionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource FlowPurpleBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="⚙"
                                   FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="30"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ValueHint, StringFormat=e.g. {0}}"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Purple Options-tab row, PARAMETERS group: single click adds the
             typed command parameter and opens the parameter editor. -->
        <DataTemplate x:Key="ParameterDefinitionItem">
            <Button Style="{StaticResource FlowPaletteRowButton}"
                    Padding="10,7"
                    Margin="0,0,0,2"
                    ToolTip="Adds this typed parameter to the command"
                    Command="{Binding DataContext.AddParameterFromDefinitionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource FlowVioletBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="{Binding Glyph}"
                                   FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="30"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding TypeKey, StringFormat=type: {0}}"
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Picks header vs block template for the grouped palette lists.
             Must be declared after both templates (StaticResource order). -->
        <views:PaletteRowTemplateSelector x:Key="PaletteRowSelector"
                                          HeaderTemplate="{StaticResource PaletteGroupHeader}"
                                          ItemTemplate="{StaticResource PaletteItem}"/>

        <!-- Full-width segmented palette tab bar: active = darker background +
             RED 2px underline (BotGhost pattern). -->
        <Style x:Key="PaletteTabButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="0,6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource FlowRedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One parameter row of the settings panel: the label (with a grey ❓
             whose tooltip is the field hint), then the field matching the
             ParamField kind (visibility-switched, same pattern as the
             AutomationView step rows). -->
        <DataTemplate x:Key="ParamRowTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text=" ❓"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding Hint}"
                               Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- text -->
                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- multiline -->
                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsMultiline, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- number -->
                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="OnNumericTextInput"
                         Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- boolean -->
                <CheckBox Content="Yes"
                          IsChecked="{Binding BoolValue, Mode=TwoWay}"
                          Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- select -->
                <ComboBox ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                          Visibility="{Binding IsSelect, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- role (editable fallback: pickers are empty without a connected bot) -->
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding RemoteOptions}"
                          Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsRole, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Pick a role (needs a connected bot) or type a role name/id"/>

                <!-- channel -->
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding RemoteOptions}"
                          Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsChannel, Converter={StaticResource BooleanToVisibilityConverter}}"
                          ToolTip="Pick a channel (needs a connected bot) or type a channel name"/>

                <!-- color -->
                <StackPanel Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 ToolTip="Hex color, e.g. #5865F2"/>
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0"
                                CornerRadius="3"
                                Background="{Binding ColorBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"/>
                    </Grid>
                    <ContentControl ContentTemplate="{StaticResource SwatchRowTemplate}" Focusable="False"/>
                </StackPanel>

                <!-- hint -->
                <TextBlock Text="{Binding Hint}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"
                           Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================
             Side-panel row templates (Variables / Error Logs / Commands &
             Events / Timed Events / Block Templates) — dark cards #2B2D42,
             1px #374151 borders, rounded 8.
             ============================================================ -->

        <!-- Variables row: name bold + mono {token} dim + origin badge chip. -->
        <DataTemplate x:Key="FlowVariableRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Token}"
                                   FontFamily="Consolas"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="8"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource FlowCardBorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Badge}" Value="Parameter">
                                        <Setter Property="Background" Value="{StaticResource FlowVioletBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="Flow">
                                        <Setter Property="Background" Value="{StaticResource FlowBlueBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="Built-in">
                                        <Setter Property="Background" Value="{StaticResource FlowGreenBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="Context">
                                        <Setter Property="Background" Value="{StaticResource FlowIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Badge}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Error Logs row: ⚠️ + title + relative time, message, trigger footer. -->
        <DataTemplate x:Key="FlowErrorRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="⚠️"
                               FontSize="14"
                               VerticalAlignment="Top"
                               Margin="0,0,9,0"/>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding RelativeTime}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource FlowGhostBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}"
                                   FontSize="11"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding TriggerSummary, StringFormat=Trigger: {0}}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Workflow row action buttons: ✏️ edit / ● toggle / 🗑️ delete. -->
        <DataTemplate x:Key="FlowWorkflowRowButtons">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="✏️"
                        Width="24" Height="24" FontSize="10"
                        Style="{StaticResource FlowIconButton}"
                        Background="{StaticResource FlowCardBorderBrush}"
                        Command="{Binding DataContext.EditPanelWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Edit this flow in the editor"/>
                <Button Content="●"
                        Width="24" Height="24" FontSize="9"
                        Style="{StaticResource FlowToggleDotButton}"
                        Margin="5,0,0,0"
                        Command="{Binding DataContext.TogglePanelWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Enable or disable this flow (reloads the triggers)"/>
                <Button Content="🗑️"
                        Width="24" Height="24" FontSize="10"
                        Style="{StaticResource FlowIconButton}"
                        Background="{StaticResource FlowCardBorderBrush}"
                        Foreground="{StaticResource FlowRedBrush}"
                        Margin="5,0,0,0"
                        Command="{Binding DataContext.DeletePanelWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Delete this flow"/>
            </StackPanel>
        </DataTemplate>

        <!-- Commands list row: /name bold + description dim + edit/toggle/delete. -->
        <DataTemplate x:Key="FlowWorkflowRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource FlowGreenBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="/" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Description}"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="28"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource FlowWorkflowRowButtons}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Events list row: same shape, blue ⚡ chip, trigger-kind sub-label. -->
        <DataTemplate x:Key="FlowEventRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource FlowBlueBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="⚡" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Description}"/>
                        <TextBlock Text="{Binding Description}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="28"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource FlowWorkflowRowButtons}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Timed Events row: name + "every N min" + toggle + edit (no delete). -->
        <DataTemplate x:Key="FlowTimerRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="6"
                            Background="{StaticResource FlowYellowBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0">
                        <TextBlock Text="🕐" FontSize="12" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding IntervalText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✏️"
                                Width="24" Height="24" FontSize="10"
                                Style="{StaticResource FlowIconButton}"
                                Background="{StaticResource FlowCardBorderBrush}"
                                Command="{Binding DataContext.EditPanelWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Edit this timed event in the editor"/>
                        <Button Content="●"
                                Width="24" Height="24" FontSize="9"
                                Style="{StaticResource FlowToggleDotButton}"
                                Margin="5,0,0,0"
                                Command="{Binding DataContext.TogglePanelWorkflowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Enable or disable this timed event (reloads the triggers)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Block Templates row: ⠿ drag handle + name + block title + ✕ delete.
             Mouse-down starts the canvas drag (or click-to-place — see
             FlowEditorView.xaml.cs). -->
        <DataTemplate x:Key="FlowTemplateRowTemplate">
            <Border Background="{StaticResource FlowCardBrush}"
                    BorderBrush="{StaticResource FlowCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6"
                    Cursor="Hand"
                    ToolTip="{Binding Description}"
                    MouseLeftButtonDown="OnTemplateRowMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource FlowCardBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="⠿"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,2"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding BlockTitle}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource FlowGhostBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="✕"
                            Width="20" Height="20" FontSize="9"
                            Style="{StaticResource FlowIconButton}"
                            Background="Transparent"
                            Foreground="{StaticResource FlowGhostBrush}"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.DeleteBlockTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="Delete this template"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ==================================================================
         ROOT: header strip / chips bar + three-pane body / bottom bar.
         PreviewMouseDown dismisses the stay-open popups (see code-behind).
         ================================================================== -->
    <Grid x:Name="EditorRoot" PreviewMouseDown="OnEditorRootPreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== HEADER / TOOLBAR ============================== -->
        <Border Grid.Row="0"
                Background="{StaticResource FlowPanelBrush}"
                BorderBrush="{DynamicResource BorderSecondaryBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + unsaved dot -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="VectorBezier"
                                             Width="20" Height="20"
                                             Foreground="{StaticResource FlowIndigoBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="FLOW EDITOR"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="●"
                               FontSize="14"
                               Foreground="{StaticResource FlowRedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,1,0,0"
                               ToolTip="Unsaved changes"
                               Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Flow name -->
                <TextBox Grid.Column="1"
                         Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Command or flow name"
                         ToolTip="Flow name (required to save)"/>

                <!-- Command Settings (right panel) / Options popup -->
                <Button x:Name="CommandSettingsButton"
                        Grid.Column="2"
                        Content="TRIGGER ▾"
                        Command="{Binding OpenCommandSettingsCommand}"
                        Style="{StaticResource FlowToolButton}"
                        Margin="10,0,0,0"
                        ToolTip="Open Command Settings — what starts this flow, its options and parameters"/>
                <Button x:Name="OptionsButton"
                        Grid.Column="3"
                        Content="OPTIONS ▾"
                        Click="OnOptionsButtonClick"
                        Style="{StaticResource FlowToolButton}"
                        Margin="8,0,0,0"
                        ToolTip="Cooldowns, permissions and channel scoping"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding TriggerSummaryText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TriggerSummaryText}"/>

                <!-- Undo / redo / enabled (zoom lives on the canvas's
                     bottom-left floating group now) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↶"
                            Command="{Binding UndoCommand}"
                            Style="{StaticResource FlowToolButton}"
                            Width="34"
                            ToolTip="Undo (Ctrl+Z)"/>
                    <Button Content="↷"
                            Command="{Binding RedoCommand}"
                            Style="{StaticResource FlowToolButton}"
                            Width="34"
                            Margin="6,0,0,0"
                            ToolTip="Redo (Ctrl+Shift+Z)"/>
                    <CheckBox Content="Enabled"
                              IsChecked="{Binding FlowEnabled}"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              ToolTip="Disabled flows never fire — flip this to arm the flow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== BODY: palette | canvas | settings ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="308"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: icon rail + side panel (BotGhost six-panel builder rail).
                 The ☰ in the panel header collapses the ENTIRE left side to
                 zero width (IsLeftCollapsed); a floating ☰ over the canvas
                 reopens it. The panel swaps content per SelectedPanelIndex. -->
            <Border Grid.Column="0"
                    Background="{StaticResource FlowPanelBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="396"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLeftCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ ICON RAIL (56px, darkest strip) ============ -->
                    <Border Grid.Column="0"
                            Background="{StaticResource FlowRailBrush}"
                            BorderBrush="{DynamicResource BorderSecondaryBrush}"
                            BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,10,0,0">
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="0"
                                    Style="{StaticResource FlowRailBlocksButton}"
                                    Background="{StaticResource FlowBlueBrush}"
                                    Content="🧊"
                                    ToolTip="Blocks — the block palette"/>
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="1"
                                    Style="{StaticResource FlowRailVariablesButton}"
                                    Background="{StaticResource FlowPinkBrush}"
                                    Content="&lt;/&gt;"
                                    FontSize="10.5" FontWeight="Bold"
                                    ToolTip="Variables — parameters, flow and built-in {tokens}"/>
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="2"
                                    Style="{StaticResource FlowRailErrorsButton}"
                                    Background="{StaticResource FlowRedBrush}"
                                    Content="⚠️"
                                    ToolTip="Error Logs — debugging information for your flows"/>
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="3"
                                    Style="{StaticResource FlowRailCommandsButton}"
                                    Background="{StaticResource FlowGreenBrush}"
                                    Content="🟢"
                                    ToolTip="Commands — your command and event flows"/>
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="4"
                                    Style="{StaticResource FlowRailTimersButton}"
                                    Background="{StaticResource FlowYellowBrush}"
                                    Content="🕐"
                                    ToolTip="Timed Events — flows that run on a schedule"/>
                            <Button Command="{Binding SelectRailPanelCommand}" CommandParameter="5"
                                    Style="{StaticResource FlowRailTemplatesButton}"
                                    Background="{StaticResource FlowPurpleBrush}"
                                    Content="🧱"
                                    ToolTip="Block Templates — reusable saved blocks"/>
                        </StackPanel>
                    </Border>

                    <!-- ============ PANEL (content swaps per rail icon) ============ -->
                    <Border Grid.Column="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Shared panel header: bold title + indigo hamburger -->
                            <Grid Grid.Row="0" Margin="12,10,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedPanelTitle}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="☰"
                                        Command="{Binding ToggleLeftPanelCommand}"
                                        Style="{StaticResource FlowIconButton}"
                                        Background="{StaticResource FlowIndigoBrush}"
                                        ToolTip="Collapse the side panel (the ☰ over the canvas reopens it)"/>
                            </Grid>

                            <!-- ==================== PANEL 0: BLOCKS ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                        <!-- Color-coded intro copy -->
                        <TextBlock Grid.Row="0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="12,0,12,8"
                                   LineHeight="17">
                            <Run Text="Drag and drop "/>
                            <Run Text="Options" Foreground="{StaticResource FlowPurpleBrush}" FontWeight="Bold"/>
                            <Run Text=", "/>
                            <Run Text="Actions" Foreground="{StaticResource FlowBlueBrush}" FontWeight="Bold"/>
                            <Run Text=" and "/>
                            <Run Text="Conditions" Foreground="{StaticResource FlowGreenBrush}" FontWeight="Bold"/>
                            <Run Text=" to add them to your command. Connect the corresponding colors to create your command flow."/>
                        </TextBlock>

                        <!-- Segmented tab bar: Options | Actions | Conditions -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource CardHoverBrush}"
                                CornerRadius="4"
                                Margin="10,0,10,8"
                                Padding="2">
                            <UniformGrid Columns="3">
                                <ToggleButton Content="OPTIONS"
                                              IsChecked="{Binding IsOptionsTab}"
                                              Style="{StaticResource PaletteTabButton}"/>
                                <ToggleButton Content="ACTIONS"
                                              IsChecked="{Binding IsActionsTab}"
                                              Style="{StaticResource PaletteTabButton}"/>
                                <ToggleButton Content="CONDITIONS"
                                              IsChecked="{Binding IsConditionsTab}"
                                              Style="{StaticResource PaletteTabButton}"/>
                            </UniformGrid>
                        </Border>

                        <!-- Search (filters all three tabs) -->
                        <TextBox Grid.Row="2"
                                 Text="{Binding PaletteSearch, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12"
                                 Margin="10,0,10,6"
                                 materialDesign:HintAssist.Hint="Search blocks…"/>

                        <!-- Options tab (purple): typed command parameters on
                             top, then the six constraint options -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,2,4"
                                      Visibility="{Binding IsOptionsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="COMMAND PARAMETERS"
                                           Style="{StaticResource FlowSectionHeader}"
                                           Margin="12,12,8,2"/>
                                <TextBlock Text="Typed arguments the command accepts — usable as {variables}."
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,8,4"/>
                                <ItemsControl ItemsSource="{Binding FilteredParameterDefinitions}"
                                              ItemTemplate="{StaticResource ParameterDefinitionItem}"/>
                                <TextBlock Text="No parameter types found"
                                           FontSize="11.5"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="12,8,8,0"
                                           Visibility="{Binding ParametersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Text="COMMAND OPTIONS"
                                           Style="{StaticResource FlowSectionHeader}"
                                           Margin="12,18,8,2"/>
                                <TextBlock Text="Cooldowns, permissions and channel scoping constraints."
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="12,0,8,4"/>
                                <ItemsControl ItemsSource="{Binding FilteredOptionDefinitions}"
                                              ItemTemplate="{StaticResource OptionDefinitionItem}"/>
                                <TextBlock Text="No options found"
                                           FontSize="11.5"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="12,10,8,0"
                                           Visibility="{Binding OptionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions tab (grouped) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,2,4"
                                      Visibility="{Binding IsActionsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding FilteredActionBlocks}"
                                              ItemTemplateSelector="{StaticResource PaletteRowSelector}"/>
                                <TextBlock Text="No blocks found"
                                           FontSize="11.5"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="12,10,8,0"
                                           Visibility="{Binding ActionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Conditions tab (grouped) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,2,4"
                                      Visibility="{Binding IsConditionsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding FilteredConditionBlocks}"
                                              ItemTemplateSelector="{StaticResource PaletteRowSelector}"/>
                                <TextBlock Text="No blocks found"
                                           FontSize="11.5"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="12,10,8,0"
                                           Visibility="{Binding ConditionsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>
                            </Grid>

                            <!-- ==================== PANEL 1: VARIABLES ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4">
                                    <StackPanel Margin="10,0,10,8">
                                        <TextBlock Text="View and manage variables used in your flow. Variables allow you to store and manipulate data throughout your command flow."
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                        <TextBox Text="{Binding VariableSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Margin="0,8,0,0"
                                                 materialDesign:HintAssist.Hint="Search variables…"/>
                                        <Button x:Name="CreateVariableButton"
                                                Content="+ Create New Variable"
                                                Command="{Binding BeginCreateVariableCommand}"
                                                Style="{StaticResource FlowPanelCtaButton}"
                                                Background="{StaticResource FlowIndigoBrush}"
                                                ToolTip="Adds a Set Variable block with this name to your flow"/>
                                        <ItemsControl ItemsSource="{Binding FlowVariables}"
                                                      ItemTemplate="{StaticResource FlowVariableRowTemplate}"
                                                      Margin="0,8,0,0"/>
                                        <TextBlock Text="No variables match your search."
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="2,10,0,0"
                                                   Visibility="{Binding VariablesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ==================== PANEL 2: ERROR LOGS ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4">
                                    <StackPanel Margin="10,0,10,8">
                                        <TextBlock Text="View error logs and debugging information for your flow."
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                        <Button Content="⟳ REFRESH"
                                                Command="{Binding RefreshErrorLogsCommand}"
                                                IsEnabled="{Binding IsLoadingErrorLogs, Converter={StaticResource InvertBooleanConverter}}"
                                                Style="{StaticResource FlowPrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,10,0,0"
                                                ToolTip="Re-query the recent failed runs"/>
                                        <ItemsControl ItemsSource="{Binding ErrorLogs}"
                                                      ItemTemplate="{StaticResource FlowErrorRowTemplate}"
                                                      Margin="0,8,0,0"/>
                                        <TextBlock Text="Loading error logs…"
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="2,10,0,0"
                                                   Visibility="{Binding IsLoadingErrorLogs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="No errors — nice."
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource FlowGhostBrush}"
                                                   Margin="2,10,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ErrorLogsEmpty}" Value="True"/>
                                                                <Condition Binding="{Binding IsLoadingErrorLogs}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ==================== PANEL 3: COMMANDS ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Segmented tabs: Commands | Events -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CardHoverBrush}"
                                        CornerRadius="4"
                                        Margin="10,0,10,8"
                                        Padding="2">
                                    <UniformGrid Columns="2">
                                        <ToggleButton Content="COMMANDS"
                                                      IsChecked="{Binding IsCommandListTab}"
                                                      Style="{StaticResource PaletteTabButton}"/>
                                        <ToggleButton Content="EVENTS"
                                                      IsChecked="{Binding IsEventListTab}"
                                                      Style="{StaticResource PaletteTabButton}"/>
                                    </UniformGrid>
                                </Border>

                                <TextBox Grid.Row="1"
                                         Text="{Binding CommandSearch, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         Margin="10,0,10,6"
                                         materialDesign:HintAssist.Hint="Search by name…"/>

                                <Button Grid.Row="2"
                                        Content="+ New Command"
                                        Command="{Binding StartNewCommandCommand}"
                                        Style="{StaticResource FlowPanelCtaButton}"
                                        Background="{StaticResource FlowIndigoBrush}"
                                        Margin="10,0,10,8"
                                        ToolTip="Starts a brand-new flow with a prefix-command trigger"/>

                                <Grid Grid.Row="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4"
                                                  Visibility="{Binding IsCommandListTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="10,0,10,8">
                                            <ItemsControl ItemsSource="{Binding FilteredPanelCommands}"
                                                          ItemTemplate="{StaticResource FlowWorkflowRowTemplate}"/>
                                            <TextBlock Text="No commands yet — create one above."
                                                       FontSize="11.5"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="2,10,0,0"
                                                       Visibility="{Binding PanelCommandsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4"
                                                  Visibility="{Binding IsEventListTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Margin="10,0,10,8">
                                            <ItemsControl ItemsSource="{Binding FilteredPanelEvents}"
                                                          ItemTemplate="{StaticResource FlowEventRowTemplate}"/>
                                            <TextBlock Text="No event flows yet."
                                                       FontSize="11.5"
                                                       FontStyle="Italic"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="2,10,0,0"
                                                       Visibility="{Binding PanelEventsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- ==================== PANEL 4: TIMED EVENTS ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="4">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4">
                                    <StackPanel Margin="10,0,10,8">
                                        <TextBlock Text="Create timed events that run your flow on a schedule or interval."
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                        <Button Content="Add New Timed Event"
                                                Command="{Binding StartNewTimedEventCommand}"
                                                Style="{StaticResource FlowPanelCtaButton}"
                                                Background="{StaticResource FlowYellowBrush}"
                                                ToolTip="Starts a brand-new flow with a timer trigger (5 min default)"/>
                                        <TextBlock Text="{Binding ActiveTimersCount, StringFormat=ACTIVE TIMERS ({0})}"
                                                   Style="{StaticResource FlowSectionHeader}"
                                                   Margin="2,14,0,4"/>
                                        <ItemsControl ItemsSource="{Binding FilteredPanelTimers}"
                                                      ItemTemplate="{StaticResource FlowTimerRowTemplate}"
                                                      Margin="0,2,0,0"/>
                                        <TextBlock Text="No timed events yet."
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="2,10,0,0"
                                                   Visibility="{Binding PanelTimersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ==================== PANEL 5: BLOCK TEMPLATES ==================== -->
                            <Grid Grid.Row="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPanelIndex}" Value="5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,4">
                                    <StackPanel Margin="10,0,10,8">
                                        <TextBlock Text="Click and drag a saved block template onto your tree."
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"/>
                                        <TextBox Text="{Binding TemplateSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Margin="0,8,0,0"
                                                 materialDesign:HintAssist.Hint="Search templates…"/>
                                        <Button x:Name="SaveTemplateButton"
                                                Content="Save Selected Block"
                                                Command="{Binding BeginSaveBlockTemplateCommand}"
                                                IsEnabled="{Binding HasSelectedNode}"
                                                Style="{StaticResource FlowPanelCtaButton}"
                                                Background="{StaticResource FlowIndigoBrush}"
                                                ToolTip="Saves the block selected on the canvas (type, label and settings)"/>
                                        <ItemsControl ItemsSource="{Binding BlockTemplates}"
                                                      ItemTemplate="{StaticResource FlowTemplateRowTemplate}"
                                                      Margin="0,8,0,0"/>
                                        <TextBlock Text="No saved templates yet — select a block on the canvas and save it."
                                                   FontSize="11.5"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="2,10,0,0"
                                                   Visibility="{Binding BlockTemplatesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Red "save your changes" bar (bottom of the panel; only when dirty) -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource ErrorHoverBrush}"
                                    Padding="10,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Please save your changes!"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Content="Save Changes"
                                            Command="{Binding SaveCommand}"
                                            Style="{StaticResource FlowSaveBarWhiteButton}"
                                            ToolTip="Persist the flow and reload the triggers (Ctrl+S)"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CENTER: node canvas + floating zoom group. The old purple
                 options / violet parameter chips bar is gone — options and
                 parameters now live in the right panel's Command Settings,
                 and typed parameters render as cards on the canvas itself. -->
            <Grid Grid.Column="1">
                <!-- The node canvas -->
                <flow:FlowCanvasControl x:Name="FlowCanvas"/>

                    <!-- Floating ☰ that reopens the collapsed left side
                         (rail + panel) — the only survivor of the collapse -->
                    <Button Content="☰"
                            Command="{Binding ToggleLeftPanelCommand}"
                            Style="{StaticResource FlowIconButton}"
                            Background="{StaticResource FlowIndigoBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            ToolTip="Open the side panel"
                            Visibility="{Binding IsLeftCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Floating zoom group, canvas bottom-left (sits above the
                         canvas control's own vertical button pair) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12,0,0,64"
                                Effect="{DynamicResource CardShadow}">
                        <Button Content="−"
                                Command="{Binding ZoomOutCommand}"
                                Style="{StaticResource FlowZoomButton}"
                                ToolTip="Zoom out"/>
                        <Border Background="White"
                                CornerRadius="4"
                                Margin="4,0"
                                MinWidth="44">
                            <TextBlock Text="{Binding Zoom, ElementName=FlowCanvas, StringFormat={}{0:P0}}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource FlowInkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="+"
                                Command="{Binding ZoomInCommand}"
                                Style="{StaticResource FlowZoomButton}"
                                ToolTip="Zoom in"/>
                        <Button Content="FIT"
                                Command="{Binding FitToScreenCommand}"
                                Style="{StaticResource FlowZoomButton}"
                                Margin="8,0,0,0"
                                ToolTip="Frame every node"/>
                    </StackPanel>
            </Grid>

            <!-- RIGHT: settings panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BackgroundSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                <!-- ============ MODE: BLOCK (selected-node settings) ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsBlockSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="14,12,14,16">

                        <!-- Panel header: bold title + red rounded-square ✕ -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Block Settings"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✕"
                                    Command="{Binding CloseSettingsPanelCommand}"
                                    Style="{StaticResource FlowIconButton}"
                                    Background="{StaticResource FlowRedBrush}"
                                    FontSize="11"
                                    ToolTip="Close this panel (deselect the node)"/>
                        </Grid>

                        <!-- Block header: icon chip + bold title + grey description -->
                        <Border Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34"
                                            CornerRadius="8"
                                            Background="{Binding SelectedBlockBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedBlock.Icon}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedBlock.Title}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedBlock.Description}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource FlowGhostBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Label -->
                        <TextBlock Text="Label" Style="{StaticResource FlowFieldLabel}"/>
                        <TextBox Text="{Binding SelectedNode.Label, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Name shown on the canvas node (double-click the node to rename in place)"/>

                        <!-- ============ Parameter fields ============ -->
                        <TextBlock Text="PARAMETERS" Style="{StaticResource FlowSectionHeader}" Margin="0,16,0,2"
                                   Visibility="{Binding HasParamRows, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding ParamRows}"
                                      ItemTemplate="{StaticResource ParamRowTemplate}"
                                      Margin="0,2,0,0"/>

                        <!-- ============ MESSAGE BUILDER (embed) ============ -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasEmbedParam, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,2">
                                        <Run Text="Message Builder "/>
                                        <Run Text="✅" Foreground="{StaticResource FlowGreenBrush}"/>
                                    </TextBlock>

                                    <TextBlock Text="Title" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.Title, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Description" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <TextBlock Text="Color" Style="{StaticResource FlowFieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding EmbedBuilder.ColorHex, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 ToolTip="Hex color, e.g. #5865F2"/>
                                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0"
                                                CornerRadius="3"
                                                Background="{Binding EmbedBuilder.PreviewBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1"/>
                                    </Grid>
                                    <ContentControl ContentTemplate="{StaticResource SwatchRowTemplate}"
                                                    DataContext="{Binding EmbedBuilder}"
                                                    Focusable="False"/>

                                    <TextBlock Text="Footer" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.Footer, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Image URL" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.ImageUrl, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Thumbnail URL" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.ThumbnailUrl, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Author name" Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding EmbedBuilder.AuthorName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Fields list -->
                                    <Grid Margin="0,14,0,0">
                                        <TextBlock Text="FIELDS" Style="{StaticResource FlowSectionLabel}" VerticalAlignment="Center"/>
                                        <Button Content="+ ADD"
                                                Command="{Binding EmbedBuilder.AddFieldCommand}"
                                                Style="{StaticResource FlowToolButton}"
                                                Height="24" Padding="8,0" FontSize="10.5"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding EmbedBuilder.Fields}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="5,3" FontSize="11.5"
                                                             materialDesign:HintAssist.Hint="Name"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="5,3" FontSize="11.5" Margin="5,0,0,0"
                                                             materialDesign:HintAssist.Hint="Value"/>
                                                    <CheckBox Grid.Column="2" Content="Inline"
                                                              IsChecked="{Binding Inline}"
                                                              FontSize="10.5"
                                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <Button Grid.Column="3" Content="✕"
                                                            Command="{Binding DataContext.EmbedBuilder.RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FlowCloseButton}" Height="24" Padding="6,0" FontSize="10.5"
                                                            Margin="4,0,0,0"
                                                            ToolTip="Remove this field"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- LIVE PREVIEW (Discord-style) -->
                                    <TextBlock Text="PREVIEW" Style="{StaticResource FlowSectionLabel}" Margin="0,14,0,4"/>
                                    <Border Background="{StaticResource FlowInputBgBrush}"
                                            BorderBrush="{Binding EmbedBuilder.PreviewBrush}"
                                            BorderThickness="4,0,0,0"
                                            CornerRadius="4"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EmbedBuilder.AuthorName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding EmbedBuilder.AuthorName, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding EmbedBuilder.Title}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="White" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding EmbedBuilder.Title, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding EmbedBuilder.Description}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding EmbedBuilder.Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <ItemsControl ItemsSource="{Binding EmbedBuilder.Fields}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="150" Margin="0,0,12,6">
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding EmbedBuilder.Footer}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding EmbedBuilder.Footer, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="Nothing to preview yet — start with a title or description."
                                                       FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding EmbedBuilder.Title}" Value=""/>
                                                                    <Condition Binding="{Binding EmbedBuilder.Description}" Value=""/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ CONDITION BUILDER ============ -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasRuleParam, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel DataContext="{Binding ConditionBuilder}">
                                    <TextBlock Text="CONDITION" Style="{StaticResource FlowSectionHeader}" Margin="0,0,0,2"/>

                                    <ComboBox ItemsSource="{Binding Modes}"
                                              SelectedItem="{Binding Mode}"
                                              Margin="0,8,0,0"/>

                                    <!-- Simple mode -->
                                    <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                                 Margin="0,8,0,0"
                                                 ToolTip="Guard expression — rule JSON may appear here after switching modes"/>
                                        <TextBlock Text="Plain expression, e.g. {coins} &gt; 100 — rule-builder output is stored here as JSON too."
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Rule builder mode -->
                                    <StackPanel Visibility="{Binding IsBuilderMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Match" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding Combinators}"
                                                      SelectedItem="{Binding Combinator}"
                                                      MinWidth="80"/>
                                            <TextBlock Text="of the rules below"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardHoverBrush}"
                                                            BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox ItemsSource="{Binding TypeChoices}"
                                                                          SelectedItem="{Binding Type}"/>
                                                                <Button Grid.Column="1" Content="✕"
                                                                        Command="{Binding DataContext.ConditionBuilder.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource FlowCloseButton}" Height="26" Padding="7,0" FontSize="10.5"
                                                                        Margin="6,0,0,0"
                                                                        ToolTip="Remove this rule"/>
                                                            </Grid>

                                                            <!-- role -->
                                                            <ComboBox IsEditable="True"
                                                                      ItemsSource="{Binding RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      Text="{Binding RoleId, UpdateSourceTrigger=PropertyChanged}"
                                                                      Padding="5,3" FontSize="11.5"
                                                                      Margin="0,6,0,0"
                                                                      Visibility="{Binding IsRole, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                      ToolTip="Role name or id (editable when no bot is connected)"/>

                                                            <!-- message contains -->
                                                            <StackPanel Visibility="{Binding IsMessageContains, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="5,3" FontSize="11.5"
                                                                         Margin="0,6,0,0"
                                                                         materialDesign:HintAssist.Hint="Contains text"/>
                                                                <CheckBox Content="Case sensitive"
                                                                          IsChecked="{Binding CaseSensitive}"
                                                                          FontSize="10.5"
                                                                          Margin="0,4,0,0"/>
                                                            </StackPanel>

                                                            <!-- variable equals -->
                                                            <StackPanel Visibility="{Binding IsVariableEquals, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="5,3" FontSize="11.5" FontFamily="Consolas"
                                                                         Margin="0,6,0,0"
                                                                         materialDesign:HintAssist.Hint="Variable name"/>
                                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="5,3" FontSize="11.5"
                                                                         Margin="0,4,0,0"
                                                                         materialDesign:HintAssist.Hint="Equals value (supports {variables})"/>
                                                            </StackPanel>

                                                            <!-- variable exists -->
                                                            <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Padding="5,3" FontSize="11.5" FontFamily="Consolas"
                                                                     Margin="0,6,0,0"
                                                                     materialDesign:HintAssist.Hint="Variable name"
                                                                     Visibility="{Binding IsVariableExists, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                            <!-- time between -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                                        Visibility="{Binding IsTimeBetween, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox Text="{Binding StartHour, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="50" Padding="5,3" FontSize="11.5"
                                                                         PreviewTextInput="OnNumericTextInput"
                                                                         materialDesign:HintAssist.Hint="0-23"/>
                                                                <TextBlock Text="to" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" Margin="6,0"/>
                                                                <TextBox Text="{Binding EndHour, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="50" Padding="5,3" FontSize="11.5"
                                                                         PreviewTextInput="OnNumericTextInput"
                                                                         materialDesign:HintAssist.Hint="0-23"/>
                                                            </StackPanel>

                                                            <!-- user is bot (no fields) -->
                                                            <TextBlock Text="Passes when the triggering user is a bot account."
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,6,0,0"
                                                                       Visibility="{Binding IsUserIsBot, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                            <!-- channel is -->
                                                            <TextBox Text="{Binding ChannelName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Padding="5,3" FontSize="11.5"
                                                                     Margin="0,6,0,0"
                                                                     materialDesign:HintAssist.Hint="Channel name"
                                                                     Visibility="{Binding IsChannelIs, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ ADD CONDITION"
                                                Command="{Binding AddRowCommand}"
                                                Style="{StaticResource FlowToolButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ COMPARISON RULES (comparison node) ============ -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasComparisonsParam, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMPARISONS" Style="{StaticResource FlowSectionHeader}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Rules run top to bottom — the first match takes its branch (each rule gets its own green card under the node). Nothing matches → Else."
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,4"/>

                                    <ItemsControl ItemsSource="{Binding ComparisonBuilder.Rows}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Left, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Padding="5,3" FontSize="11.5"
                                                                     materialDesign:HintAssist.Hint="Left value — e.g. {args} or 10"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding DataContext.ComparisonBuilder.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlowCloseButton}" Height="26" Padding="7,0" FontSize="10.5"
                                                                    Margin="6,0,0,0"
                                                                    ToolTip="Remove this comparison"/>
                                                        </Grid>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox ItemsSource="{Binding OperatorChoices}"
                                                                      SelectedItem="{Binding SelectedOperator}"
                                                                      MinWidth="130"
                                                                      ToolTip="Operator"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Padding="5,3" FontSize="11.5" Margin="6,0,0,0"
                                                                     materialDesign:HintAssist.Hint="Right value — e.g. 5"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ ADD COMPARISON"
                                            Command="{Binding ComparisonBuilder.AddRuleCommand}"
                                            IsEnabled="{Binding ComparisonBuilder.CanAddRule}"
                                            Style="{StaticResource FlowToolButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0"
                                            ToolTip="Add a comparison rule (max 10) — it gets its own case card on the canvas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ BUTTONS & MENUS (message nodes) ============ -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasComponentSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="BUTTONS &amp; MENUS" Style="{StaticResource FlowSectionHeader}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Attach Discord components to this message. After SAVE every button / menu runs its own sub-flow — click the chip on the canvas node to edit it."
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,4"/>

                                    <!-- Buttons -->
                                    <ItemsControl ItemsSource="{Binding ComponentButtons}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8"
                                                        Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="Button label"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding DataContext.RemoveComponentButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlowCloseButton}" Height="26" Padding="7,0" FontSize="10.5"
                                                                    Margin="6,0,0,0"
                                                                    ToolTip="Remove this button (and its sub-flow on next save)"/>
                                                        </Grid>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox ItemsSource="{Binding DataContext.ComponentButtonStyles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding Style}"
                                                                      MinWidth="104"
                                                                      ToolTip="Discord button style"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Emoji, UpdateSourceTrigger=PropertyChanged}"
                                                                     Margin="6,0,0,0"
                                                                     materialDesign:HintAssist.Hint="Emoji (optional)"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ ADD BUTTON"
                                            Command="{Binding AddComponentButtonCommand}"
                                            Style="{StaticResource FlowToolButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0"
                                            ToolTip="Add a button (max 5) — it gets its own clickable sub-flow on the canvas"/>

                                    <!-- Select menu -->
                                    <TextBlock Text="SELECT MENU" Style="{StaticResource FlowSectionLabel}" Margin="0,14,0,2"/>
                                    <TextBox Text="{Binding ComponentMenu.Placeholder, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                             materialDesign:HintAssist.Hint="Placeholder text"
                                             Visibility="{Binding HasComponentMenu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="No select menu yet — add one to offer up to 25 choices."
                                               FontSize="10.5"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasComponentMenu, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding ComponentMenu.Options}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasComponentMenu, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="5,3" FontSize="11.5"
                                                             materialDesign:HintAssist.Hint="Label"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="5,3" FontSize="11.5" Margin="5,0,0,0"
                                                             materialDesign:HintAssist.Hint="Value"/>
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding DataContext.RemoveComponentMenuOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FlowCloseButton}" Height="26" Padding="7,0" FontSize="10.5"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Remove this option"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="+ ADD OPTION"
                                            Command="{Binding AddComponentMenuOptionCommand}"
                                            Style="{StaticResource FlowToolButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0"
                                            ToolTip="Add a select-menu option (max 25)"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ Block actions ============ -->
                        <TextBlock Text="ACTIONS" Style="{StaticResource FlowSectionHeader}" Margin="0,18,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DuplicateSelectedBlockCommand}"
                                    Style="{StaticResource FlowActionButton}"
                                    ToolTip="Copy this block (+24/+24, fresh id, no wires)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                             Foreground="{StaticResource FlowIndigoFocusBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="DUPLICATE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedBlockCommand}"
                                    Background="Transparent"
                                    Style="{StaticResource FlowActionButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="Remove this block and its wires">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13"
                                                             Foreground="{StaticResource FlowRedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="DELETE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ MODE: COMMAND (flow-wide settings) ============
                     Opened by the canvas trigger card, the toolbar TRIGGER
                     button and the purple OPTIONS-tab entries. Shows the flow
                     name + enabled flag, the full trigger editor (moved out of
                     the retired TRIGGER popup), the command options list and
                     the typed parameters list. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsCommandMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="14,12,14,16">

                        <!-- Panel header: amber ⚡ + title + red rounded-square ✕ -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        CornerRadius="8"
                                        Background="{StaticResource FlowYellowBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Command Settings"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding TriggerSummaryText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource FlowGhostBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Command="{Binding CloseSettingsPanelCommand}"
                                    Style="{StaticResource FlowIconButton}"
                                    Background="{StaticResource FlowRedBrush}"
                                    FontSize="11"
                                    VerticalAlignment="Top"
                                    ToolTip="Close this panel"/>
                        </Grid>

                        <!-- Flow identity -->
                        <TextBlock Text="Name" Style="{StaticResource FlowFieldLabel}"/>
                        <TextBox Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Command or flow name"
                                 ToolTip="Flow name (required to save)"/>
                        <CheckBox Content="Enabled"
                                  IsChecked="{Binding FlowEnabled}"
                                  Margin="0,10,0,0"
                                  ToolTip="Disabled flows never fire — flip this to arm the flow"/>

                        <!-- ============ TRIGGER (moved from the retired popup) ============ -->
                        <StackPanel Margin="0,14,0,0">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="TRIGGER" Style="{StaticResource FlowSectionHeader}"/>
                                    <TextBlock Text="What starts this flow"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>

                                    <TextBlock Text="Type" Style="{StaticResource FlowFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding TriggerTypes}"
                                              SelectedItem="{Binding SelectedTriggerType}"/>

                                    <!-- command / slash / mod: name + prefix -->
                                    <StackPanel Visibility="{Binding IsTriggerNeedsCommandName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Command name" Style="{StaticResource FlowFieldLabel}"/>
                                        <TextBox Text="{Binding TriggerCommandName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 materialDesign:HintAssist.Hint="hello"/>
                                        <TextBlock Text="Prefix" Style="{StaticResource FlowFieldLabel}"/>
                                        <TextBox Text="{Binding TriggerCommandPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" Width="70"
                                                 HorizontalAlignment="Left"
                                                 materialDesign:HintAssist.Hint="!"/>

                                        <!-- mod command only: the tier ladder gating who may run it -->
                                        <StackPanel Visibility="{Binding IsTriggerModCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Minimum tier" Style="{StaticResource FlowFieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding TierOptions}"
                                                      SelectedItem="{Binding TriggerMinimumTier}"
                                                      MinWidth="140"
                                                      HorizontalAlignment="Left"
                                                      ToolTip="Lowest mod tier that may run this command (TrialMod &lt; Mod &lt; SeniorMod &lt; Admin)"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- button / select hint -->
                                    <Border Background="{DynamicResource CardHoverBrush}"
                                            CornerRadius="4" Padding="10,8" Margin="0,12,0,0"
                                            Visibility="{Binding IsTriggerButtonOrSelect, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding TriggerComponentHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- event -->
                                    <StackPanel Visibility="{Binding IsTriggerEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Event type" Style="{StaticResource FlowFieldLabel}"/>
                                        <!-- Editable so a legacy/aliased value still displays; the
                                             dropdown only offers types WorkflowTriggerService dispatches. -->
                                        <ComboBox IsEditable="True"
                                                  ItemsSource="{Binding TriggerEventTypeOptions}"
                                                  Text="{Binding TriggerEventType, UpdateSourceTrigger=PropertyChanged}"
                                                  materialDesign:HintAssist.Hint="follow, subscribe, resub, giftsub, raid, cheer, host"/>
                                        <TextBlock Text="Platform" Style="{StaticResource FlowFieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding PlatformOptions}"
                                                  SelectedItem="{Binding TriggerPlatform}"
                                                  MinWidth="140"
                                                  HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- timer -->
                                    <StackPanel Visibility="{Binding IsTriggerTimer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Interval (minutes)" Style="{StaticResource FlowFieldLabel}"/>
                                        <TextBox Text="{Binding TriggerIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="90"
                                                 HorizontalAlignment="Left"
                                                 PreviewTextInput="OnNumericTextInput"/>
                                    </StackPanel>

                                    <!-- manual -->
                                    <TextBlock Text="Manual — runs only from the TEST RUN button or the Automation page."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"
                                               Visibility="{Binding IsTriggerManual, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <TextBlock Text="Description / slash description (stored on the flow)"
                                               Style="{StaticResource FlowFieldLabel}"/>
                                    <TextBox Text="{Binding TriggerDescription, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="What this flow does in one line"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ COMMAND OPTIONS (moved from the retired popup) ============ -->
                        <StackPanel Margin="0,14,0,0">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMMAND OPTIONS" Style="{StaticResource FlowSectionHeader}"/>
                                    <TextBlock Text="Cooldowns, permissions and channel scoping"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>

                                    <ItemsControl ItemsSource="{Binding OptionRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource FlowCardBrush}"
                                                        BorderBrush="{StaticResource FlowCardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8"
                                                        Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox ItemsSource="{Binding DataContext.OptionTypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding Type}"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlowCloseButton}" Height="28" Padding="7,0" FontSize="10.5"
                                                                    Margin="8,0,0,0"
                                                                    ToolTip="Remove this option"/>
                                                        </Grid>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Margin="0,6,0,0"
                                                                 Visibility="{Binding IsFlagOnly, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No options yet — every run is unconstrained."
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding HasNoOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Button Content="+ ADD OPTION"
                                            Command="{Binding AddOptionCommand}"
                                            Style="{StaticResource FlowToolButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ COMMAND PARAMETERS (moved from the retired popup) ============ -->
                        <StackPanel Margin="0,14,0,0">
                            <Border BorderBrush="{DynamicResource BorderSecondaryBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="PARAMETERS" Style="{StaticResource FlowSectionHeader}"/>
                                    <TextBlock Text="Typed arguments the command accepts — Discord fills them in; use them as {variables}. New ones are added from the purple OPTIONS tab or by clicking a canvas parameter card."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,4"/>

                                    <ItemsControl ItemsSource="{Binding ParameterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource FlowCardBrush}"
                                                        BorderBrush="{StaticResource FlowCardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8"
                                                        Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     materialDesign:HintAssist.Hint="Name"/>
                                                            <Button Grid.Column="1" Content="✕"
                                                                    Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FlowCloseButton}" Height="28" Padding="7,0" FontSize="10.5"
                                                                    Margin="8,0,0,0"
                                                                    ToolTip="Remove this parameter"/>
                                                        </Grid>
                                                        <Grid Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding TypeLabel}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource FlowVioletBrush}"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="Parameter type (set when the parameter was added)"/>
                                                            <CheckBox Grid.Column="1" Content="Required"
                                                                      IsChecked="{Binding Required}"
                                                                      FontSize="10.5"
                                                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,6,0,0"
                                                                 materialDesign:HintAssist.Hint="Description"/>
                                                        <TextBlock Text="{Binding NormalizedName, StringFormat=name sent to Discord: {0}}"
                                                                   FontSize="10"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding HasNormalizedHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No parameters yet — add them from the purple OPTIONS tab (COMMAND PARAMETERS)."
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding HasNoParameters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ MODE: PARAMETER (one typed parameter) ============
                     Opened by clicking a parameter card on the canvas. Edits
                     mark the flow dirty and repaint the card live. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsParameterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="14,12,14,16">

                        <!-- Panel header: violet ◈ + title + red rounded-square ✕ -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34"
                                        CornerRadius="8"
                                        Background="{StaticResource FlowVioletBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="◈" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Parameter Settings"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedParameter.TypeLabel}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource FlowGhostBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕"
                                    Command="{Binding CloseSettingsPanelCommand}"
                                    Style="{StaticResource FlowIconButton}"
                                    Background="{StaticResource FlowRedBrush}"
                                    FontSize="11"
                                    VerticalAlignment="Top"
                                    ToolTip="Close this panel"/>
                        </Grid>

                        <!-- Name -->
                        <TextBlock Text="Name" Style="{StaticResource FlowFieldLabel}"/>
                        <TextBox Text="{Binding SelectedParameter.Name, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="amount"
                                 ToolTip="Renaming updates the canvas card and the {variable} token"/>

                        <!-- Type (read-only — set when the parameter was added) -->
                        <TextBlock Text="Type" Style="{StaticResource FlowFieldLabel}"/>
                        <Border Background="{StaticResource FlowCardBrush}"
                                BorderBrush="{StaticResource FlowCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,5"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedParameter.TypeLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource FlowVioletBrush}"
                                       ToolTip="Parameter type (set when the parameter was added)"/>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="Description" Style="{StaticResource FlowFieldLabel}"/>
                        <TextBox Text="{Binding SelectedParameter.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="54"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:HintAssist.Hint="What this parameter is for"/>

                        <!-- Required -->
                        <CheckBox Content="Required"
                                  IsChecked="{Binding SelectedParameter.Required}"
                                  Margin="0,12,0,0"
                                  ToolTip="The command refuses to run without it"/>

                        <TextBlock Text="{Binding SelectedParameter.NormalizedName, StringFormat=name sent to Discord: {0}}"
                                   FontSize="10.5"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SelectedParameter.HasNormalizedHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Remove -->
                        <Button Content="Remove Parameter"
                                Command="{Binding RemoveParameterCommand}"
                                CommandParameter="{Binding SelectedParameter}"
                                Style="{StaticResource FlowPanelCtaButton}"
                                Background="{StaticResource FlowRedBrush}"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,2"
                                ToolTip="Removes this parameter from the flow"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ MODE: NONE (help card) ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSettingsIdle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="16,14,16,16">
                        <TextBlock Text="BLOCK SETTINGS" Style="{StaticResource FlowSectionHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Select a node on the canvas to edit its settings."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Border Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="HOW IT WORKS" Style="{StaticResource FlowSectionLabel}"/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="• Drag a block from the left palette onto the canvas (or double-click it)."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Click a purple Options entry to add an option or parameter — it opens Command Settings on the right."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Click the amber trigger card (or TRIGGER ▾) to edit the flow in Command Settings."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Click a parameter card above the canvas to edit that parameter on the right."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Drag from a colored port at the bottom of a node to another node to wire them."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Click a node to edit it here; double-click its title to rename it."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Delete removes a selected node (wires are locked — disconnect one via its ⊗ midpoint marker). Ctrl+D duplicates a node."/>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="• Drag empty canvas to pan, mouse wheel to zoom, FIT frames everything."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="VARIABLES" Style="{StaticResource FlowSectionLabel}" Margin="0,16,0,2"/>
                        <TextBlock Text="Drop these into any text field — they fill in at run time (Set Variable blocks add their own)."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding VariableCheatSheet}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardHoverBrush}"
                                            BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="7,3"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource FlowIndigoFocusBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== BOTTOM BAR ============================== -->
        <Border Grid.Row="2"
                Background="{StaticResource FlowPanelBrush}"
                BorderBrush="{DynamicResource BorderSecondaryBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource FlowPrimaryButton}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                        ToolTip="Persist the flow and reload the triggers (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="13" Height="13"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="SAVE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Command="{Binding TestRunCommand}"
                        Style="{StaticResource FlowActionButton}"
                        Margin="8,0,0,0"
                        ToolTip="Fire this flow right now without saving">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Play" Width="13" Height="13"
                                                 Foreground="{StaticResource FlowGreenBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="TEST RUN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding ExportJsonCommand}"
                        Style="{StaticResource FlowActionButton}"
                        Margin="8,0,0,0"
                        ToolTip="Save the flow as a portable .flow.json file">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="13" Height="13"
                                                 Foreground="{StaticResource FlowGhostBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="EXPORT" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding ImportJsonCommand}"
                        Style="{StaticResource FlowActionButton}"
                        Margin="8,0,0,0"
                        ToolTip="Load a flow from a .flow.json file">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Import" Width="13" Height="13"
                                                 Foreground="{StaticResource FlowGhostBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="IMPORT" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Command="{Binding ShareToMarketplaceCommand}"
                        Style="{StaticResource FlowActionButton}"
                        Margin="8,0,0,0"
                        ToolTip="Publish this flow to the command marketplace (gets a share code)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShareVariant" Width="13" Height="13"
                                                 Foreground="{StaticResource FlowGreenBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="SHARE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="5"
                        Command="{Binding CopyOfflineCodeCommand}"
                        Style="{StaticResource FlowActionButton}"
                        Margin="8,0,0,0"
                        ToolTip="Copy a self-contained share code (imports with no internet)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="13" Height="13"
                                                 Foreground="{StaticResource FlowGhostBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="OFFLINE CODE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="6"
                           Text="{Binding StatusText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"/>

                <Button Grid.Column="7" Content="✕ CLOSE"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource FlowCloseButton}"
                        ToolTip="Close the editor (unsaved work is auto-saved as a draft)"/>
            </Grid>
        </Border>

        <!-- ============================== OPTIONS POPUP ============================== -->
        <Popup x:Name="OptionsPopup"
               IsOpen="{Binding IsOptionsPopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=OptionsButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource FlowPanelBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Width="430"
                    Margin="0,4,0,0"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="COMMAND OPTIONS" Style="{StaticResource FlowSectionHeader}"/>
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ClosePopupsCommand}"
                                Style="{StaticResource FlowIconButton}"
                                Background="{StaticResource FlowRedBrush}"
                                FontSize="11"
                                ToolTip="Close"/>
                    </Grid>
                    <TextBlock Text="Cooldowns, permissions and channel scoping"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"/>

                    <ItemsControl ItemsSource="{Binding OptionRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.OptionTypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Type}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Margin="8,0,0,0"
                                             Visibility="{Binding IsFlagOnly, Converter={StaticResource InvertBooleanToVisibilityConverter}}"/>
                                    <Button Grid.Column="2" Content="✕"
                                            Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FlowCloseButton}" Height="28" Padding="7,0" FontSize="10.5"
                                            Margin="8,0,0,0"
                                            ToolTip="Remove this option"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No options yet — every run is unconstrained."
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasNoOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="+ ADD OPTION"
                            Command="{Binding AddOptionCommand}"
                            Style="{StaticResource FlowToolButton}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================== CREATE VARIABLE POPUP ==============================
             Small stay-open prompt for the Variables panel's "+ Create New
             Variable": DONE places a Set Variable block preset with the name.
             Same dismissal pattern as the other popups (✕ / Escape / outside
             press — see FlowEditorView.xaml.cs). -->
        <Popup x:Name="CreateVariablePopup"
               IsOpen="{Binding IsCreateVariablePopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=CreateVariableButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource FlowPanelBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Width="290"
                    Margin="0,4,0,0"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NEW VARIABLE" Style="{StaticResource FlowSectionHeader}"/>
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ClosePopupsCommand}"
                                Style="{StaticResource FlowIconButton}"
                                Background="{StaticResource FlowRedBrush}"
                                FontSize="11"
                                ToolTip="Close"/>
                    </Grid>
                    <TextBox Text="{Binding VariableDraftName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,0"
                             materialDesign:HintAssist.Hint="Variable name"/>
                    <TextBlock Text="Adds a Set Variable block with this name to your flow."
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <Button Content="DONE"
                            Command="{Binding CreateVariableCommand}"
                            Style="{StaticResource FlowPrimaryButton}"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================== SAVE TEMPLATE POPUP ==============================
             Small stay-open prompt for the Block Templates panel's "Save
             Selected Block": DONE writes the selected node (blockType, label,
             config) as a .template.json file. -->
        <Popup x:Name="TemplatePopup"
               IsOpen="{Binding IsTemplatePopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SaveTemplateButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource FlowPanelBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Width="310"
                    Margin="0,4,0,0"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SAVE BLOCK TEMPLATE" Style="{StaticResource FlowSectionHeader}"/>
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ClosePopupsCommand}"
                                Style="{StaticResource FlowIconButton}"
                                Background="{StaticResource FlowRedBrush}"
                                FontSize="11"
                                ToolTip="Close"/>
                    </Grid>
                    <TextBlock Text="Saves the selected block's type, label and settings as a reusable template."
                               FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <TextBox Text="{Binding TemplateDraftName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,0"
                             materialDesign:HintAssist.Hint="Template name"/>
                    <TextBox Text="{Binding TemplateDraftDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="54"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,0"
                             materialDesign:HintAssist.Hint="Description (optional)"/>
                    <Button Content="DONE"
                            Command="{Binding SaveBlockTemplateCommand}"
                            Style="{StaticResource FlowPrimaryButton}"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
