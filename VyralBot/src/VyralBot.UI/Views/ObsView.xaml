<UserControl x:Class="VyralBot.UI.Views.ObsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:views="clr-namespace:VyralBot.UI.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ObsViewModel}"
             Background="{DynamicResource BackgroundPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Studio | Collections tab pill (ChatHubView PlatformTab pattern) -->
        <Style x:Key="ObsTab" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent"
                                CornerRadius="8" Padding="16,10" Margin="0,0,4,0"
                                Cursor="Hand" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button Content="&#8592; BACK TO HOME"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding DataContext.NavigateToHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <materialDesign:PackIcon Kind="Video" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="OBS" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Run the full OBS window inside Vyral, drive scenes in the Bot Studio, or import scene collections, browse and export byte-identical copies"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- Full OBS | Bot Studio | Collections tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton Style="{StaticResource ObsTab}" GroupName="ObsTab"
                             IsChecked="{Binding IsFullObsTabSelected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="FullObs">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Full OBS" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ObsTab}" GroupName="ObsTab"
                             IsChecked="{Binding IsStudioTabSelected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="BotStudio">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Television" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Bot Studio" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ObsTab}" GroupName="ObsTab"
                             IsChecked="{Binding IsCollectionsTabSelected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="Collections">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Collections" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </StackPanel>

        <Grid>
            <!-- Full OBS tab: the real obs64.exe window hosted in-page ( DataContext = ObsViewModel.Host ) -->
            <views:ObsHostView DataContext="{Binding Host}"
                               Visibility="{Binding IsFullObsTabSelected, Converter={StaticResource BoolToVis}}"/>

            <!-- Bot Studio tab: embedded studio ( DataContext = ObsViewModel.Studio ) -->
            <views:ObsStudioView DataContext="{Binding Studio}"
                                 Visibility="{Binding IsStudioTabSelected, Converter={StaticResource BoolToVis}}"/>

            <!-- Collections tab: the original import / browse / export UI -->
            <DockPanel Visibility="{Binding IsCollectionsTabSelected, Converter={StaticResource BoolToVis}}">

                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Command="{Binding ImportCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Import OBS JSON" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Refresh">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <!-- Status -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Imported collections -->
                    <materialDesign:Card Grid.Column="0"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         Margin="0,0,12,0">
                        <ListBox ItemsSource="{Binding Collections}"
                                 SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding SummaryText}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding ImportedAtText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </materialDesign:Card>

                    <!-- Document browser -->
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding LoadCollectionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"
                                    Content="Browse"/>
                            <Button Command="{Binding ExportCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,8,0"
                                    Content="Export (byte-identical)"/>
                            <Button Command="{Binding DeleteCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Delete"/>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SceneSummary}"/>

                        <TreeView ItemsSource="{Binding DocumentTree}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
