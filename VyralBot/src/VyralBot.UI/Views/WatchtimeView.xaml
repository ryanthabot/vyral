<UserControl x:Class="VyralBot.UI.Views.WatchtimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:WatchtimeViewModel}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⏱️ Watchtime Tracking" 
                      Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                      Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="🔄 Refresh"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Command="{Binding RefreshCommand}"
                       Margin="0,0,8,0"/>
                <Button Content="🔄 Reset Stream Session"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Command="{Binding ResetStreamSessionCommand}"
                       Margin="0,0,8,0"/>
                <materialDesign:Chip Content="{Binding TotalActiveViewers, StringFormat='{}{0} Active Viewers'}"
                                    Background="{DynamicResource SuccessBrush}"
                                    Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">
            <!-- Top Viewers Tab -->
            <TabItem Header="🏆 Top Viewers">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Show Top:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Default (LostFocus) source update: OnTopViewersLimitChanged
                             reloads on every source update, so PropertyChanged would
                             fire one DB query per keystroke. Refresh button still works. -->
                        <TextBox Text="{Binding TopViewersLimit}"
                                Width="60"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBlock Text="viewers" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding TopViewers}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rank" Width="60">
                                <DataGridTextColumn.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}" 
                                            Converter="{StaticResource RowIndexConverter}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100"/>
                            <DataGridTextColumn Header="Total Watchtime" Width="150">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TotalMinutes">
                                        <Binding.Converter>
                                            <converters:WatchtimeFormatConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Session Time" Width="130">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="StreamSessionMinutes">
                                        <Binding.Converter>
                                            <converters:WatchtimeFormatConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt, StringFormat='{}{0:g}'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Active Viewers Tab -->
            <TabItem Header="👁️ Active Viewers">
                <DataGrid ItemsSource="{Binding ActiveViewers}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100"/>
                        <DataGridTextColumn Header="Total Watchtime" Width="150">
                            <DataGridTextColumn.Binding>
                                <Binding Path="TotalMinutes">
                                    <Binding.Converter>
                                        <converters:WatchtimeFormatConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Session Time" Width="130">
                            <DataGridTextColumn.Binding>
                                <Binding Path="StreamSessionMinutes">
                                    <Binding.Converter>
                                        <converters:WatchtimeFormatConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt, StringFormat='{}{0:g}'}" Width="150"/>
                        <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenAt, StringFormat='{}{0:g}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- All Viewers Tab -->
            <TabItem Header="📋 All Viewers">
                <DataGrid ItemsSource="{Binding AllViewers}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="100"/>
                        <DataGridTextColumn Header="Total Watchtime" Width="150">
                            <DataGridTextColumn.Binding>
                                <Binding Path="TotalMinutes">
                                    <Binding.Converter>
                                        <converters:WatchtimeFormatConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Session Time" Width="130">
                            <DataGridTextColumn.Binding>
                                <Binding Path="StreamSessionMinutes">
                                    <Binding.Converter>
                                        <converters:WatchtimeFormatConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenAt, StringFormat='{}{0:g}'}" Width="150"/>
                        <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenAt, StringFormat='{}{0:g}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" 
                  Text="{Binding StatusMessage}" 
                  Margin="0,8,0,0"
                  FontWeight="Bold"
                  TextWrapping="Wrap"/>
    </Grid>
</UserControl>
