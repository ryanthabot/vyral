<UserControl x:Class="VyralBot.UI.Views.EventHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
        <converters:GreaterThanConverter x:Key="GreaterThanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock Text="📜 Event History" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="View, search, and replay event history" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="20,20,20,10" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel Margin="15">
                <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                   SelectedDateChanged="OnFilterDateChanged"
                                   Background="{DynamicResource BackgroundPrimaryBrush}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   BorderBrush="{DynamicResource BorderPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Date" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                   SelectedDateChanged="OnFilterDateChanged"
                                   Background="{DynamicResource BackgroundPrimaryBrush}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   BorderBrush="{DynamicResource BorderPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Platform Filter -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Platform" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Platforms}"
                                 SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                                 Background="{DynamicResource BackgroundPrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Event Type Filter -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Event Type" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding EventTypes}"
                                 SelectedItem="{Binding SelectedEventType, Mode=TwoWay}"
                                 Background="{DynamicResource BackgroundPrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Username Search -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                            Text="{Binding UsernameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="Search by username..."
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Background="{DynamicResource BackgroundPrimaryBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderPrimaryBrush}"
                            Margin="0,0,10,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                           Content="Search"
                           Command="{Binding SearchCommand}"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="{DynamicResource PrimaryBrush}"
                           Margin="0,0,10,0"
                           Padding="20,8"/>

                    <Button Grid.Column="2"
                           Content="Clear"
                           Command="{Binding ClearFiltersCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           BorderBrush="{DynamicResource BorderPrimaryBrush}"
                           Margin="0,0,10,0"
                           Padding="20,8"/>

                    <Button Grid.Column="3"
                           Content="Clear History"
                           Command="{Binding ClearHistoryCommand}"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           BorderBrush="{DynamicResource BorderPrimaryBrush}"
                           Padding="20,8"/>
                </Grid>

                <!-- Summary -->
                <TextBlock Text="{Binding TotalEvents, StringFormat='Total Events: {0}'}"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="0,10,0,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                          FontSize="12"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Margin="0,5,0,0"/>
                <TextBlock Text="{Binding TruncationNotice}"
                          FontSize="12"
                          FontWeight="SemiBold"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource WarningBrush}"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Events DataGrid -->
        <materialDesign:Card Grid.Row="2" Margin="20,0,20,10" Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <DataGrid ItemsSource="{Binding Events}"
                         SelectedItem="{Binding SelectedEvent}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         IsReadOnly="True"
                         Background="{DynamicResource CardBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         GridLinesVisibility="Horizontal"
                         HorizontalGridLinesBrush="{DynamicResource BorderPrimaryBrush}"
                         HeadersVisibility="Column"
                         SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Timestamp -->
                        <DataGridTextColumn Header="Timestamp" 
                                          Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                          Width="150"/>

                        <!-- Platform -->
                        <DataGridTextColumn Header="Platform" 
                                          Binding="{Binding Platform}" 
                                          Width="80"/>

                        <!-- Event Type -->
                        <DataGridTextColumn Header="Event Type" 
                                          Binding="{Binding EventType}" 
                                          Width="120"/>

                        <!-- Username -->
                        <DataGridTextColumn Header="Username" 
                                          Binding="{Binding Username}" 
                                          Width="150"/>

                        <!-- Auto-Replied -->
                        <DataGridTemplateColumn Header="Auto-Replied" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WasAutoReplied, Converter={StaticResource BoolToYesNoConverter}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="View Details"
                                               Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignOutlinedButton}"
                                               Margin="5,0"
                                               Padding="10,5"
                                               FontSize="11"/>
                                        
                                        <Button Content="View Reply"
                                               Command="{Binding DataContext.ReplayAutoReplyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignRaisedButton}"
                                               Background="{DynamicResource SuccessBrush}"
                                               Margin="5,0"
                                               Padding="10,5"
                                               FontSize="11"
                                               IsEnabled="{Binding WasAutoReplied}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <Border Background="{DynamicResource OverlayBackgroundBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                    Value="0"
                                    IsIndeterminate="True"
                                    Width="50"
                                    Height="50"
                                    Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Loading events..." 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  FontSize="14"
                                  Margin="0,10,0,0"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3" Margin="20,0,20,20" Background="{DynamicResource CardBackgroundBrush}">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Content="← Previous"
                       Command="{Binding PreviousPageCommand}"
                       IsEnabled="{Binding CurrentPage, Converter={StaticResource GreaterThanConverter}, ConverterParameter=1}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Padding="15,8"/>

                <TextBlock Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="14">
                    <Run Text="Page"/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="of"/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <Button Grid.Column="2"
                       Content="Next →"
                       Command="{Binding NextPageCommand}"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Padding="15,8"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
