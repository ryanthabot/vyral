<Application x:Class="VyralBot.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VyralBot.UI"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:behaviors="clr-namespace:VyralBot.UI.Behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MaterialDesign Base Themes -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                
                <!-- VyralBot Custom Theme -->
                <ResourceDictionary Source="/Resources/Themes/RedSlate.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Define theme colors for Teal primary and Cyan secondary -->
            <Color x:Key="PrimaryHueLightColor">#FF80CBC4</Color>
            <Color x:Key="PrimaryHueMidColor">#FF26A69A</Color>
            <Color x:Key="PrimaryHueDarkColor">#FF00695C</Color>
            <Color x:Key="SecondaryHueLightColor">#FF18FFFF</Color>
            <Color x:Key="SecondaryHueMidColor">#FF00BCD4</Color>
            <Color x:Key="SecondaryHueDarkColor">#FF0097A7</Color>
            
            <!-- Define missing brushes -->
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource PrimaryHueMidColor}" />
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource PrimaryHueLightColor}" />
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{StaticResource PrimaryHueDarkColor}" />
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource SecondaryHueMidColor}" />
            
            <!-- Converters -->
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InvertBooleanToVisibilityConverter x:Key="InvertBooleanToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
            <converters:RowIndexConverter x:Key="RowIndexConverter"/>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:CommandEditTitleConverter x:Key="CommandEditTitleConverter"/>
            
            <!-- Global TextBox Style with Variables Context Menu -->
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="behaviors:TextBoxVariableBehavior.EnableVariablePicker" Value="True"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem Command="ApplicationCommands.Undo" Header="Undo" InputGestureText="Ctrl+Z">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="ApplicationCommands.Redo" Header="Redo" InputGestureText="Ctrl+Y">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Redo" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="ApplicationCommands.Cut" Header="Cut" InputGestureText="Ctrl+X">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCut" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="ApplicationCommands.Copy" Header="Copy" InputGestureText="Ctrl+C">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="ApplicationCommands.Paste" Header="Paste" InputGestureText="Ctrl+V">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentPaste" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="ApplicationCommands.SelectAll" Header="Select All" InputGestureText="Ctrl+A">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="SelectAll" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Variables" behaviors:TextBoxVariableBehavior.IsVariablesMenuItem="True">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Variable" Width="16" Height="16"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <!-- Thin ScrollBar Style (Global) -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="Background" Value="#404040"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="4"
                                                                        Margin="2,0"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#606060"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#808080"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Width" Value="Auto"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
