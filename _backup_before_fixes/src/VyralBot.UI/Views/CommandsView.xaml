<UserControl x:Class="VyralBot.UI.Views.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:VyralBot.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel>
                <TextBlock Text="🤖 Command System" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Manage built-in and custom chat commands" FontSize="12" Foreground="#B0B0B0" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1,1,1,0" 
                                        CornerRadius="4,4,0,0" Margin="2,0" Padding="15,8">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Built-in Commands Tab -->
            <TabItem Header="📦 Built-in Commands">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="These are pre-configured commands. You can enable/disable them and toggle platform support." 
                               Foreground="#B0B0B0" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding BuiltInCommands}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="#252526" Foreground="White" 
                              BorderBrush="#3E3E42" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3E3E42" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DCDCAA"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Header="Enabled" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  Command="{Binding DataContext.ToggleCommandCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Kick" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EnabledOnKick, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  Command="{Binding DataContext.TogglePlatformCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  Tag="Kick"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="Twitch" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EnabledOnTwitch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  Command="{Binding DataContext.TogglePlatformCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}"
                                                  Tag="Twitch"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Usage" Binding="{Binding UsageCount}" Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Custom Commands Tab -->
            <TabItem Header="⚡ Custom Commands">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Add Command" Command="{Binding StartAddCommandCommand}" 
                                Background="#0E639C" Foreground="White" Padding="15,8" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="✏️ Edit" Command="{Binding StartEditCommandCommand}" 
                                CommandParameter="{Binding SelectedCommand}"
                                Background="#3E3E42" Foreground="White" Padding="15,8" 
                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="🗑️ Delete" Command="{Binding DeleteCommandCommand}" 
                                CommandParameter="{Binding SelectedCommand}"
                                Background="#C5000B" Foreground="White" Padding="15,8" 
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Commands DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CustomCommands}" 
                              SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="#252526" Foreground="White" 
                              BorderBrush="#3E3E42" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#3E3E42" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Response" Binding="{Binding Response}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DCDCAA"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Cooldowns (G/U)" Width="120">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0}s / {1}s">
                                        <Binding Path="GlobalCooldown"/>
                                        <Binding Path="UserCooldown"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                        <Setter Property="Padding" Value="5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToStatusConverter}}" 
                                                   Foreground="{Binding IsEnabled, Converter={StaticResource BoolToColorConverter}}"
                                                   Padding="5" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Usage" Binding="{Binding UsageCount}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B0B0B0"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Edit Panel -->
                    <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" 
                            Padding="20" Margin="0,10,0,0" Visibility="{Binding IsEditingCommand, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding SelectedCommand, Converter={StaticResource CommandEditTitleConverter}}" 
                                       FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Command Name -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Command Name (e.g., !hello)" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#333337" Foreground="White" Padding="10,8" BorderBrush="#3E3E42"/>
                                </StackPanel>

                                <!-- Permission -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Permission Level" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding PermissionLevels}" 
                                              SelectedItem="{Binding SelectedPermission}" 
                                              Background="#333337" Foreground="White" Padding="10,8" BorderBrush="#3E3E42"/>
                                </StackPanel>

                                <!-- Response -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" 
                                                   Text="Response (use {username}, {platform}, {balance}, etc.)" 
                                                   Foreground="#B0B0B0"/>
                                        <controls:VariablePicker Grid.Column="1" 
                                                                 x:Name="ResponseVariablePicker"
                                                                 TargetTextBox="{Binding ElementName=ResponseTextBox}"/>
                                    </Grid>
                                    <TextBox x:Name="ResponseTextBox"
                                             Text="{Binding CommandResponse, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#333337" Foreground="White" Padding="10,8" BorderBrush="#3E3E42"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                                </StackPanel>

                                <!-- Cooldowns -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                                    <TextBlock Text="Global Cooldown (seconds)" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding GlobalCooldown, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#333337" Foreground="White" Padding="10,8" BorderBrush="#3E3E42"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                                    <TextBlock Text="Per-User Cooldown (seconds)" Foreground="#B0B0B0" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding UserCooldown, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#333337" Foreground="White" Padding="10,8" BorderBrush="#3E3E42"/>
                                </StackPanel>

                                <!-- Platform and Status Toggles -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,15,0,0">
                                    <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" 
                                              Foreground="White" Margin="0,0,20,0"/>
                                    <CheckBox Content="Enable on Kick" IsChecked="{Binding EnabledOnKick}" 
                                              Foreground="White" Margin="0,0,20,0"/>
                                    <CheckBox Content="Enable on Twitch" IsChecked="{Binding EnabledOnTwitch}" 
                                              Foreground="White"/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button Content="💾 Save" Command="{Binding SaveCommandCommand}" 
                                        Background="#0E639C" Foreground="White" Padding="20,8" 
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="❌ Cancel" Command="{Binding CancelEditCommand}" 
                                        Background="#3E3E42" Foreground="White" Padding="20,8" 
                                        BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Help Tab -->
            <TabItem Header="❓ Help">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="800">
                        <TextBlock Text="Command Variables" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                        <TextBlock Text="You can use these variables in command responses:" Foreground="#B0B0B0" Margin="0,0,0,10"/>
                        
                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Foreground="White" Margin="0,0,0,5" Text="{}{username} - User who triggered the command"/>
                                <TextBlock Foreground="White" Margin="0,0,0,5" Text="{}{platform} - Platform (Twitch, Kick, etc.)"/>
                                <TextBlock Foreground="White" Margin="0,0,0,5" Text="{}{channel} - Channel name"/>
                                <TextBlock Foreground="White" Margin="0,0,0,5" Text="{}{balance} - User's currency balance"/>
                                <TextBlock Foreground="White" Margin="0,0,0,5" Text="{}{role} - User's role (Broadcaster, Moderator, VIP, Subscriber, Viewer)"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Permission Levels" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,20,0,15"/>
                        <TextBlock Text="Control who can use each command:" Foreground="#B0B0B0" Margin="0,0,0,10"/>
                        
                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Foreground="White" Margin="0,0,0,5">
                                    <Run Text="Everyone" Foreground="#DCDCAA" FontWeight="Bold"/> 
                                    <Run Text=" - All chat users"/>
                                </TextBlock>
                                <TextBlock Foreground="White" Margin="0,0,0,5">
                                    <Run Text="Subscriber" Foreground="#DCDCAA" FontWeight="Bold"/> 
                                    <Run Text=" - Subscribers and above"/>
                                </TextBlock>
                                <TextBlock Foreground="White" Margin="0,0,0,5">
                                    <Run Text="VIP" Foreground="#DCDCAA" FontWeight="Bold"/> 
                                    <Run Text=" - VIPs and above"/>
                                </TextBlock>
                                <TextBlock Foreground="White" Margin="0,0,0,5">
                                    <Run Text="Moderator" Foreground="#DCDCAA" FontWeight="Bold"/> 
                                    <Run Text=" - Moderators and broadcaster"/>
                                </TextBlock>
                                <TextBlock Foreground="White">
                                    <Run Text="Broadcaster" Foreground="#DCDCAA" FontWeight="Bold"/> 
                                    <Run Text=" - Broadcaster only"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Examples" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,20,0,15"/>
                        
                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" Padding="15">
                            <StackPanel>
                                <TextBlock Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap" Text="{}!hello&#x0a;Welcome {username} to the stream!" />
                                <TextBlock Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap" Text="{}!gamble&#x0a;{username} gambled and won! New balance: {balance}" />
                                <TextBlock Foreground="White" TextWrapping="Wrap" Text="{}!lurk&#x0a;Thanks for lurking, {username}! Your {balance} points are safe." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,8" 
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
