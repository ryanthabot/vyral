<Window x:Class="VyralBot.UI.Views.ProfileSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VyralBot - Select Profile"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundDarkBrush}">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderLightBrush}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource VyralRedBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VyralRedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VyralBot" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource VyralRedBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Select Your Profile" 
                       FontSize="16" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Profile List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Name}" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" 
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,5,0,0">
                                <Run Text="Last used: "/>
                                <Run Text="{Binding LastUsedAt, StringFormat='MMM dd, yyyy h:mm tt'}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🔒" 
                                       FontSize="16"
                                       ToolTip="PIN Protected"
                                       Visibility="{Binding PinCode, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- PIN Entry -->
        <StackPanel Grid.Row="2" 
                    Margin="0,15,0,0"
                    Visibility="{Binding ShowPinEntry, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Enter PIN:" 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="13"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="PinPasswordBox"
                         PasswordChanged="PinPasswordBox_OnPasswordChanged"
                         MaxLength="6"
                         FontSize="14"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorBrush}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="Continue"
                    Command="{Binding SelectProfileCommand}"
                    Width="120"
                    FontSize="14"
                    FontWeight="SemiBold"/>
            <Button Content="New Profile"
                    Command="{Binding CreateProfileCommand}"
                    Width="120"
                    FontSize="14"/>
        </StackPanel>

        <!-- Create Profile Dialog -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="{DynamicResource OverlayBackgroundBrush}"
                Visibility="{Binding ShowCreateDialog, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource VyralRedBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="30"
                    Width="400"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Create New Profile" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Profile Name (internal):" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="13"/>
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"/>
                    <TextBlock Text="Alphanumeric only, no spaces" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               FontSize="11"
                               Margin="0,2,0,10"/>

                    <TextBlock Text="Display Name (optional):" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="13"
                               Margin="0,10,0,0"/>
                    <TextBox Text="{Binding NewProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"/>

                    <TextBlock Text="PIN (optional, 4-6 digits):" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="13"
                               Margin="0,10,0,0"/>
                    <TextBox Text="{Binding NewProfilePin, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="6"
                             FontSize="14"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelCreateCommand}"
                                Width="100"/>
                        <Button Content="Create"
                                Command="{Binding ConfirmCreateCommand}"
                                Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
