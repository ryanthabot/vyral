<UserControl x:Class="VyralBot.UI.Views.GiveawayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:VyralBot.UI.Views"
             xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
             xmlns:converters="clr-namespace:VyralBot.UI.Converters"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:GiveawayViewModel}">
    
    <UserControl.Resources>
        <!-- Status to Color Converter -->
        <Style x:Key="StatusChip" TargetType="materialDesign:Chip">
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="#FFB300"/>
                    <Setter Property="Content" Value="⏳ Pending"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Background" Value="#4CAF50"/>
                    <Setter Property="Content" Value="✅ Active"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Content" Value="🎉 Completed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#F44336"/>
                    <Setter Property="Content" Value="❌ Cancelled"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Giveaway List & Create Form -->
        <Grid Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🎁 Giveaways" 
                          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                          Margin="0,0,0,8"/>
                <Button Content="🎁 Create New Giveaway"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Command="{Binding CreateGiveawayCommand}"
                       Margin="0,0,0,8">
                    <Button.IsEnabled>
                        <Binding Path="IsLoading">
                            <Binding.Converter>
                                <converters:InvertBooleanConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Button.IsEnabled>
                </Button>
                <Button Content="🔄 Refresh"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Command="{Binding RefreshCommand}">
                    <Button.IsEnabled>
                        <Binding Path="IsLoading">
                            <Binding.Converter>
                                <converters:InvertBooleanConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Button.IsEnabled>
                </Button>
            </StackPanel>

            <!-- Giveaway List -->
            <ListBox Grid.Row="1"
                    ItemsSource="{Binding Giveaways}"
                    SelectedItem="{Binding SelectedGiveaway}"
                    Margin="0,0,0,16"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <materialDesign:Chip Style="{StaticResource StatusChip}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="{Binding Name}" 
                                              FontWeight="Bold" 
                                              FontSize="16"
                                              TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                
                                <TextBlock Text="{Binding Description}" 
                                          TextWrapping="Wrap"
                                          Opacity="0.7"
                                          Margin="0,4,0,0"
                                          MaxHeight="40"
                                          TextTrimming="CharacterEllipsis"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <materialDesign:PackIcon Kind="TrophyVariant" 
                                                            Width="16" Height="16" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding WinnerCount, StringFormat='Winners: {0}'}" 
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    
                                    <materialDesign:PackIcon Kind="Ticket" 
                                                            Width="16" Height="16" 
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding EntryKeyword, StringFormat='!{0}'}" 
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" 
                                          FontSize="11"
                                          Opacity="0.6"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status Message -->
            <materialDesign:Card Grid.Row="2" 
                               Padding="12"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" 
                          TextWrapping="Wrap"
                          FontWeight="Medium"/>
            </materialDesign:Card>
        </Grid>

        <!-- Right Panel: Details & Create Form -->
        <Grid Grid.Column="1" Margin="16">
            <!-- Show details if giveaway selected, otherwise show create form -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding SelectedGiveaway, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Margin="8">
                    <!-- Giveaway Details Header -->
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="▶ Start"
                                   Command="{Binding StartGiveawayCommand}"
                                   Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGiveaway.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="🎯 Draw Winners"
                                   Command="{Binding DrawWinnersCommand}"
                                   Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#4CAF50"/>
                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGiveaway.Status}" Value="Active">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="❌ Cancel"
                                   Command="{Binding CancelGiveawayCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#F44336"/>
                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGiveaway.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedGiveaway.Status}" Value="Active">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedGiveaway.Name}" 
                                      Style="{StaticResource MaterialDesignHeadline4TextBlock}"/>
                            <materialDesign:Chip Style="{StaticResource StatusChip}" 
                                               DataContext="{Binding SelectedGiveaway}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Statistics Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <materialDesign:Card Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Entries" 
                                          Opacity="0.7" 
                                          FontSize="12"/>
                                <TextBlock Text="{Binding TotalEntries}" 
                                          FontSize="32" 
                                          FontWeight="Bold"
                                          Foreground="#2196F3"/>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Participants" 
                                          Opacity="0.7" 
                                          FontSize="12"/>
                                <TextBlock Text="{Binding UniqueParticipants}" 
                                          FontSize="32" 
                                          FontWeight="Bold"
                                          Foreground="#4CAF50"/>
                            </StackPanel>
                        </materialDesign:Card>
                        
                        <materialDesign:Card Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Winners" 
                                          Opacity="0.7" 
                                          FontSize="12"/>
                                <TextBlock Text="{Binding SelectedGiveaway.WinnerCount}" 
                                          FontSize="32" 
                                          FontWeight="Bold"
                                          Foreground="#FFB300"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Giveaway Details -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Details" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Margin="0,0,0,12"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedGiveaway.Description}" TextWrapping="Wrap" Margin="8,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Entry Keyword:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGiveaway.EntryKeyword, StringFormat='!{0}'}" Margin="8,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Entries:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGiveaway.MaxEntries}" Margin="8,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub Bonus:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="8,4">
                                    <Run Text="{Binding SelectedGiveaway.SubscriberBonusEnabled, StringFormat='{}{0}', Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="Gray"/>
                                    <Run Text="{Binding SelectedGiveaway.SubscriberBonusEntries, StringFormat='+{0} entries', Mode=OneWay}" Foreground="Gray"/>
                                    <Run Text=")" Foreground="Gray"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Min Watchtime:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGiveaway.MinWatchtimeMinutes, StringFormat='{}{0} minutes'}" Margin="8,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Followers Only:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedGiveaway.FollowersOnly}" Margin="8,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Subscribers Only:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedGiveaway.SubscribersOnly}" Margin="8,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Allowed Platforms:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedGiveaway.AllowedPlatforms}" Margin="8,4"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Scheduled End:" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedGiveaway.ScheduledEndTime, StringFormat='{}{0:g}', TargetNullValue='Not set'}" Margin="8,4"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Entries List -->
                    <materialDesign:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="Entries" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Margin="0,0,0,12"/>
                            
                            <DataGrid ItemsSource="{Binding Entries}"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     IsReadOnly="True"
                                     SelectionMode="Single"
                                     MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="Auto"/>
                                    <DataGridTextColumn Header="Entries" Binding="{Binding EntryCount}" Width="Auto"/>
                                    <DataGridCheckBoxColumn Header="Subscriber" Binding="{Binding IsSubscriber}" Width="Auto"/>
                                    <DataGridCheckBoxColumn Header="Winner" Binding="{Binding IsWinner}" Width="Auto"/>
                                    <DataGridTextColumn Header="Entered At" Binding="{Binding EnteredAt, StringFormat='{}{0:g}'}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- Create Giveaway Form (shown when no selection) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGiveaway}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <materialDesign:Card Padding="24" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Create New Giveaway" 
                                  Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                  Margin="0,0,0,24"/>

                        <!-- Name -->
                        <TextBox materialDesign:HintAssist.Hint="Giveaway Name *"
                                Text="{Binding NewGiveawayName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Description -->
                        <TextBox materialDesign:HintAssist.Hint="Description"
                                Text="{Binding NewGiveawayDescription, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinLines="3"
                                MaxLines="5"
                                Margin="0,0,0,16"/>

                        <!-- Entry Keyword & Winner Count -->
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <TextBox materialDesign:HintAssist.Hint="Entry Keyword *"
                                    Text="{Binding NewGiveawayKeyword, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,8,0"/>
                            
                            <TextBox materialDesign:HintAssist.Hint="Winner Count *"
                                    Text="{Binding NewGiveawayWinnerCount, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="8,0,0,0"/>
                        </UniformGrid>

                        <!-- Max Entries -->
                        <TextBox materialDesign:HintAssist.Hint="Max Entries Per User"
                                Text="{Binding NewGiveawayMaxEntries, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Subscriber Bonus -->
                        <CheckBox Content="Enable Subscriber Bonus Entries"
                                 IsChecked="{Binding NewGiveawaySubscriberBonusEnabled}"
                                 Margin="0,0,0,8"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="Subscriber Bonus Entries"
                                Text="{Binding NewGiveawaySubscriberBonusEntries, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                IsEnabled="{Binding NewGiveawaySubscriberBonusEnabled}"
                                Margin="0,0,0,16"/>

                        <!-- Requirements -->
                        <TextBlock Text="Requirements" 
                                  FontWeight="Bold" 
                                  FontSize="14"
                                  Margin="0,8,0,8"/>
                        
                        <TextBox materialDesign:HintAssist.Hint="Min Watchtime (minutes)"
                                Text="{Binding NewGiveawayMinWatchtime, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,16"/>

                        <CheckBox Content="Followers Only"
                                 IsChecked="{Binding NewGiveawayFollowersOnly}"
                                 Margin="0,0,0,8"/>
                        
                        <CheckBox Content="Subscribers Only"
                                 IsChecked="{Binding NewGiveawaySubscribersOnly}"
                                 Margin="0,0,0,16"/>

                        <!-- Allowed Platforms -->
                        <TextBox materialDesign:HintAssist.Hint="Allowed Platforms (comma-separated)"
                                Text="{Binding NewGiveawayAllowedPlatforms, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Margin="0,0,0,16"/>

                        <!-- Scheduled End (Optional) -->
                        <DatePicker materialDesign:HintAssist.Hint="Scheduled End (Optional)"
                                   SelectedDate="{Binding NewGiveawayScheduledEnd}"
                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                   Margin="0,0,0,24"/>

                        <!-- Action Buttons -->
                        <UniformGrid Columns="2">
                            <Button Content="✅ Create Giveaway"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Command="{Binding CreateGiveawayCommand}"
                                   Margin="0,0,8,0"/>
                            
                            <Button Content="Clear"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Command="{Binding ClearFormCommand}"
                                   Margin="8,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2" 
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                        Value="0"
                        IsIndeterminate="True"
                        Width="60"
                        Height="60"/>
        </Grid>
    </Grid>
</UserControl>
