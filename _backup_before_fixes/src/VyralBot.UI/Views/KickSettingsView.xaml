<UserControl x:Class="VyralBot.UI.Views.KickSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundDarkBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Back Button (Sticky) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Kick Settings" 
                         FontSize="32"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Margin="0,0,0,8"/>
                <TextBlock Text="Manage your Kick integration settings" 
                         FontSize="14"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            
            <!-- Back Button -->
            <Button Grid.Column="1"
                    Command="{Binding DataContext.BackToPlatformGridCommand, ElementName=SettingsViewRoot}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    VerticalAlignment="Top"
                    Margin="16,0,0,0"
                    Padding="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Back" 
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Connection Status Card -->
                <materialDesign:Card Padding="24"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status Indicator -->
                        <Border Grid.Column="0"
                                Width="12"
                                Height="12"
                                CornerRadius="6"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource KickBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        
                        <!-- Status Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" 
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Not connected to Kick"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="Connected as {0}">
                                                            <Binding Path="Username"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Disconnect Button -->
                        <Button Grid.Column="2"
                                Content="DISCONNECT"
                                Command="{Binding DisconnectCommand}"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                Foreground="{DynamicResource ErrorBrush}"
                                Height="36"
                                Padding="16,0"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </materialDesign:Card>
                
                <!-- Account Settings -->
                <materialDesign:Card Padding="24" 
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Account Settings" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,24"/>
                        
                        <!-- Username -->
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Username"
                               FontSize="14"
                               Margin="0,0,0,16"
                               IsReadOnly="True"/>
                        
                        <!-- Channel Name -->
                        <TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Channel"
                               FontSize="14"
                               Margin="0,0,0,24"
                               IsReadOnly="True"/>
                        
                        <!-- Save Button -->
                        <Button Content="SAVE CHANGES"
                              Command="{Binding SaveSettingsCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Background="{DynamicResource KickBrush}"
                              Foreground="{DynamicResource TwitchBackgroundBrush}"
                              Height="40"
                              Padding="24,0"
                              HorizontalAlignment="Left"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Chat Settings -->
                <materialDesign:Card Padding="24" 
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Chat Settings" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"/>
                        
                        <TextBlock Text="Chat integration is enabled. Messages will appear in the unified chat view." 
                                 FontSize="14"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Webhook Settings -->
                <materialDesign:Card Padding="24" 
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Webhook Settings" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"/>
                        
                        <!-- Enable Webhooks Toggle -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enable Webhooks" 
                                         FontSize="14" 
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Receive real-time events from Kick (chat messages, follows, subscriptions, etc.)" 
                                         FontSize="12" 
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <ToggleButton Grid.Column="1"
                                        IsChecked="{Binding IsWebhookEnabled}"
                                        Command="{Binding ToggleWebhooksCommand}"
                                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0"/>
                        </Grid>
                        
                        <!-- Webhook Status -->
                        <Border Background="{StaticResource BackgroundSecondaryBrush}"
                                BorderBrush="{DynamicResource KickBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:PackIcon Grid.Column="0"
                                                       Kind="Information"
                                                       Width="16"
                                                       Height="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                
                                <TextBlock Grid.Column="1"
                                         Text="{Binding WebhookStatus}"
                                         FontSize="12"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <TextBlock TextWrapping="Wrap" 
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="Note: The webhook server must be running to receive events. "/>
                            <Hyperlink NavigateUri="settings://api" 
                                     RequestNavigate="WebhookSettings_RequestNavigate"
                                     Foreground="{DynamicResource KickBrush}">
                                <Run Text="Configure webhook server →"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- Chat Settings Card (WebView2) -->
                <materialDesign:Card Padding="24"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Chat Settings (WebView2)" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"/>
                        
                        <!-- Enable Chat Toggle -->
                        <CheckBox Content="Enable Kick Chat (Receive Messages)"
                                IsChecked="{Binding IsChatEnabled}"
                                Margin="0,0,0,8"
                                Style="{StaticResource MaterialDesignCheckBox}"
                                Foreground="{StaticResource TextPrimaryBrush}">
                            <CheckBox.ToolTip>
                                <TextBlock Text="When enabled, Kick chat messages will be received via WebView2.&#x0a;When disabled, you can still send messages via webhooks."
                                         TextWrapping="Wrap"
                                         MaxWidth="300"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        
                        <!-- Auto-start Toggle -->
                        <CheckBox Content="Auto-start chat on app launch"
                                IsChecked="{Binding AutoStartChat}"
                                IsEnabled="{Binding IsChatEnabled}"
                                Margin="0,0,0,16"
                                Style="{StaticResource MaterialDesignCheckBox}"
                                Foreground="{StaticResource TextPrimaryBrush}">
                            <CheckBox.ToolTip>
                                <TextBlock Text="Automatically start chat connection when the app launches&#x0a;(only if Kick chat is enabled)"
                                         TextWrapping="Wrap"
                                         MaxWidth="300"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        
                        <!-- Start/Stop Button -->
                        <Button Command="{Binding ToggleChatCommand}"
                                Width="150"
                                Height="36"
                                Margin="0,0,0,16"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Start Chat"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChatRunning}" Value="True">
                                                    <Setter Property="Text" Value="Stop Chat"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        
                        <!-- Status Indicator -->
                        <Border Background="{DynamicResource CardBackgroundSecondaryBrush}"
                                Padding="12"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Ellipse Grid.Column="0" 
                                       Width="10" 
                                       Height="10" 
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChatRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource KickBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                
                                <TextBlock Grid.Column="1"
                                         Text="{Binding ChatStatus}"
                                         FontSize="12"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Info Text -->
                        <TextBlock Text="WebView2 chat runs independently from setup wizards and ngrok webhooks. This provides real-time chat messages while webhooks handle followers, subs, and other events."
                                 FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Margin="0,12,0,0"
                                 TextWrapping="Wrap"/>

                        <!-- Auto Replies Toggle -->
                        <Separator Margin="0,12,0,12"/>
                        <CheckBox Content="Enable auto replies (thank followers / respond to unfollows)"
                                  IsChecked="{Binding AutoRepliesEnabled}"
                                  Margin="0,0,0,8"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <CheckBox.ToolTip>
                                <TextBlock Text="When enabled, VyralBot will automatically send a thank-you message in Kick chat when someone follows, and a sad message when someone unfollows. Requires the app to be connected to Kick."
                                           TextWrapping="Wrap"
                                           MaxWidth="320"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                    </StackPanel>
                </materialDesign:Card>
                
                <!-- About Kick Integration -->
                <materialDesign:Card Padding="24" 
                                    Background="{StaticResource CardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="About Kick Integration" 
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Margin="0,0,0,16"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                 FontSize="14"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Margin="0,0,0,8">
                            <Run Text="VyralBot connects to Kick using:"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="• OAuth 2.1 for secure authentication"/>
                            <LineBreak/>
                            <Run Text="• Pusher WebSocket for real-time chat"/>
                            <LineBreak/>
                            <Run Text="• Kick REST API for sending messages"/>
                            <LineBreak/><LineBreak/>
                            <Run Text="Your credentials are encrypted and stored locally."/>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
