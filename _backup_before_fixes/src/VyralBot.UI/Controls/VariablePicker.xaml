<UserControl x:Class="VyralBot.UI.Controls.VariablePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="VariablePickerContentTemplate">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Insert Variable" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Style="{StaticResource MaterialDesignIconButton}" HorizontalAlignment="Right" Width="28" Height="28" Click="CloseButton_Click">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Search Box -->
                        <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="Magnify" Grid.Column="0" Width="20" Height="20" Margin="4,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <TextBox Grid.Column="1" x:Name="SearchBox" materialDesign:HintAssist.Hint="Search variables..." BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Category Filter -->
                        <ItemsControl Grid.Row="2" x:Name="CategoryFilter" Margin="0,0,0,12" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding}" Margin="0,0,4,4" Click="CategoryChip_Click" Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Variables List -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="VariablesList" ItemsSource="{Binding FilteredVariables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,0,0,8" Padding="12" Cursor="Hand" MouseLeftButtonUp="VariableCard_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Variable Name -->
                                                <TextBlock Grid.Row="0" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                    <Run Text="{}{"/>
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text="}"/>
                                                </TextBlock>

                                                <!-- Display Name -->
                                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                                <!-- Category Badge -->
                                                <Border Grid.Row="2" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="10" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                                                </Border>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Management Footer (Hidden in Compact Mode) -->
                        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Visibility="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Manage Variables" Margin="0,0,8,0" ToolTip="Open Variables settings to edit and create new variables"/>
                                <TextBlock Text="Tip: Right-click any text box to insert variables" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <!-- Trigger Button -->
        <Button x:Name="TriggerButton" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Insert Variable" Width="32" Height="32" Visibility="{Binding IsPopupMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvertBooleanToVisibilityConverter}}" Click="TriggerButton_Click">
            <materialDesign:PackIcon Kind="Variable" Width="20" Height="20"/>
        </Button>

        <!-- Shared Content for Popup and Compact Modes -->
        <ContentControl x:Name="VariableContent" Visibility="{Binding IsPopupMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" ContentTemplate="{StaticResource VariablePickerContentTemplate}"/>

        <Popup x:Name="VariablePopup" PlacementTarget="{Binding ElementName=TriggerButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" Width="500" Height="400">
            <ContentControl ContentTemplate="{StaticResource VariablePickerContentTemplate}"/>
        </Popup>

    </Grid>
</UserControl>
