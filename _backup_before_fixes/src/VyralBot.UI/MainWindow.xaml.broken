<Window x:Class="VyralBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:VyralBot.UI.Views"
        xmlns:vm="clr-namespace:VyralBot.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="720" 
        Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Border Background="{StaticResource BackgroundDarkBrush}" 
            BorderThickness="0"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar -->
                <RowDefinition Height="32"/>
                <!-- Menu Bar -->
                <RowDefinition Height="40"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="#1A1F2E"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title with Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Image Source="/Resources/Images/VyralFaceSticker.png" 
                               Width="16" 
                               Height="16" 
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="VyralBot - Primary Test (v1.0)" 
                                 FontSize="11" 
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="―" 
                                Click="MinimizeButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46" 
                                Height="32"
                                Padding="0"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="□" 
                                Click="MaximizeButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46" 
                                Height="32"
                                Padding="0"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="✕" 
                                Click="CloseButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="46" 
                                Height="32"
                                Padding="0"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C42B1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Menu Bar -->
            <Border Grid.Row="1" 
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <!-- Menu Button -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Menu">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Menu" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Menu" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Save -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Save">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Import -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Import">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Import" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Export -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Export">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Chat -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Chat">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MessageText" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Chat" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Event Feed -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Event Feed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewList" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Feed" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Global Variables -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                Padding="12,0"
                                ToolTip="Global Variables">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Variable" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Global Variables" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Connection Status -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <TextBlock Text="Connected (0/8)" 
                                 FontSize="12" 
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                        <materialDesign:PackIcon Kind="Circle" 
                                               Width="10" 
                                               Height="10" 
                                               Foreground="#22C55E"
                                               Margin="8,0,4,0"
                                               VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="ChevronDown" 
                                               Width="16" 
                                               Height="16" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="200"/>
                <!-- Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" 
                    Background="#1E293B"
                    BorderBrush="{StaticResource BorderLightBrush}" 
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top Navigation -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <!-- Menu Hamburger -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,0">
                            <materialDesign:PackIcon Kind="Menu" Width="18" Height="18" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Home -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2"
                                Command="{Binding NavigateToHomeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Viewers -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Viewers" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Actions & Queues (with expand arrow) -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Cog" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Actions &amp; Queues" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Commands -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Commands" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Platforms (expandable) -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2"
                                Command="{Binding NavigateToPlatformsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Video" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Platforms" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Platform Sub-items (indented) -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Twitch" Width="14" Height="14" VerticalAlignment="Center" Foreground="#9146FF"/>
                                <TextBlock Text="Twitch" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Youtube" Width="14" Height="14" VerticalAlignment="Center" Foreground="#FF0000"/>
                                <TextBlock Text="YouTube" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Television" Width="14" Height="14" VerticalAlignment="Center" Foreground="#53FC18"/>
                                <TextBlock Text="Trovo" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Kick" Width="14" Height="14" VerticalAlignment="Center" Foreground="#53FC18"/>
                                <TextBlock Text="Kick" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Stream Apps (expandable) -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Monitor" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stream Apps" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Stream Apps Sub-items -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Application" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="OBS Studio" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Application" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Streamlabs Desktop" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Application" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Midi Studio" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="32"
                                HorizontalContentAlignment="Left"
                                Padding="36,0,12,0"
                                Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Application" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="PolyPup" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Integrations -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Puzzle" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Integrations" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Services -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CloudOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Services" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- MIDI -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Piano" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="MIDI" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Voice Control -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Microphone" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Voice Control" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Servers/Clients -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ServerNetwork" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Servers/Clients" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Separator Margin="8" Background="{StaticResource BorderLightBrush}"/>
                        
                        <!-- Settings -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- About -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="36"
                                HorizontalContentAlignment="Left"
                                Padding="12,0"
                                Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="About" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- User Profile -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Height="40"
                                HorizontalContentAlignment="Left"
                                Padding="8,0"
                                Margin="4,8,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" 
                                        Width="24" 
                                        Height="24" 
                                        Background="{StaticResource VyralRedBrush}"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="R" 
                                             FontSize="12" 
                                             FontWeight="Bold"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" 
                                         Text="rane1290" 
                                         Margin="8,0,0,0" 
                                         FontSize="12" 
                                         FontWeight="Medium"
                                         VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Grid.Column="2" 
                                                       Kind="DotsVertical" 
                                                       Width="16" 
                                                       Height="16" 
                                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Column="1" Padding="24">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <!-- Home View -->
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Banner Header -->
                                <Border Background="#14B8A6" 
                                       Height="140"
                                       CornerRadius="0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" 
                                                   HorizontalAlignment="Left"
                                                   Margin="40,0,0,0">
                                            <StackPanel Orientation="Horizontal" 
                                                       Margin="0,0,0,8">
                                                <Image Source="/Resources/Images/VyralFaceSticker.png" 
                                                       Width="48" 
                                                       Height="48" 
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0"/>
                                                <TextBlock Text="VyralBot" 
                                                         FontSize="36" 
                                                         FontWeight="Bold" 
                                                         Foreground="White"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="1.0.0" 
                                                     FontSize="13" 
                                                     Foreground="White"
                                                     Opacity="0.8"
                                                     Margin="0,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Created by rane1290" 
                                                 FontSize="11" 
                                                 Foreground="White"
                                                 Opacity="0.7"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,24,16"/>
                                    </Grid>
                                </Border>

                                <!-- Main Content Cards -->
                                <Grid Margin="32,32,32,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Actions Card -->
                                    <materialDesign:Card Grid.Row="0" Grid.Column="0"
                                                        Padding="40,32"
                                                        Background="{StaticResource CardBackgroundBrush}"
                                                        Cursor="Hand">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Cog" 
                                                                   Width="48" 
                                                                   Height="48" 
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,0,16"/>
                                            <TextBlock Text="Actions" 
                                                     FontSize="18" 
                                                     FontWeight="SemiBold" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="Configure actions, queues and view action history" 
                                                     FontSize="12" 
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Commands Card -->
                                    <materialDesign:Card Grid.Row="0" Grid.Column="2"
                                                        Padding="40,32"
                                                        Background="{StaticResource CardBackgroundBrush}"
                                                        Cursor="Hand">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CodeBraces" 
                                                                   Width="48" 
                                                                   Height="48" 
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,0,16"/>
                                            <TextBlock Text="Commands" 
                                                     FontSize="18" 
                                                     FontWeight="SemiBold" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="Manage your chat commands" 
                                                     FontSize="12" 
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Platforms Card -->
                                    <materialDesign:Card Grid.Row="2" Grid.Column="0"
                                                        Padding="40,32"
                                                        Background="{StaticResource CardBackgroundBrush}"
                                                        Cursor="Hand">
                                        <materialDesign:Card.InputBindings>
                                            <MouseBinding Command="{Binding DataContext.NavigateToPlatformsCommand, RelativeSource={RelativeSource AncestorType=Window}}" MouseAction="LeftClick"/>
                                        </materialDesign:Card.InputBindings>
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Twitch" 
                                                                   Width="48" 
                                                                   Height="48" 
                                                                   Foreground="#9146FF"
                                                                   Margin="0,0,0,16"/>
                                            <TextBlock Text="Platforms" 
                                                     FontSize="18" 
                                                     FontWeight="SemiBold" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="View and modify your streaming platform settings" 
                                                     FontSize="12" 
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <!-- Stream Apps Card -->
                                    <materialDesign:Card Grid.Row="2" Grid.Column="2"
                                                        Padding="40,32"
                                                        Background="{StaticResource CardBackgroundBrush}"
                                                        Cursor="Hand">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Monitor" 
                                                                   Width="48" 
                                                                   Height="48" 
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,0,16"/>
                                            <TextBlock Text="Stream Apps" 
                                                     FontSize="18" 
                                                     FontWeight="SemiBold" 
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     Margin="0,0,0,4"/>
                                            <TextBlock Text="Configure your streaming application settings" 
                                                     FontSize="12" 
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </Grid>

                                <!-- Support Section -->
                                <StackPanel Margin="32,0,32,32">
                                    <TextBlock Text="Support" 
                                             FontSize="16" 
                                             FontWeight="SemiBold" 
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Margin="0,0,0,12"/>

                                    <!-- Documentation -->
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                           BorderBrush="{StaticResource BorderLightBrush}"
                                           BorderThickness="0,0,0,1"
                                           Padding="16,12"
                                           Cursor="Hand"
                                           Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                   Kind="BookOpenPageVariant" 
                                                                   Width="20" 
                                                                   Height="20" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                            
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock Text="Documentation" 
                                                         FontSize="13" 
                                                         FontWeight="Medium"
                                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Explore the official documentation for VyralBot" 
                                                         FontSize="11" 
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <materialDesign:PackIcon Grid.Column="2"
                                                                   Kind="ChevronRight" 
                                                                   Width="16" 
                                                                   Height="16" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Discord -->
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                           BorderBrush="{StaticResource BorderLightBrush}"
                                           BorderThickness="0,0,0,1"
                                           Padding="16,12"
                                           Cursor="Hand"
                                           Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                   Kind="Discord" 
                                                                   Width="20" 
                                                                   Height="20" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#5865F2"/>
                                            
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock Text="Discord" 
                                                         FontSize="13" 
                                                         FontWeight="Medium"
                                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Join the VyralBot community!" 
                                                         FontSize="11" 
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <materialDesign:PackIcon Grid.Column="2"
                                                                   Kind="ChevronRight" 
                                                                   Width="16" 
                                                                   Height="16" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Ideas & Suggestions -->
                                    <Border Background="{StaticResource CardBackgroundBrush}"
                                           Padding="16,12"
                                           Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                   Kind="Lightbulb" 
                                                                   Width="20" 
                                                                   Height="20" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#FFA500"/>
                                            
                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                <TextBlock Text="Ideas &amp; Suggestions" 
                                                         FontSize="13" 
                                                         FontWeight="Medium"
                                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Share and discuss ideas for new features or improvements to VyralBot" 
                                                         FontSize="11" 
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <materialDesign:PackIcon Grid.Column="2"
                                                                   Kind="ChevronRight" 
                                                                   Width="16" 
                                                                   Height="16" 
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Platforms View -->
                        <DataTemplate DataType="{x:Type vm:PlatformsViewModel}">
                            <local:PlatformsView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
